// Test: app-owner-added
// Rule: New owner added to an application or service principal (detections/app-owner-added.yaml)
// Adding an owner to an app registration fires; updating the app doesn't.
// Generated by tools/build_tests.py from tests/cases/app-owner-added.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Add owner to application", "ApplicationManagement", "success", "", dynamic({"user": {"userPrincipalName": "dev1@contoso.com"}}), dynamic([{"userPrincipalName": "mallory@contoso.com"}, {"displayName": "PayrollExport", "id": "app-obj-1"}]), dynamic(null),
    600, "Update application", "ApplicationManagement", "success", "", dynamic({"user": {"userPrincipalName": "dev2@contoso.com"}}), dynamic([{"displayName": "PayrollExport", "id": "app-obj-1"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName in ("Add owner to application", "Add owner to service principal") and Result =~ "success"
| extend NewOwner = coalesce(tostring(TargetResources[0].userPrincipalName), tostring(TargetResources[0].displayName)),
    App = tostring(TargetResources[1].displayName), AppObjectId = tostring(TargetResources[1].id),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, OperationName, App, AppObjectId, NewOwner, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(NewOwner) == "mallory@contoso.com" and tostring(App) == "PayrollExport"), Exclude1 = countif(tostring(Actor) == "dev2@contoso.com")
| extend Test = "app-owner-added", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
