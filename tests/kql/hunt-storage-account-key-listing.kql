// Test: hunt-storage-account-key-listing
// Rule: Storage account keys listed by a new caller (hunting/hunt-storage-account-key-listing.yaml)
// A new caller listing keys on three accounts shows up; a pipeline that lists keys every week doesn't.
// Generated by tools/build_tests.py from tests/cases/hunt-storage-account-key-listing.yaml. Do not edit by hand.
let AzureActivity = datatable(AgoSeconds:long, OperationNameValue:string, ActivityStatusValue:string, Caller:string, CallerIpAddress:string, SubscriptionId:string, ResourceGroup:string, _ResourceId:string, Properties_d:dynamic) [
    10800, "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION", "Success", "mallory@contoso.com", "198.51.100.165", "", "", "/subscriptions/sub-1/resourceGroups/data/providers/Microsoft.Storage/storageAccounts/sa1", dynamic(null),
    10770, "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION", "Success", "mallory@contoso.com", "198.51.100.165", "", "", "/subscriptions/sub-1/resourceGroups/data/providers/Microsoft.Storage/storageAccounts/sa2", dynamic(null),
    10740, "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION", "Success", "mallory@contoso.com", "198.51.100.165", "", "", "/subscriptions/sub-1/resourceGroups/data/providers/Microsoft.Storage/storageAccounts/sa3", dynamic(null),
    432000, "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION", "Success", "9f8e7d6c-pipeline-sp", "203.0.113.165", "", "", "/subscriptions/sub-1/resourceGroups/app/providers/Microsoft.Storage/storageAccounts/appsa", dynamic(null),
    10800, "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION", "Success", "9f8e7d6c-pipeline-sp", "203.0.113.165", "", "", "/subscriptions/sub-1/resourceGroups/app/providers/Microsoft.Storage/storageAccounts/appsa", dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Known = AzureActivity
    | where TimeGenerated between (ago(14d) .. ago(1d))
    | where OperationNameValue =~ "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION"
    | distinct Caller;
AzureActivity
| where TimeGenerated > ago(1d)
| where OperationNameValue =~ "MICROSOFT.STORAGE/STORAGEACCOUNTS/LISTKEYS/ACTION" and ActivityStatusValue in~ ("Success", "Succeeded")
| where Caller !in (Known)
| summarize StorageAccountCount = dcount(_ResourceId), StorageAccounts = make_set(_ResourceId, 20), IPs = make_set(CallerIpAddress, 10),
    FirstSeen = min(TimeGenerated) by Caller
| order by StorageAccountCount desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Caller) == "mallory@contoso.com" and tolong(StorageAccountCount) == 3), Exclude1 = countif(tostring(Caller) == "9f8e7d6c-pipeline-sp")
| extend Test = "hunt-storage-account-key-listing", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
