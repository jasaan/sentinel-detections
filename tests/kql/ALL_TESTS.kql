let AgentCounts = SigninLogs
    | where TimeGenerated > ago(30d) and ResultType == "0"
    | summarize TimesSeen = count(), UsersWithAgent = dcount(UserPrincipalName) by UserAgent;
SigninLogs
| where TimeGenerated > ago(1d) and ResultType == "0"
| join kind=inner (AgentCounts | where TimesSeen <= maxSeen) on UserAgent
| project TimeGenerated, UserPrincipalName, UserAgent, TimesSeen, UsersWithAgent, IPAddress, Location, AppDisplayName
| order by TimesSeen asc, TimeGenerated desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tostring(UserAgent) == "python-requests/2.31.0"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com")
| extend Test = "hunt-rare-user-agent", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: hunt-service-principal-new-credential
// Rule: New credentials added to an app or service principal (hunting/hunt-service-principal-new-credential.yaml)
// Credential additions to apps and service principals are listed; other app updates and failures aren't.
// Generated by tools/build_tests.py from tests/cases/hunt-service-principal-new-credential.yaml. Do not edit by hand.
let Test_hunt_service_principal_new_credential = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    172800, "Add service principal credentials", "", "success", dynamic({"user": {"userPrincipalName": "mallory@contoso.com", "ipAddress": "198.51.100.99"}}), dynamic([{"displayName": "Payroll Connector", "id": "sp-1"}]), dynamic(null),
    86400, "Update application – Certificates and secrets management ", "", "success", dynamic({"user": {"userPrincipalName": "alice@contoso.com", "ipAddress": "10.0.0.70"}}), dynamic([{"displayName": "HR Sync", "id": "app-2"}]), dynamic(null),
    86400, "Update application", "", "success", dynamic({"user": {"userPrincipalName": "alice@contoso.com", "ipAddress": "10.0.0.70"}}), dynamic([{"displayName": "HR Sync", "id": "app-2"}]), dynamic(null),
    86400, "Add service principal credentials", "", "failure", dynamic({"user": {"userPrincipalName": "bob@contoso.com", "ipAddress": "10.0.0.71"}}), dynamic([{"displayName": "Finance Bot", "id": "sp-3"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(7d)
| where OperationName == "Add service principal credentials" or OperationName has "Certificates and secrets management"
| where Result =~ "success"
| extend AppName = tostring(TargetResources[0].displayName), AppId = tostring(TargetResources[0].id),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, OperationName, AppName, AppId, Actor, ActorIP
| order by TimeGenerated desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(AppName) == "Payroll Connector" and tostring(Actor) == "mallory@contoso.com"), Include2 = countif(tostring(AppName) == "HR Sync" and tostring(Actor) == "alice@contoso.com"), Exclude1 = countif(tostring(AppName) == "Finance Bot")
| extend Test = "hunt-service-principal-new-credential", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: inbox-rule-external-forward
// Rule: Inbox rule forwards mail to an external address (detections/inbox-rule-external-forward.yaml)
// Rules forwarding or redirecting to outside domains fire (including SMTP-prefixed, multi-recipient values); internal forwarding doesn't.
// Generated by tools/build_tests.py from tests/cases/inbox-rule-external-forward.yaml. Do not edit by hand.
let Test_inbox_rule_external_forward = () {
let OfficeActivity = datatable(AgoSeconds:long, Operation:string, UserId:string, ClientIP:string, OfficeWorkload:string, Parameters:string, SourceFileName:string, Site_Url:string, ResultStatus:string) [
    900, "New-InboxRule", "alice@contoso.com", "198.51.100.23", "Exchange", "[{\"Name\":\"Name\",\"Value\":\".\"},{\"Name\":\"ForwardTo\",\"Value\":\"invoices@protonmail.example\"},{\"Name\":\"MarkAsRead\",\"Value\":\"True\"}]", "", "", "",
    900, "Set-InboxRule", "carol@contoso.com", "198.51.100.24", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"Rule1\"},{\"Name\":\"RedirectTo\",\"Value\":\"SMTP:carol.personal@gmail.example;dave@contoso.com\"}]", "", "", "",
    900, "New-InboxRule", "bob@contoso.com", "10.0.0.8", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"Team\"},{\"Name\":\"ForwardTo\",\"Value\":\"dave@contoso.com\"}]", "", "", "",
    900, "New-InboxRule", "erin@contoso.com", "10.0.0.9", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"Newsletters\"},{\"Name\":\"MoveToFolder\",\"Value\":\"News\"}]", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let OrgDomains = dynamic(["contoso.com"]);
OfficeActivity
| where TimeGenerated > ago(1h)
| where OfficeWorkload == "Exchange" and Operation in~ ("New-InboxRule", "Set-InboxRule")
| mv-expand Param = todynamic(Parameters)
| where tostring(Param.Name) in~ ("ForwardTo", "ForwardAsAttachmentTo", "RedirectTo")
| mv-expand Destination = split(tostring(Param.Value), ";") to typeof(string)
| extend Destination = trim(@"\s", replace_regex(Destination, @"(?i)^smtp:", ""))
| extend DestinationDomain = tolower(tostring(split(Destination, "@")[1]))
| where isnotempty(DestinationDomain) and not(DestinationDomain in (OrgDomains))
| summarize Destinations = make_set(Destination), Operations = make_set(Operation) by TimeGenerated, UserId, ClientIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserId) == "alice@contoso.com"), Include2 = countif(tostring(UserId) == "carol@contoso.com"), Exclude1 = countif(tostring(UserId) == "bob@contoso.com"), Exclude2 = countif(tostring(UserId) == "erin@contoso.com")
| extend Test = "inbox-rule-external-forward", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
