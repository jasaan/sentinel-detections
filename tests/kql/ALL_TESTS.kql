let Test_global_admin_outside_pim = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    1200, "Add member to role", "", "success", "", dynamic({"user": {"userPrincipalName": "mallory@contoso.com", "ipAddress": "198.51.100.99"}}), dynamic([{"userPrincipalName": "mallory.backup@contoso.com", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "", "newValue": "\"Global Administrator\""}]}]), dynamic(null),
    1200, "Add member to role completed (PIM activation)", "", "success", "", dynamic({"app": {"displayName": "MS-PIM"}}), dynamic([{"userPrincipalName": "alice@contoso.com", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "", "newValue": "\"Global Administrator\""}]}]), dynamic(null),
    1200, "Add member to role", "", "success", "", dynamic({"app": {"displayName": "MS-PIM"}}), dynamic([{"userPrincipalName": "bob@contoso.com", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "", "newValue": "\"Global Administrator\""}]}]), dynamic(null),
    1200, "Add member to role", "", "success", "", dynamic({"user": {"userPrincipalName": "helpdesk@contoso.com", "ipAddress": "10.0.0.30"}}), dynamic([{"userPrincipalName": "carol@contoso.com", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "", "newValue": "\"Reports Reader\""}]}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let PrivilegedRoles = dynamic(["Global Administrator", "Privileged Role Administrator", "Privileged Authentication Administrator",
    "Security Administrator", "Exchange Administrator", "Application Administrator"]);
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName == "Add member to role" and Result =~ "success"
| mv-apply Prop = TargetResources[0].modifiedProperties on (
    where tostring(Prop.displayName) == "Role.DisplayName"
    | extend RoleName = trim(@'"', tostring(Prop.newValue))
  )
| where RoleName in (PrivilegedRoles)
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress), TargetUser = tostring(TargetResources[0].userPrincipalName)
| where Actor !startswith "MS-PIM"
| project TimeGenerated, RoleName, TargetUser, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(TargetUser) == "mallory.backup@contoso.com" and tostring(RoleName) == "Global Administrator" and tostring(Actor) == "mallory@contoso.com"), Exclude1 = countif(tostring(TargetUser) == "alice@contoso.com"), Exclude2 = countif(tostring(TargetUser) == "bob@contoso.com"), Exclude3 = countif(tostring(TargetUser) == "carol@contoso.com")
| extend Test = "global-admin-outside-pim", Expected = "1 row(s); 1 must appear; 3 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0 and Exclude3 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
