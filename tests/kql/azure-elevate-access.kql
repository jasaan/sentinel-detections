// Test: azure-elevate-access
// Rule: Global Administrator elevated access to all Azure subscriptions (detections/azure-elevate-access.yaml)
// The elevate-access audit event fires; an unrelated role event doesn't.
// Generated by tools/build_tests.py from tests/cases/azure-elevate-access.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "User has elevated their access to User Access Administrator for their Azure Resources", "AzureRBACRoleManagementElevateAccess", "success", "", dynamic({"user": {"userPrincipalName": "ga1@contoso.com", "ipAddress": "198.51.100.104"}}), dynamic(null), dynamic(null),
    600, "Add member to role", "RoleManagement", "success", "", dynamic({"user": {"userPrincipalName": "ga2@contoso.com"}}), dynamic(null), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName == "User has elevated their access to User Access Administrator for their Azure Resources"
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, Actor, ActorIP, Result, Category
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Actor) == "ga1@contoso.com"), Exclude1 = countif(tostring(Actor) == "ga2@contoso.com")
| extend Test = "azure-elevate-access", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
