// Test: hunt-oauth-mail-permissions
// Rule: Apps granted access to mailboxes (hunting/hunt-oauth-mail-permissions.yaml)
// An app consented to with mail scopes by two users is listed once with both; an app with calendar-only scopes isn't.
// Generated by tools/build_tests.py from tests/cases/hunt-oauth-mail-permissions.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    864000, "Consent to application", "", "success", dynamic({"user": {"userPrincipalName": "alice@contoso.com"}}), dynamic([{"displayName": "Mail Helper Pro", "id": "app-10", "modifiedProperties": [{"displayName": "ConsentAction.Permissions", "newValue": "[] => [[Scope:  Mail.Read User.Read, ]]"}]}]), dynamic(null),
    345600, "Consent to application", "", "success", dynamic({"user": {"userPrincipalName": "bob@contoso.com"}}), dynamic([{"displayName": "Mail Helper Pro", "id": "app-10", "modifiedProperties": [{"displayName": "ConsentAction.Permissions", "newValue": "[] => [[Scope:  Mail.ReadWrite, ]]"}]}]), dynamic(null),
    345600, "Consent to application", "", "success", dynamic({"user": {"userPrincipalName": "carol@contoso.com"}}), dynamic([{"displayName": "Calendar Sync", "id": "app-11", "modifiedProperties": [{"displayName": "ConsentAction.Permissions", "newValue": "[] => [[Scope:  Calendars.Read, ]]"}]}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName == "Consent to application" and Result =~ "success"
| mv-apply Prop = TargetResources[0].modifiedProperties on (
    where tostring(Prop.displayName) == "ConsentAction.Permissions"
    | extend Permissions = tostring(Prop.newValue)
  )
| extend MailScopes = extract_all(@"((?:Mail|MailboxSettings|EWS)\.[\w\.]+|full_access_as_app)", Permissions)
| where array_length(MailScopes) > 0
| summarize Consents = count(), ConsentedBy = make_set(tostring(InitiatedBy.user.userPrincipalName), 25),
    Scopes = make_set(MailScopes), LastConsent = max(TimeGenerated)
    by AppName = tostring(TargetResources[0].displayName), AppId = tostring(TargetResources[0].id)
| order by LastConsent desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(AppName) == "Mail Helper Pro" and tolong(Consents) == 2), Exclude1 = countif(tostring(AppName) == "Calendar Sync")
| extend Test = "hunt-oauth-mail-permissions", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
