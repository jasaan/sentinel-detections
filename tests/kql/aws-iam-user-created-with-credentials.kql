// Test: aws-iam-user-created-with-credentials
// Rule: New IAM user created and given credentials in the same session (detections/aws-iam-user-created-with-credentials.yaml)
// A new user given an access key and admin group fires; a new user with no credentials doesn't.
// Generated by tools/build_tests.py from tests/cases/aws-iam-user-created-with-credentials.yaml. Do not edit by hand.
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    2400, "CreateUser", "iam.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.133", "", "", "", "{\"userName\":\"backup-svc2\"}", "", "",
    2280, "CreateAccessKey", "iam.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.133", "", "", "", "{\"userName\":\"backup-svc2\"}", "", "",
    2220, "AddUserToGroup", "iam.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.133", "", "", "", "{\"userName\":\"backup-svc2\",\"groupName\":\"Admins\"}", "", "",
    1800, "CreateUser", "iam.amazonaws.com", "", "", "arn:aws:iam::123456789012:role/terraform", "", "", "123456789012", "203.0.113.133", "", "", "", "{\"userName\":\"report-reader\"}", "", "",
    1740, "AddUserToGroup", "iam.amazonaws.com", "", "", "arn:aws:iam::123456789012:role/terraform", "", "", "123456789012", "203.0.113.133", "", "", "", "{\"userName\":\"report-reader\",\"groupName\":\"ReadOnly\"}", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Created = AWSCloudTrail
    | where TimeGenerated > ago(1h)
    | where EventName == "CreateUser" and isempty(ErrorCode)
    | extend NewUser = tostring(parse_json(RequestParameters).userName)
    | project CreatedAt = TimeGenerated, NewUser, Creator = UserIdentityArn, CreatorIP = SourceIpAddress, RecipientAccountId;
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where EventName in ("CreateLoginProfile", "CreateAccessKey", "AttachUserPolicy", "AddUserToGroup", "PutUserPolicy") and isempty(ErrorCode)
| extend NewUser = tostring(parse_json(RequestParameters).userName)
| join kind=inner Created on NewUser, RecipientAccountId
| where TimeGenerated >= CreatedAt
| summarize FollowUps = make_set(EventName), LastChange = max(TimeGenerated) by NewUser, Creator, CreatorIP, RecipientAccountId, CreatedAt
| where set_has_element(FollowUps, "CreateLoginProfile") or set_has_element(FollowUps, "CreateAccessKey")
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(NewUser) == "backup-svc2"), Exclude1 = countif(tostring(NewUser) == "report-reader")
| extend Test = "aws-iam-user-created-with-credentials", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
