// Test: cross-tenant-access-change
// Rule: Cross-tenant access or sync settings changed (detections/cross-tenant-access-change.yaml)
// Adding a partner and changing the default cross-tenant setting fire; an unrelated policy update doesn't.
// Generated by tools/build_tests.py from tests/cases/cross-tenant-access-change.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    1200, "Add a partner to cross-tenant access setting", "CrossTenantAccessSettings", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com"}}), dynamic([{"displayName": "00000000-1111-2222-3333-444444444444", "id": "00000000-1111-2222-3333-444444444444"}]), dynamic(null),
    900, "Update the company default cross-tenant access setting", "CrossTenantAccessSettings", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com"}}), dynamic([{"displayName": "default"}]), dynamic(null),
    900, "Update policy", "Policy", "success", "", dynamic({"user": {"userPrincipalName": "admin2@contoso.com"}}), dynamic([{"displayName": "Token lifetime"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName contains "cross-tenant" and Result =~ "success"
| where OperationName !startswith "Get " and OperationName !startswith "List "
| extend Target = tostring(TargetResources[0].displayName), TargetId = tostring(TargetResources[0].id),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress),
    NewValue = tostring(TargetResources[0].modifiedProperties[0].newValue)
| project TimeGenerated, OperationName, Target, TargetId, Actor, ActorIP, NewValue
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(OperationName) == "Add a partner to cross-tenant access setting"), Include2 = countif(tostring(OperationName) == "Update the company default cross-tenant access setting"), Exclude1 = countif(tostring(Actor) == "admin2@contoso.com")
| extend Test = "cross-tenant-access-change", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
