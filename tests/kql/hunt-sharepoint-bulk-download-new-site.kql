| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Known = OfficeActivity
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | where OfficeWorkload in ("SharePoint", "OneDrive")
    | distinct UserId, Site_Url;
OfficeActivity
| where TimeGenerated > ago(1d)
| where OfficeWorkload in ("SharePoint", "OneDrive") and Operation in ("FileDownloaded", "FileSyncDownloadedFull")
| join kind=leftanti Known on UserId, Site_Url
| summarize Files = dcount(SourceFileName), SampleFiles = make_set(SourceFileName, 10), ClientIPs = make_set(ClientIP, 5),
    FirstSeen = min(TimeGenerated) by UserId, Site_Url
| where Files >= 25
| order by Files desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Site_Url) == "https://contoso.sharepoint.com/sites/hr" and tolong(Files) == 30), Exclude1 = countif(tostring(Site_Url) == "https://contoso.sharepoint.com/sites/engineering")
| extend Test = "hunt-sharepoint-bulk-download-new-site", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
