// Test: hunt-clicked-link-new-sender-domain
// Rule: Users clicked links in mail from a sender domain never seen before (hunting/hunt-clicked-link-new-sender-domain.yaml)
// Two users clicking a link from a brand-new lookalike domain show up; a click on mail from a long-standing supplier doesn't.
// Generated by tools/build_tests.py from tests/cases/hunt-clicked-link-new-sender-domain.yaml. Do not edit by hand.
let EmailEvents = datatable(AgoSeconds:long, NetworkMessageId:string, SenderFromAddress:string, SenderFromDomain:string, RecipientEmailAddress:string, Subject:string, EmailDirection:string, DeliveryAction:string, DeliveryLocation:string, ThreatTypes:string, UrlCount:int, AttachmentCount:int) [
    864000, "old-1", "billing@supplier.example", "supplier.example", "alice@contoso.com", "Statement", "Inbound", "Delivered", "", "", int(null), int(null),
    18000, "new-1", "it@contoso-support.example", "contoso-support.example", "alice@contoso.com", "Password expiry", "Inbound", "Delivered", "", "", int(null), int(null),
    18000, "new-1", "it@contoso-support.example", "contoso-support.example", "bob@contoso.com", "Password expiry", "Inbound", "Delivered", "", "", int(null), int(null),
    18000, "sup-2", "billing@supplier.example", "supplier.example", "carol@contoso.com", "Invoice", "Inbound", "Delivered", "", "", int(null), int(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let UrlClickEvents = datatable(AgoSeconds:long, Url:string, ActionType:string, AccountUpn:string, NetworkMessageId:string, IsClickedThrough:bool, IPAddress:string, Workload:string) [
    14400, "https://contoso-support.example/reset", "ClickAllowed", "alice@contoso.com", "new-1", false, "", "",
    14400, "https://contoso-support.example/reset", "ClickAllowed", "bob@contoso.com", "new-1", false, "", "",
    14400, "https://supplier.example/invoice", "ClickAllowed", "carol@contoso.com", "sup-2", false, "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let KnownDomains = EmailEvents
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | where EmailDirection =~ "Inbound"
    | distinct SenderFromDomain;
let NewDomainMail = EmailEvents
    | where TimeGenerated > ago(1d)
    | where EmailDirection =~ "Inbound" and DeliveryAction =~ "Delivered"
    | where SenderFromDomain !in (KnownDomains)
    | project NetworkMessageId, RecipientEmailAddress = tolower(RecipientEmailAddress), SenderFromAddress, SenderFromDomain, Subject;
UrlClickEvents
| where TimeGenerated > ago(1d)
| where ActionType =~ "ClickAllowed" or IsClickedThrough == true
| extend AccountUpn = tolower(AccountUpn)
| join kind=inner NewDomainMail on NetworkMessageId, $left.AccountUpn == $right.RecipientEmailAddress
| summarize ClickerCount = dcount(AccountUpn), Clickers = make_set(AccountUpn, 20), Urls = make_set(Url, 10), FirstClick = min(TimeGenerated)
    by SenderFromDomain, SenderFromAddress, Subject
| order by ClickerCount desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(SenderFromDomain) == "contoso-support.example" and tolong(ClickerCount) == 2), Exclude1 = countif(tostring(SenderFromDomain) == "supplier.example")
| extend Test = "hunt-clicked-link-new-sender-domain", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
