// Test: aws-kms-key-disabled-or-deleted
// Rule: AWS KMS key disabled or scheduled for deletion (detections/aws-kms-key-disabled-or-deleted.yaml)
// Scheduling key deletion fires; creating a key doesn't.
// Generated by tools/build_tests.py from tests/cases/aws-kms-key-disabled-or-deleted.yaml. Do not edit by hand.
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    1200, "ScheduleKeyDeletion", "kms.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.131", "us-east-1", "", "", "{\"keyId\":\"arn:aws:kms:us-east-1:123456789012:key/k1\",\"pendingWindowInDays\":7}", "", "",
    1200, "CreateKey", "kms.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/alice", "", "", "123456789012", "203.0.113.131", "us-east-1", "", "", "{\"description\":\"app key\"}", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where EventSource == "kms.amazonaws.com" and EventName in ("ScheduleKeyDeletion", "DisableKey") and isempty(ErrorCode)
| extend KeyId = tostring(parse_json(RequestParameters).keyId),
    PendingDays = tostring(parse_json(RequestParameters).pendingWindowInDays)
| project TimeGenerated, EventName, KeyId, PendingDays, UserIdentityArn, SourceIpAddress, RecipientAccountId, AWSRegion
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(EventName) == "ScheduleKeyDeletion" and tostring(PendingDays) == "7"), Exclude1 = countif(tostring(EventName) == "CreateKey")
| extend Test = "aws-kms-key-disabled-or-deleted", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
