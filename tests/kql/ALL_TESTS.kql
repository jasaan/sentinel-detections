    "rolemanagement", "devices", "organization", "policies", "oauth2permissiongrants", "domains", "identity",
    "directoryobjects", "administrativeunits", "contacts", "groupsettings"]);
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(1h)
| extend Resource = tolower(extract(@"(?i)graph\.microsoft\.com/(?:v1\.0|beta)/([^/?]+)", 1, RequestUri))
| where Resource in (DirectoryResources)
| extend Identity = iff(isnotempty(UserId), UserId, ServicePrincipalId), IdentityType = iff(isnotempty(UserId), "User", "ServicePrincipal")
| summarize Requests = count(), ResourceTypes = dcount(Resource), Resources = make_set(Resource), IPs = make_set(IPAddress, 10),
    UserAgents = make_set(UserAgent, 5), AppIds = make_set(AppId, 5), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by Identity, IdentityType
| where ResourceTypes >= 6 and Requests >= 100
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Identity) == "u-mallory" and tolong(Requests) == 140 and tolong(ResourceTypes) == 7), Exclude1 = countif(tostring(Identity) == "sp-hr")
| extend Test = "graph-directory-enumeration", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: helpdesk-reset-then-new-ip-signin
// Rule: Admin reset of password or MFA followed by sign-in from a new IP (detections/helpdesk-reset-then-new-ip-signin.yaml)
// A reset followed by a sign-in from a new IP fires; a reset followed by a known-IP sign-in, and a new IP with no reset, don't.
// Generated by tools/build_tests.py from tests/cases/helpdesk-reset-then-new-ip-signin.yaml. Do not edit by hand.
let Test_helpdesk_reset_then_new_ip_signin = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    6000, "Reset password (by admin)", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "helpdesk1@contoso.com"}}), dynamic([{"userPrincipalName": "alice@contoso.com"}]), dynamic(null),
    5700, "Admin registered security info", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "helpdesk1@contoso.com"}}), dynamic([{"userPrincipalName": "alice@contoso.com"}]), dynamic(null),
    6000, "Reset password (by admin)", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "helpdesk2@contoso.com"}}), dynamic([{"userPrincipalName": "bob@contoso.com"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    432000, "alice@contoso.com", "", "203.0.113.20", "US", "0", "", "", "", "", "", "", "", "", "", "", "",
    3600, "alice@contoso.com", "", "198.51.100.77", "US", "0", "", "", "", "", "", "", "", "", "", "", "",
    345600, "bob@contoso.com", "", "203.0.113.21", "US", "0", "", "", "", "", "", "", "", "", "", "", "",
    3600, "bob@contoso.com", "", "203.0.113.21", "US", "0", "", "", "", "", "", "", "", "", "", "", "",
    3600, "carol@contoso.com", "", "198.51.100.78", "US", "0", "", "", "", "", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Resets = AuditLogs
    | where TimeGenerated > ago(3h)
    | where OperationName in ("Reset password (by admin)", "Reset user password", "Admin registered security info",
        "Admin deleted security info", "Admin updated security info") and Result =~ "success"
    | extend UserPrincipalName = tolower(tostring(TargetResources[0].userPrincipalName)),
        Admin = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName))
    | summarize ResetAt = min(TimeGenerated), Changes = make_set(OperationName), Admins = make_set(Admin) by UserPrincipalName;
let History = SigninLogs
    | where TimeGenerated between (ago(14d) .. ago(3h))
    | where ResultType == "0"
    | summarize KnownIPs = make_set(IPAddress, 500) by UserPrincipalName = tolower(UserPrincipalName);
SigninLogs
| where TimeGenerated > ago(3h)
| where ResultType == "0"
| extend UserPrincipalName = tolower(UserPrincipalName)
| join kind=inner Resets on UserPrincipalName
| where TimeGenerated between (ResetAt .. (ResetAt + 2h))
| join kind=leftouter History on UserPrincipalName
| extend KnownIPs = iff(isnull(KnownIPs), dynamic([]), KnownIPs)
| where not(set_has_element(KnownIPs, IPAddress))
| summarize FirstNewIPSignIn = min(TimeGenerated), NewIPs = make_set(IPAddress, 10), Locations = make_set(Location, 10)
    by UserPrincipalName, ResetAt, Changes = tostring(Changes), Admin = tostring(Admins[0])
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tostring(Admin) == "helpdesk1@contoso.com"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "helpdesk-reset-then-new-ip-signin", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
