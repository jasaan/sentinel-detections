// Test: lsass-memory-dump
// Rule: LSASS memory dump by command line (detections/lsass-memory-dump.yaml)
// A comsvcs MiniDump and ProcDump against lsass fire; ProcDump of a web worker and a normal rundll32 call don't.
// Generated by tools/build_tests.py from tests/cases/lsass-memory-dump.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fin-ws-07", "mallory", "rundll32.exe", "", "rundll32.exe C:\\Windows\\System32\\comsvcs.dll, MiniDump 624 C:\\Windows\\Temp\\l.dmp full", "", "", "powershell.exe", "", "",
    600, "srv-app-02", "mallory", "pd64.exe", "", "pd64.exe -accepteula -ma lsass.exe C:\\Users\\Public\\out.dmp", "procdump", "", "cmd.exe", "", "",
    600, "srv-web-01", "webadmin", "procdump64.exe", "", "procdump64.exe -ma w3wp.exe D:\\dumps\\w3wp.dmp", "procdump", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "rundll32.exe", "", "rundll32.exe shell32.dll,Control_RunDLL desk.cpl", "", "", "explorer.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where (FileName =~ "rundll32.exe" and ProcessCommandLine matches regex @"(?i)comsvcs(\.dll)?[\s,]+(minidump|#\s*24)")
    or ((FileName in~ ("procdump.exe", "procdump64.exe") or ProcessVersionInfoOriginalFileName in~ ("procdump", "procdump.exe"))
        and ProcessCommandLine has "lsass")
    or ProcessCommandLine matches regex @"(?i)sekurlsa::|out-minidump|nanodump|lsassy|pypykatz|mimikatz"
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07"), Include2 = countif(tostring(DeviceName) == "srv-app-02"), Exclude1 = countif(tostring(DeviceName) == "srv-web-01"), Exclude2 = countif(tostring(DeviceName) == "it-ws-01")
| extend Test = "lsass-memory-dump", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
