| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where ErrorCode in ("AccessDenied", "AccessDeniedException", "UnauthorizedOperation", "Client.UnauthorizedOperation", "UnauthorizedAccess")
| summarize Errors = count(), DistinctApis = dcount(EventName), Apis = make_set(EventName, 30), Services = make_set(EventSource, 20),
    IPs = make_set(SourceIpAddress, 10), UserAgents = make_set(UserAgent, 5), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by UserIdentityArn, RecipientAccountId
| where Errors >= 25 and DistinctApis >= 10
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserIdentityArn) == "arn:aws:iam::123456789012:user/ci-deploy" and tolong(Errors) == 30), Exclude1 = countif(tostring(UserIdentityArn) == "arn:aws:sts::123456789012:assumed-role/app/i-0abc")
| extend Test = "aws-access-denied-recon-burst", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
