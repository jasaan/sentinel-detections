    600, "dc02", "mallory", "cmd.exe", "", "cmd.exe /c copy \\\\?\\GLOBALROOT\\Device\\HarddiskVolumeShadowCopy3\\Windows\\NTDS\\ntds.dit C:\\Windows\\Temp\\n.dit", "", "", "wmiprvse.exe", "", "",
    600, "dc03", "adadmin", "ntdsutil.exe", "", "ntdsutil.exe \"metadata cleanup\" \"remove selected server dc-old\"", "", "", "cmd.exe", "", ""
]
