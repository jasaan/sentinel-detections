// Test: hunt-aws-access-key-new-ip
// Rule: AWS IAM user's access key used from a new IP (hunting/hunt-aws-access-key-new-ip.yaml)
// A CI user's key used from a new IP shows up; the same user from its usual IP and a brand-new user don't.
// Generated by tools/build_tests.py from tests/cases/hunt-aws-access-key-new-ip.yaml. Do not edit by hand.
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    604800, "PutObject", "s3.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "", "203.0.113.167", "", "aws-cli/2.15", "", "", "", "",
    10800, "PutObject", "s3.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "", "203.0.113.167", "", "aws-cli/2.15", "", "", "", "",
    7200, "ListUsers", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "", "198.51.100.167", "", "python-requests/2.31", "AccessDenied", "", "", "",
    7190, "ListUsers", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "", "198.51.100.167", "", "python-requests/2.31", "AccessDenied", "", "", "",
    7180, "ListUsers", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "", "198.51.100.167", "", "python-requests/2.31", "AccessDenied", "", "", "",
    7170, "ListUsers", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "", "198.51.100.167", "", "python-requests/2.31", "AccessDenied", "", "", "",
    7160, "ListUsers", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "", "198.51.100.167", "", "python-requests/2.31", "AccessDenied", "", "", "",
    7150, "ListUsers", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "", "198.51.100.167", "", "python-requests/2.31", "AccessDenied", "", "", "",
    7200, "GetCallerIdentity", "sts.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/new-hire", "", "", "", "198.51.100.168", "", "aws-cli/2.15", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let History = AWSCloudTrail
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | where UserIdentityType == "IAMUser";
let KnownPairs = History | distinct UserIdentityArn, SourceIpAddress;
let KnownUsers = History | distinct UserIdentityArn;
AWSCloudTrail
| where TimeGenerated > ago(1d)
| where UserIdentityType == "IAMUser" and SourceIpAddress !endswith "amazonaws.com"
| join kind=leftanti KnownPairs on UserIdentityArn, SourceIpAddress
| join kind=inner KnownUsers on UserIdentityArn
| summarize Calls = count(), Errors = countif(isnotempty(ErrorCode)), EventNames = make_set(EventName, 20), UserAgents = make_set(UserAgent, 5),
    FirstSeen = min(TimeGenerated) by UserIdentityArn, SourceIpAddress
| order by Errors desc, Calls desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserIdentityArn) == "arn:aws:iam::123456789012:user/ci-deploy" and tostring(SourceIpAddress) == "198.51.100.167" and tolong(Errors) == 6), Exclude1 = countif(tostring(SourceIpAddress) == "203.0.113.167"), Exclude2 = countif(tostring(UserIdentityArn) == "arn:aws:iam::123456789012:user/new-hire")
| extend Test = "hunt-aws-access-key-new-ip", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
