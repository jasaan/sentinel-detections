let Test_inbox_rule_external_forward = () {
let OfficeActivity = datatable(AgoSeconds:long, Operation:string, RecordType:string, UserId:string, ClientIP:string, OfficeWorkload:string, Parameters:string, SourceFileName:string, Site_Url:string, ResultStatus:string, MailboxOwnerUPN:string, TargetUserOrGroupName:string, TargetUserOrGroupType:string) [
    900, "New-InboxRule", "", "alice@contoso.com", "198.51.100.23", "Exchange", "[{\"Name\":\"Name\",\"Value\":\".\"},{\"Name\":\"ForwardTo\",\"Value\":\"invoices@protonmail.example\"},{\"Name\":\"MarkAsRead\",\"Value\":\"True\"}]", "", "", "", "", "", "",
    900, "Set-InboxRule", "", "carol@contoso.com", "198.51.100.24", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"Rule1\"},{\"Name\":\"RedirectTo\",\"Value\":\"SMTP:carol.personal@gmail.example;dave@contoso.com\"}]", "", "", "", "", "", "",
    900, "New-InboxRule", "", "bob@contoso.com", "10.0.0.8", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"Team\"},{\"Name\":\"ForwardTo\",\"Value\":\"dave@contoso.com\"}]", "", "", "", "", "", "",
    900, "New-InboxRule", "", "erin@contoso.com", "10.0.0.9", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"Newsletters\"},{\"Name\":\"MoveToFolder\",\"Value\":\"News\"}]", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let OrgDomains = dynamic(["contoso.com"]);
OfficeActivity
| where TimeGenerated > ago(1h)
| where OfficeWorkload == "Exchange" and Operation in~ ("New-InboxRule", "Set-InboxRule")
| mv-expand Param = todynamic(Parameters)
| where tostring(Param.Name) in~ ("ForwardTo", "ForwardAsAttachmentTo", "RedirectTo")
| mv-expand Destination = split(tostring(Param.Value), ";") to typeof(string)
| extend Destination = trim(@"\s", replace_regex(Destination, @"(?i)^smtp:", ""))
| extend DestinationDomain = tolower(tostring(split(Destination, "@")[1]))
| where isnotempty(DestinationDomain) and not(DestinationDomain in (OrgDomains))
| summarize Destinations = make_set(Destination), Operations = make_set(Operation) by TimeGenerated, UserId, ClientIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserId) == "alice@contoso.com"), Include2 = countif(tostring(UserId) == "carol@contoso.com"), Exclude1 = countif(tostring(UserId) == "bob@contoso.com"), Exclude2 = countif(tostring(UserId) == "erin@contoso.com")
| extend Test = "inbox-rule-external-forward", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: inbox-rule-hides-mail
// Rule: Inbox rule hides mail about payments or security (detections/inbox-rule-hides-mail.yaml)
// A "." rule sending invoice mail to RSS Feeds and a ".." delete rule fire; a newsletter filter and an invoice-filing rule don't.
// Generated by tools/build_tests.py from tests/cases/inbox-rule-hides-mail.yaml. Do not edit by hand.
let Test_inbox_rule_hides_mail = () {
let OfficeActivity = datatable(AgoSeconds:long, Operation:string, RecordType:string, UserId:string, ClientIP:string, OfficeWorkload:string, Parameters:string, SourceFileName:string, Site_Url:string, ResultStatus:string, MailboxOwnerUPN:string, TargetUserOrGroupName:string, TargetUserOrGroupType:string) [
    1200, "New-InboxRule", "", "alice@contoso.com", "198.51.100.21", "Exchange", "[{\"Name\":\"Name\",\"Value\":\".\"},{\"Name\":\"SubjectOrBodyContainsWords\",\"Value\":\"invoice;payment;wire\"},{\"Name\":\"MoveToFolder\",\"Value\":\"RSS Feeds\"}]", "", "", "", "", "", "",
    1200, "New-InboxRule", "", "dave@contoso.com", "198.51.100.22", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"..\"},{\"Name\":\"FromAddressContainsWords\",\"Value\":\"it-security\"},{\"Name\":\"DeleteMessage\",\"Value\":\"True\"}]", "", "", "", "", "", "",
    1200, "New-InboxRule", "", "bob@contoso.com", "203.0.113.22", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"Newsletters\"},{\"Name\":\"FromAddressContainsWords\",\"Value\":\"news@\"},{\"Name\":\"MoveToFolder\",\"Value\":\"Archive\"}]", "", "", "", "", "", "",
    1200, "New-InboxRule", "", "carol@contoso.com", "203.0.113.23", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"Vendor invoices\"},{\"Name\":\"SubjectContainsWords\",\"Value\":\"invoice\"},{\"Name\":\"MoveToFolder\",\"Value\":\"Vendors\"}]", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Keywords = dynamic(["invoice", "invoices", "payment", "payments", "wire", "bank", "banking", "transfer", "remittance",
    "payroll", "deposit", "ach", "password", "phish", "phishing", "hack", "hacked", "compromised", "suspicious", "fraud",
    "mfa", "helpdesk", "verify", "unusual"]);
OfficeActivity
| where TimeGenerated > ago(1h)
| where Operation in~ ("New-InboxRule", "Set-InboxRule")
| mv-apply P = todynamic(Parameters) on (
    summarize Params = make_bag(bag_pack(tostring(P.Name), tostring(P.Value)))
  )
| extend RuleName = tostring(Params.Name), MoveTo = tostring(Params.MoveToFolder),
    Deletes = tostring(Params.DeleteMessage) =~ "True" or tostring(Params.SoftDeleteMessage) =~ "True",
    Words = tolower(strcat(tostring(Params.SubjectContainsWords), ";", tostring(Params.BodyContainsWords), ";",
        tostring(Params.SubjectOrBodyContainsWords), ";", tostring(Params.FromAddressContainsWords)))
| extend HidesMail = Deletes or MoveTo matches regex @"(?i)rss|archive|conversation history|junk|deleted items"
| extend KeywordMatch = Words has_any (Keywords), OddName = strlen(trim(@"[\s\.\,\-_']+", RuleName)) == 0
| where HidesMail and (KeywordMatch or OddName)
| project TimeGenerated, UserId, ClientIP, Operation, RuleName, MoveTo, Deletes, Words, Parameters
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserId) == "alice@contoso.com" and tostring(RuleName) == "."), Include2 = countif(tostring(UserId) == "dave@contoso.com" and tostring(RuleName) == ".."), Exclude1 = countif(tostring(UserId) == "bob@contoso.com"), Exclude2 = countif(tostring(UserId) == "carol@contoso.com")
| extend Test = "inbox-rule-hides-mail", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
