// Test: suspicious-scheduled-task
// Rule: Scheduled task created that runs a script host, LOLBin or file from a user-writable folder (detections/suspicious-scheduled-task.yaml)
// A logon task running a binary from C:\Users\Public fires; a daily backup task and a task query don't.
// Generated by tools/build_tests.py from tests/cases/suspicious-scheduled-task.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fin-ws-07", "carol", "schtasks.exe", "", "schtasks.exe /create /tn Updater /tr C:\\Users\\Public\\upd.exe /sc onlogon /rl highest", "", "", "rundll32.exe", "", "",
    600, "srv-app-02", "admin", "schtasks.exe", "", "schtasks.exe /create /tn Backup /tr \"C:\\Program Files\\Backup\\run.exe\" /sc daily /st 02:00", "", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "schtasks.exe", "", "schtasks.exe /query /fo LIST", "", "", "cmd.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where FileName =~ "schtasks.exe" and ProcessCommandLine matches regex @"(?i)\s/create\s"
| where ProcessCommandLine matches regex @"(?i)/tr\s+.*(powershell.*\s-(e|ec|enc|encodedcommand|w\s+hidden|windowstyle\s+hidden)\b|mshta|rundll32|regsvr32|wscript|cscript|certutil|bitsadmin|https?://|\\(appdata|temp|users\\public|programdata|perflogs)\\)"
| extend TaskName = extract(@"(?i)/tn\s+(""[^""]+""|\S+)", 1, ProcessCommandLine)
| project TimeGenerated, DeviceName, AccountName, TaskName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07" and tostring(TaskName) == "Updater"), Exclude1 = countif(tostring(DeviceName) == "srv-app-02"), Exclude2 = countif(tostring(DeviceName) == "it-ws-01")
| extend Test = "suspicious-scheduled-task", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
