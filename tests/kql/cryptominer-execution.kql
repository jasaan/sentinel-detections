// Test: cryptominer-execution
// Rule: Cryptocurrency miner started (detections/cryptominer-execution.yaml)
// A renamed miner with stratum arguments fires; a Python app with a hashing flag doesn't.
// Generated by tools/build_tests.py from tests/cases/cryptominer-execution.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "lnx-k8s-03", "root", "kworkerds", "/tmp/.x/kworkerds", "/tmp/.x/kworkerds -o stratum+tcp://pool.example.net:3333 -u 4Abc --donate-level 1", "", "", "sh", "", "",
    600, "lnx-app-01", "app", "python3", "/usr/bin/python3", "python3 app.py --algo sha256", "", "", "systemd", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where FileName matches regex @"(?i)^(xmrig|xmr-stak|minerd|cpuminer|nbminer|t-rex|lolminer|phoenixminer|kdevtmpfsi|kinsing)(\.exe)?$"
    or ProcessCommandLine matches regex @"(?i)stratum\+(tcp|ssl|tls)://|--donate-level|--coin[= ]+(monero|xmr)\b|--algo[= ]+(rx/0|randomx|cryptonight)"
| project TimeGenerated, DeviceName, AccountName, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "lnx-k8s-03"), Exclude1 = countif(tostring(DeviceName) == "lnx-app-01")
| extend Test = "cryptominer-execution", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
