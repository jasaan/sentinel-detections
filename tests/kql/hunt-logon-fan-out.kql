| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceLogonEvents
| where TimeGenerated > ago(1d)
| where ActionType == "LogonSuccess" and LogonType in ("Network", "RemoteInteractive")
| where AccountName !endswith "$"
| summarize DeviceCount = dcount(DeviceName), Devices = make_set(DeviceName, 50), SourceIPs = make_set(RemoteIP, 10),
    FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by AccountDomain, AccountName
| where DeviceCount >= 10
| order by DeviceCount desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(AccountName) == "svc-backup" and tolong(DeviceCount) == 12), Exclude1 = countif(tostring(AccountName) == "alice"), Exclude2 = countif(tostring(AccountName) == "MGMT01$")
| extend Test = "hunt-logon-fan-out", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
