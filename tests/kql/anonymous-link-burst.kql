| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let threshold = 20;
OfficeActivity
| where TimeGenerated > ago(1h)
| where OfficeWorkload in ("SharePoint", "OneDrive") and Operation == "AnonymousLinkCreated"
| summarize Links = count(), Files = dcount(SourceFileName), SampleFiles = make_set(SourceFileName, 20), Sites = make_set(Site_Url, 10),
    ClientIPs = make_set(ClientIP, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by UserId
| where Links >= threshold
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserId) == "alice@contoso.com" and tolong(Links) == 25), Exclude1 = countif(tostring(UserId) == "bob@contoso.com"), Exclude2 = countif(tostring(UserId) == "carol@contoso.com")
| extend Test = "anonymous-link-burst", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
