// Test: web-server-spawns-shell
// Rule: Web server process starts a shell or reconnaissance command (possible web shell) (detections/web-server-spawns-shell.yaml)
// IIS starting cmd /c whoami and nginx starting sh fire; IIS starting the C# compiler doesn't.
// Generated by tools/build_tests.py from tests/cases/web-server-spawns-shell.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "srv-web-01", "DefaultAppPool", "cmd.exe", "", "cmd.exe /c whoami /all", "", "", "w3wp.exe", "", "",
    600, "lnx-web-02", "www-data", "sh", "", "sh -c id;uname -a", "", "", "nginx", "", "",
    600, "srv-web-03", "DefaultAppPool", "csc.exe", "", "csc.exe /noconfig /fullpaths @\"C:\\Windows\\Temp\\x.cmdline\"", "", "", "w3wp.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let WebServers = dynamic(["w3wp.exe", "httpd.exe", "nginx.exe", "php-cgi.exe", "tomcat.exe", "tomcat8.exe", "tomcat9.exe",
    "umworkerprocess.exe", "httpd", "nginx", "apache2", "php-fpm", "lighttpd"]);
let SuspiciousChildren = dynamic(["cmd.exe", "powershell.exe", "pwsh.exe", "whoami.exe", "net.exe", "net1.exe", "certutil.exe",
    "bitsadmin.exe", "rundll32.exe", "mshta.exe", "wscript.exe", "cscript.exe", "nltest.exe", "systeminfo.exe", "tasklist.exe",
    "sh", "bash", "dash", "whoami", "id", "uname", "curl", "wget", "nc", "ncat", "python", "python3", "perl"]);
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where InitiatingProcessFileName in~ (WebServers) and FileName in~ (SuspiciousChildren)
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "srv-web-01"), Include2 = countif(tostring(DeviceName) == "lnx-web-02"), Exclude1 = countif(tostring(DeviceName) == "srv-web-03")
| extend Test = "web-server-spawns-shell", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
