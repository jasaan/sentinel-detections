// Rule: Member added to a privileged Active Directory group (detections/privileged-ad-group-member-added.yaml)
// Adding a user to Domain Admins fires; adding one to a Marketing group doesn't.
// Generated by tools/build_tests.py from tests/cases/privileged-ad-group-member-added.yaml. Do not edit by hand.
let Test_privileged_ad_group_member_added = () {
let SecurityEvent = datatable(AgoSeconds:long, EventID:int, Computer:string, Account:string, SubjectUserName:string, SubjectUserSid:string, TargetUserName:string, TargetSid:string, MemberName:string, IpAddress:string, ServiceName:string, TicketEncryptionType:string, Properties:string, AccessMask:string) [
    900, 4728, "dc01.contoso.local", "", "mallory", "", "Domain Admins", "", "CN=helpdesk2,OU=Staff,DC=contoso,DC=local", "", "", "", "", "",
    900, 4728, "dc01.contoso.local", "", "hr-sync", "", "Marketing", "", "CN=newhire,OU=Staff,DC=contoso,DC=local", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let PrivilegedGroups = dynamic(["Domain Admins", "Enterprise Admins", "Schema Admins", "Administrators", "Account Operators",
    "Backup Operators", "Server Operators", "Print Operators", "DnsAdmins", "Group Policy Creator Owners", "Enterprise Key Admins",
    "Key Admins", "Exchange Windows Permissions", "Organization Management"]);
SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID in (4728, 4732, 4756)
| where TargetUserName in~ (PrivilegedGroups)
| project TimeGenerated, Computer, Group = TargetUserName, Member = MemberName, AddedBy = SubjectUserName, EventID
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Group) == "Domain Admins" and tostring(AddedBy) == "mallory"), Exclude1 = countif(tostring(Group) == "Marketing")
| extend Test = "privileged-ad-group-member-added", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
