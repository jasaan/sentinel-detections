// Test: named-location-change
// Rule: Conditional Access named location added, changed or deleted (detections/named-location-change.yaml)
// Updating a named location to a trusted range fires and flags IsTrusted; updating a CA policy doesn't.
// Generated by tools/build_tests.py from tests/cases/named-location-change.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Update named location", "Policy", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com", "ipAddress": "198.51.100.32"}}), dynamic([{"displayName": "HQ Egress", "modifiedProperties": [{"displayName": "NamedLocation", "newValue": "{\"isTrusted\":true,\"ipRanges\":[{\"cidrAddress\":\"198.51.100.0/24\"}]}"}]}]), dynamic(null),
    600, "Update conditional access policy", "Policy", "success", "", dynamic({"user": {"userPrincipalName": "admin2@contoso.com"}}), dynamic([{"displayName": "Require MFA"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName in ("Add named location", "Update named location", "Delete named location") and Result =~ "success"
| extend Location = tostring(TargetResources[0].displayName),
    NewValue = tostring(TargetResources[0].modifiedProperties[0].newValue),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| extend IsTrusted = NewValue contains '"isTrusted":true'
| project TimeGenerated, OperationName, Location, IsTrusted, NewValue, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Location) == "HQ Egress" and tobool(IsTrusted) == true), Exclude1 = countif(tostring(Actor) == "admin2@contoso.com")
| extend Test = "named-location-change", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
