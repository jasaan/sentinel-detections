// Test: impacket-remote-execution
// Rule: Impacket-style remote execution (wmiexec, smbexec, DCOM) (detections/impacket-remote-execution.yaml)
// wmiexec and smbexec command lines fire with the right method; a normal cmd /c dir doesn't.
// Generated by tools/build_tests.py from tests/cases/impacket-remote-execution.yaml. Do not edit by hand.
let Test_impacket_remote_execution = () {
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fs01", "svc-backup", "cmd.exe", "", "cmd.exe /Q /c whoami 1> \\\\127.0.0.1\\ADMIN$\\__1732190000.4417 2>&1", "", "", "WmiPrvSE.exe", "", "",
    600, "fs02", "system", "cmd.exe", "", "cmd.exe /Q /c echo ipconfig ^> \\\\127.0.0.1\\C$\\__output 2^>^&1 > %TEMP%\\execute.bat", "", "", "services.exe", "", "",
    600, "it-ws-01", "alice", "cmd.exe", "", "cmd.exe /c dir C:\\temp", "", "", "explorer.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where (FileName =~ "cmd.exe" and ProcessCommandLine matches regex @"(?i)/q\s+/c\s.*\\\\127\.0\.0\.1\\(admin|c)\$\\__")
    or (InitiatingProcessFileName =~ "mmc.exe" and InitiatingProcessCommandLine has "-Embedding" and FileName in~ ("cmd.exe", "powershell.exe", "pwsh.exe"))
| extend Method = case(InitiatingProcessFileName =~ "wmiprvse.exe", "wmiexec", InitiatingProcessFileName =~ "services.exe", "smbexec",
    InitiatingProcessFileName =~ "mmc.exe", "dcomexec", "other")
| project TimeGenerated, DeviceName, AccountName, Method, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fs01" and tostring(Method) == "wmiexec"), Include2 = countif(tostring(DeviceName) == "fs02" and tostring(Method) == "smbexec"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01")
| extend Test = "impacket-remote-execution", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
