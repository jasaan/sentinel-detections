// Test: aws-snapshot-shared-externally
// Rule: EBS, AMI or RDS snapshot shared with another account or made public (detections/aws-snapshot-shared-externally.yaml)
// Sharing an EBS snapshot with an outside account and making an RDS snapshot public fire; sharing with a trusted account and removing a share don't.
// Generated by tools/build_tests.py from tests/cases/aws-snapshot-shared-externally.yaml. Do not edit by hand.
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    1200, "ModifySnapshotAttribute", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.130", "", "", "", "{\"snapshotId\":\"snap-0aaa\",\"attributeType\":\"CREATE_VOLUME_PERMISSION\",\"createVolumePermission\":{\"add\":{\"items\":[{\"userId\":\"999988887777\"}]}}}", "", "",
    1200, "ModifyDBSnapshotAttribute", "rds.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.130", "", "", "", "{\"dBSnapshotIdentifier\":\"prod-db-snap\",\"attributeName\":\"restore\",\"valuesToAdd\":[\"all\"]}", "", "",
    1200, "ModifySnapshotAttribute", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:role/backup", "", "", "123456789012", "203.0.113.130", "", "", "", "{\"snapshotId\":\"snap-0bbb\",\"createVolumePermission\":{\"add\":{\"items\":[{\"userId\":\"111111111111\"}]}}}", "", "",
    1200, "ModifySnapshotAttribute", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/alice", "", "", "123456789012", "203.0.113.131", "", "", "", "{\"snapshotId\":\"snap-0ccc\",\"createVolumePermission\":{\"remove\":{\"items\":[{\"userId\":\"999988887777\"}]}}}", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let TrustedAccounts = dynamic(["111111111111"]);
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where EventName in ("ModifySnapshotAttribute", "ModifyImageAttribute", "ModifyDBSnapshotAttribute", "ModifyDBClusterSnapshotAttribute")
| where isempty(ErrorCode)
| extend P = parse_json(RequestParameters)
| extend AddList = case(
    EventName == "ModifySnapshotAttribute", P.createVolumePermission.add.items,
    EventName == "ModifyImageAttribute", P.launchPermission.add.items,
    P.valuesToAdd)
| mv-expand Item = AddList
| extend SharedWith = iff(gettype(Item) == "dictionary", coalesce(tostring(Item.userId), tostring(Item.group)), tostring(Item))
| where isnotempty(SharedWith)
| where SharedWith =~ "all" or (SharedWith != RecipientAccountId and SharedWith !in (TrustedAccounts))
| extend Resource = coalesce(tostring(P.snapshotId), tostring(P.imageId), tostring(P.dBSnapshotIdentifier), tostring(P.dBClusterSnapshotIdentifier)),
    Public = SharedWith =~ "all"
| project TimeGenerated, EventName, Resource, SharedWith, Public, UserIdentityArn, SourceIpAddress, RecipientAccountId
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Resource) == "snap-0aaa" and tostring(SharedWith) == "999988887777"), Include2 = countif(tostring(Resource) == "prod-db-snap" and tobool(Public) == true), Exclude1 = countif(tostring(Resource) == "snap-0bbb"), Exclude2 = countif(tostring(Resource) == "snap-0ccc")
| extend Test = "aws-snapshot-shared-externally", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
