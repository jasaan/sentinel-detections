// Test: mailbox-permission-granted
// Rule: Full Access or Send As granted on a mailbox (detections/mailbox-permission-granted.yaml)
// FullAccess and SendAs grants by an admin fire; a system-initiated grant doesn't.
// Generated by tools/build_tests.py from tests/cases/mailbox-permission-granted.yaml. Do not edit by hand.
let OfficeActivity = datatable(AgoSeconds:long, Operation:string, RecordType:string, UserId:string, ClientIP:string, OfficeWorkload:string, Parameters:string, SourceFileName:string, Site_Url:string, ResultStatus:string, MailboxOwnerUPN:string, TargetUserOrGroupName:string, TargetUserOrGroupType:string) [
    600, "Add-MailboxPermission", "", "admin1@contoso.com", "198.51.100.27", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"cfo@contoso.com\"},{\"Name\":\"User\",\"Value\":\"mallory@contoso.com\"},{\"Name\":\"AccessRights\",\"Value\":\"FullAccess\"},{\"Name\":\"InheritanceType\",\"Value\":\"All\"}]", "", "", "", "", "", "",
    600, "Add-RecipientPermission", "", "admin1@contoso.com", "198.51.100.27", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"cfo@contoso.com\"},{\"Name\":\"Trustee\",\"Value\":\"mallory@contoso.com\"},{\"Name\":\"AccessRights\",\"Value\":\"SendAs\"}]", "", "", "", "", "", "",
    600, "Add-MailboxPermission", "", "NT AUTHORITY\\SYSTEM (Microsoft.Exchange.ServiceHost)", "", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"shared-hr@contoso.com\"},{\"Name\":\"User\",\"Value\":\"hr-team@contoso.com\"},{\"Name\":\"AccessRights\",\"Value\":\"FullAccess\"}]", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
OfficeActivity
| where TimeGenerated > ago(1h)
| where Operation in~ ("Add-MailboxPermission", "Add-RecipientPermission")
| where UserId !startswith "NT AUTHORITY"
| mv-apply P = todynamic(Parameters) on (
    summarize Params = make_bag(bag_pack(tostring(P.Name), tostring(P.Value)))
  )
| extend Mailbox = tostring(Params.Identity), Grantee = coalesce(tostring(Params.User), tostring(Params.Trustee)),
    AccessRights = tostring(Params.AccessRights)
| where AccessRights has_any ("FullAccess", "SendAs")
| project TimeGenerated, Actor = UserId, ClientIP, Operation, Mailbox, Grantee, AccessRights
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Grantee) == "mallory@contoso.com" and tostring(AccessRights) == "FullAccess"), Include2 = countif(tostring(Grantee) == "mallory@contoso.com" and tostring(AccessRights) == "SendAs"), Exclude1 = countif(tostring(Mailbox) == "shared-hr@contoso.com")
| extend Test = "mailbox-permission-granted", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
