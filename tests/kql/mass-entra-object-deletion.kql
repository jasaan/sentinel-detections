// Test: mass-entra-object-deletion
// Rule: Mass deletion of users, groups or apps in Entra ID (detections/mass-entra-object-deletion.yaml)
// Twelve user deletions by one admin fire; three by another admin don't.
// Generated by tools/build_tests.py from tests/cases/mass-entra-object-deletion.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    1800, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user1@contoso.com"}]), dynamic(null),
    1780, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user2@contoso.com"}]), dynamic(null),
    1760, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user3@contoso.com"}]), dynamic(null),
    1740, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user4@contoso.com"}]), dynamic(null),
    1720, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user5@contoso.com"}]), dynamic(null),
    1700, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user6@contoso.com"}]), dynamic(null),
    1680, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user7@contoso.com"}]), dynamic(null),
    1660, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user8@contoso.com"}]), dynamic(null),
    1640, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user9@contoso.com"}]), dynamic(null),
    1620, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user10@contoso.com"}]), dynamic(null),
    1600, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user11@contoso.com"}]), dynamic(null),
    1580, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "rogue@contoso.com"}}), dynamic([{"userPrincipalName": "user12@contoso.com"}]), dynamic(null),
    1800, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "hr-admin@contoso.com"}}), dynamic([{"userPrincipalName": "leaver1@contoso.com"}]), dynamic(null),
    1780, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "hr-admin@contoso.com"}}), dynamic([{"userPrincipalName": "leaver2@contoso.com"}]), dynamic(null),
    1760, "Delete user", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "hr-admin@contoso.com"}}), dynamic([{"userPrincipalName": "leaver3@contoso.com"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let threshold = 10;
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName in ("Delete user", "Delete group", "Delete application", "Hard delete user") and Result =~ "success"
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    Target = coalesce(tostring(TargetResources[0].userPrincipalName), tostring(TargetResources[0].displayName))
| summarize Deletions = count(), Operations = make_set(OperationName), Targets = make_set(Target, 50),
    FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by Actor
| where Deletions >= threshold
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Actor) == "rogue@contoso.com" and tolong(Deletions) == 12), Exclude1 = countif(tostring(Actor) == "hr-admin@contoso.com")
| extend Test = "mass-entra-object-deletion", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
