// Test: event-log-cleared
// Rule: Windows event log or audit policy cleared (detections/event-log-cleared.yaml)
// wevtutil cl Security and event 1102 fire; a wevtutil query and a logon event don't.
// Generated by tools/build_tests.py from tests/cases/event-log-cleared.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fs01", "mallory", "wevtutil.exe", "", "wevtutil.exe cl Security", "", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "wevtutil.exe", "", "wevtutil.exe qe Security /c:5 /f:text", "", "", "cmd.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let SecurityEvent = datatable(AgoSeconds:long, EventID:int, Computer:string, Account:string, SubjectUserName:string, SubjectUserSid:string, TargetUserName:string, TargetSid:string, MemberName:string, IpAddress:string, ServiceName:string, TicketEncryptionType:string, Properties:string, AccessMask:string) [
    600, 1102, "dc01.contoso.local", "", "mallory", "", "", "", "", "", "", "", "", "",
    600, 4624, "dc02.contoso.local", "", "alice", "", "", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
union
    (DeviceProcessEvents
    | where TimeGenerated > ago(1h)
    | where (FileName =~ "wevtutil.exe" and ProcessCommandLine matches regex @"(?i)\s(cl|clear-log)\s")
        or ProcessCommandLine matches regex @"(?i)clear-eventlog|remove-eventlog|globalsession\.clearlog|auditpol(\.exe)?\s+/(clear|remove)"
    | project TimeGenerated, HostName = DeviceName, Account = AccountName, Evidence = ProcessCommandLine, Source = "DeviceProcessEvents"),
    (SecurityEvent
    | where TimeGenerated > ago(1h)
    | where EventID == 1102
    | project TimeGenerated, HostName = Computer, Account = SubjectUserName, Evidence = "Security log cleared (event 1102)", Source = "SecurityEvent")
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(HostName) == "fs01" and tostring(Source) == "DeviceProcessEvents"), Include2 = countif(tostring(HostName) == "dc01.contoso.local" and tostring(Source) == "SecurityEvent"), Exclude1 = countif(tostring(HostName) == "it-ws-01"), Exclude2 = countif(tostring(HostName) == "dc02.contoso.local")
| extend Test = "event-log-cleared", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
