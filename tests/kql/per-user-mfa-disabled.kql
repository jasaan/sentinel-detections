// Test: per-user-mfa-disabled
// Rule: Per-user MFA disabled for an account (detections/per-user-mfa-disabled.yaml)
// Disabling per-user MFA fires; enabling it doesn't.
// Generated by tools/build_tests.py from tests/cases/per-user-mfa-disabled.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Disable Strong Authentication", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com", "ipAddress": "198.51.100.31"}}), dynamic([{"userPrincipalName": "cfo@contoso.com"}]), dynamic(null),
    600, "Enable Strong Authentication", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com", "ipAddress": "198.51.100.31"}}), dynamic([{"userPrincipalName": "intern@contoso.com"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName == "Disable Strong Authentication" and Result =~ "success"
| extend TargetUser = tostring(TargetResources[0].userPrincipalName),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, TargetUser, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(TargetUser) == "cfo@contoso.com"), Exclude1 = countif(tostring(TargetUser) == "intern@contoso.com")
| extend Test = "per-user-mfa-disabled", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
