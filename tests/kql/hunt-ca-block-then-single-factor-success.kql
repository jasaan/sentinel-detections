// Test: hunt-ca-block-then-single-factor-success
// Rule: Blocked by Conditional Access, then signed in elsewhere with a password only (hunting/hunt-ca-block-then-single-factor-success.yaml)
// A CA block followed by a password-only success shows up; a block with no success and a success with no block don't.
// Generated by tools/build_tests.py from tests/cases/hunt-ca-block-then-single-factor-success.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    18000, "alice@contoso.com", "", "198.51.100.161", "", "53003", "", "Office 365 Exchange Online", "", "", "", "", "failure", "singleFactorAuthentication", "", "", "",
    14400, "alice@contoso.com", "", "198.51.100.161", "", "0", "", "Windows Azure Service Management API", "", "", "", "", "notApplied", "singleFactorAuthentication", "", "", "",
    18000, "bob@contoso.com", "", "198.51.100.162", "", "53003", "", "Office 365 Exchange Online", "", "", "", "", "failure", "singleFactorAuthentication", "", "", "",
    14400, "carol@contoso.com", "", "203.0.113.161", "", "0", "", "My Apps", "", "", "", "", "notApplied", "singleFactorAuthentication", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
SigninLogs
| where TimeGenerated > ago(1d)
| extend SingleFactorSuccess = ResultType == "0" and AuthenticationRequirement =~ "singleFactorAuthentication",
    CABlocked = ConditionalAccessStatus =~ "failure"
| summarize CAFailures = countif(CABlocked), FirstBlock = minif(TimeGenerated, CABlocked), BlockedApps = make_set_if(AppDisplayName, CABlocked, 10),
    SingleFactorSuccesses = countif(SingleFactorSuccess), LastSingleFactor = maxif(TimeGenerated, SingleFactorSuccess),
    SingleFactorApps = make_set_if(AppDisplayName, SingleFactorSuccess, 10), IPs = make_set(IPAddress, 10)
    by UserPrincipalName = tolower(UserPrincipalName)
| where CAFailures > 0 and SingleFactorSuccesses > 0 and LastSingleFactor > FirstBlock
| order by CAFailures desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "hunt-ca-block-then-single-factor-success", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
