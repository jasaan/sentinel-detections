// Test: hunt-aws-activity-in-new-region
// Rule: AWS resources created in a region the account doesn't normally use (hunting/hunt-aws-activity-in-new-region.yaml)
// RunInstances in a never-used region shows up; RunInstances in the usual region doesn't.
// Generated by tools/build_tests.py from tests/cases/hunt-aws-activity-in-new-region.yaml. Do not edit by hand.
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    864000, "DescribeInstances", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/ops", "", "", "123456789012", "203.0.113.166", "us-east-1", "", "", "", "", "",
    10800, "RunInstances", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/ops", "", "", "123456789012", "203.0.113.166", "us-east-1", "", "", "", "", "",
    10800, "RunInstances", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "123456789012", "198.51.100.166", "ap-southeast-3", "", "", "", "", "",
    10790, "RunInstances", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "123456789012", "198.51.100.166", "ap-southeast-3", "", "", "", "", "",
    10780, "RunInstances", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "123456789012", "198.51.100.166", "ap-southeast-3", "", "", "", "", "",
    10770, "RunInstances", "ec2.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/ci-deploy", "", "", "123456789012", "198.51.100.166", "ap-southeast-3", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Known = AWSCloudTrail
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | distinct RecipientAccountId, AWSRegion;
AWSCloudTrail
| where TimeGenerated > ago(1d)
| where isempty(ErrorCode) and EventName matches regex @"^(Run|Create|Put|Start|Request|Import)"
| join kind=leftanti Known on RecipientAccountId, AWSRegion
| summarize Events = count(), EventNames = make_set(EventName, 20), Principals = make_set(UserIdentityArn, 10),
    IPs = make_set(SourceIpAddress, 10), FirstSeen = min(TimeGenerated) by RecipientAccountId, AWSRegion
| order by Events desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(AWSRegion) == "ap-southeast-3" and tolong(Events) == 4), Exclude1 = countif(tostring(AWSRegion) == "us-east-1")
| extend Test = "hunt-aws-activity-in-new-region", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
