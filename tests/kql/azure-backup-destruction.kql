// Test: azure-backup-destruction
// Rule: Azure backup protection removed or backup vault deleted (detections/azure-backup-destruction.yaml)
// Stopping protection and deleting a vault fire; reading backup jobs doesn't.
// Generated by tools/build_tests.py from tests/cases/azure-backup-destruction.yaml. Do not edit by hand.
let AzureActivity = datatable(AgoSeconds:long, OperationNameValue:string, ActivityStatusValue:string, Caller:string, CallerIpAddress:string, SubscriptionId:string, ResourceGroup:string, _ResourceId:string, Properties_d:dynamic) [
    1200, "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPFABRICS/PROTECTIONCONTAINERS/PROTECTEDITEMS/DELETE", "Succeeded", "mallory@contoso.com", "198.51.100.106", "sub-1", "", "/subscriptions/sub-1/resourceGroups/bk/providers/Microsoft.RecoveryServices/vaults/rsv1/item1", dynamic(null),
    900, "MICROSOFT.RECOVERYSERVICES/VAULTS/DELETE", "Succeeded", "mallory@contoso.com", "198.51.100.106", "sub-1", "", "/subscriptions/sub-1/resourceGroups/bk/providers/Microsoft.RecoveryServices/vaults/rsv1", dynamic(null),
    900, "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPJOBS/READ", "Succeeded", "backup-admin@contoso.com", "203.0.113.106", "sub-1", "", "/subscriptions/sub-1/resourceGroups/bk/providers/Microsoft.RecoveryServices/vaults/rsv2", dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let BackupOps = dynamic(["MICROSOFT.RECOVERYSERVICES/VAULTS/DELETE",
    "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPFABRICS/PROTECTIONCONTAINERS/PROTECTEDITEMS/DELETE",
    "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPCONFIG/WRITE", "MICROSOFT.RECOVERYSERVICES/VAULTS/BACKUPPOLICIES/DELETE",
    "MICROSOFT.DATAPROTECTION/BACKUPVAULTS/DELETE", "MICROSOFT.DATAPROTECTION/BACKUPVAULTS/BACKUPINSTANCES/DELETE",
    "MICROSOFT.DATAPROTECTION/BACKUPVAULTS/BACKUPPOLICIES/DELETE"]);
AzureActivity
| where TimeGenerated > ago(1h)
| where OperationNameValue in~ (BackupOps) and ActivityStatusValue in~ ("Success", "Succeeded")
| summarize FirstSeen = min(TimeGenerated), Operations = make_set(OperationNameValue), Resources = make_set(_ResourceId, 20),
    Count = count() by Caller, CallerIpAddress, SubscriptionId
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Caller) == "mallory@contoso.com" and tolong(Count) == 2), Exclude1 = countif(tostring(Caller) == "backup-admin@contoso.com")
| extend Test = "azure-backup-destruction", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
