// Test: ntds-dit-extraction
// Rule: Active Directory database (NTDS.dit) extraction (detections/ntds-dit-extraction.yaml)
// ntdsutil IFM and copying ntds.dit from a shadow copy fire; ntdsutil metadata cleanup doesn't.
// Generated by tools/build_tests.py from tests/cases/ntds-dit-extraction.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "dc01", "mallory", "ntdsutil.exe", "", "ntdsutil.exe \"ac i ntds\" \"ifm\" \"create full C:\\Windows\\Temp\\x\" q q", "", "", "cmd.exe", "", "",
    600, "dc02", "mallory", "cmd.exe", "", "cmd.exe /c copy \\\\?\\GLOBALROOT\\Device\\HarddiskVolumeShadowCopy3\\Windows\\NTDS\\ntds.dit C:\\Windows\\Temp\\n.dit", "", "", "wmiprvse.exe", "", "",
    600, "dc03", "adadmin", "ntdsutil.exe", "", "ntdsutil.exe \"metadata cleanup\" \"remove selected server dc-old\"", "", "", "cmd.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where (FileName =~ "ntdsutil.exe" and ProcessCommandLine matches regex @"(?i)\bifm\b")
    or ProcessCommandLine matches regex @"(?i)\\ntds\.dit"
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "dc01"), Include2 = countif(tostring(DeviceName) == "dc02"), Exclude1 = countif(tostring(DeviceName) == "dc03")
| extend Test = "ntds-dit-extraction", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
