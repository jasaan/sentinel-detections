let RuleResults = () {
let threshold = 100;
let CommonExtensions = dynamic(["doc", "docx", "xls", "xlsx", "ppt", "pptx", "pdf", "txt", "csv", "jpg", "jpeg", "png", "gif",
    "zip", "7z", "rar", "tmp", "temp", "log", "bak", "old", "partial", "crdownload", "part", "json", "xml", "dat", "db", "msg", "eml"]);
DeviceFileEvents
| where TimeGenerated > ago(15m)
| where ActionType == "FileRenamed"
| extend NewExt = tolower(extract(@"\.([^.\\/]+)$", 1, FileName)), OldExt = tolower(extract(@"\.([^.\\/]+)$", 1, PreviousFileName))
| where isnotempty(NewExt) and NewExt != OldExt and NewExt !in (CommonExtensions)
| summarize Renamed = count(), SampleFiles = make_set(FolderPath, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
    AccountName = take_any(InitiatingProcessAccountName)
    by DeviceName, InitiatingProcessFileName, InitiatingProcessCommandLine, NewExt
| where Renamed >= threshold
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fs01" and tostring(NewExt) == "lockd" and tolong(Renamed) == 150), Exclude1 = countif(tostring(DeviceName) == "it-ws-01"), Exclude2 = countif(tostring(DeviceName) == "it-ws-02")
| extend Test = "ransomware-mass-file-rename", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: registry-hive-credential-export
// Rule: SAM, SECURITY or SYSTEM registry hive saved to disk (detections/registry-hive-credential-export.yaml)
// Saving HKLM\SAM fires; querying HKLM\SYSTEM and exporting a user key don't.
// Generated by tools/build_tests.py from tests/cases/registry-hive-credential-export.yaml. Do not edit by hand.
let Test_registry_hive_credential_export = () {
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fin-ws-07", "mallory", "reg.exe", "", "reg.exe save HKLM\\SAM C:\\Windows\\Temp\\s.save", "reg.exe", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "reg.exe", "", "reg.exe query HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip", "reg.exe", "", "cmd.exe", "", "",
    600, "it-ws-02", "bob", "reg.exe", "", "reg.exe export HKCU\\Software\\Vendor C:\\temp\\vendor.reg", "reg.exe", "", "cmd.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where (FileName =~ "reg.exe" or ProcessVersionInfoOriginalFileName =~ "reg.exe")
    and ProcessCommandLine matches regex @"(?i)\b(save|export)\b.*\b(hklm|hkey_local_machine)\\(sam|security|system)(\s|""|$)"
    or (FileName =~ "esentutl.exe" and ProcessCommandLine matches regex @"(?i)\\config\\(sam|security|system)\b")
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01"), Exclude2 = countif(tostring(DeviceName) == "it-ws-02")
| extend Test = "registry-hive-credential-export", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: risky-attachment-delivered
// Rule: Email with a high-risk attachment type delivered to the inbox (detections/risky-attachment-delivered.yaml)
// An ISO attachment delivered to the inbox fires; a PDF and a quarantined LNK don't.
// Generated by tools/build_tests.py from tests/cases/risky-attachment-delivered.yaml. Do not edit by hand.
let Test_risky_attachment_delivered = () {
let EmailAttachmentInfo = datatable(AgoSeconds:long, NetworkMessageId:string, SenderFromAddress:string, RecipientEmailAddress:string, FileName:string, FileType:string, SHA256:string) [
    1200, "msg-10", "billing@invoices.example", "alice@contoso.com", "Invoice_8812.iso", "iso", "aaaa000000000000000000000000000000000000000000000000000000000001",
    1200, "msg-11", "partner@vendor.example", "bob@contoso.com", "statement.pdf", "pdf", "aaaa000000000000000000000000000000000000000000000000000000000002",
    1200, "msg-12", "hr@payroll.example", "carol@contoso.com", "Payslip.lnk", "lnk", "aaaa000000000000000000000000000000000000000000000000000000000003"
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let EmailEvents = datatable(AgoSeconds:long, NetworkMessageId:string, SenderFromAddress:string, SenderFromDomain:string, RecipientEmailAddress:string, Subject:string, EmailDirection:string, DeliveryAction:string, DeliveryLocation:string, ThreatTypes:string, UrlCount:int, AttachmentCount:int) [
    1200, "msg-10", "billing@invoices.example", "invoices.example", "alice@contoso.com", "Invoice 8812", "Inbound", "Delivered", "Inbox/folder", "", 0, 1,
    1200, "msg-11", "partner@vendor.example", "vendor.example", "bob@contoso.com", "Statement", "Inbound", "Delivered", "Inbox/folder", "", 0, 1,
    1200, "msg-12", "hr@payroll.example", "payroll.example", "carol@contoso.com", "Payslip", "Inbound", "Blocked", "Quarantine", "Malware", 0, 1
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let RiskyExtensions = dynamic(["iso", "img", "vhd", "vhdx", "lnk", "hta", "js", "jse", "vbs", "vbe", "wsf", "wsh", "one",
    "chm", "scr", "cpl", "svg", "xll", "msc", "appx", "msix", "library-ms", "pif", "jar", "ps1", "bat", "cmd"]);
EmailAttachmentInfo
| where TimeGenerated > ago(1h)
| extend Extension = tolower(extract(@"\.([A-Za-z0-9\-]+)$", 1, FileName))
| where Extension in (RiskyExtensions) or tolower(FileType) in (RiskyExtensions)
| join kind=inner (
    EmailEvents
    | where TimeGenerated > ago(1h)
    | where EmailDirection =~ "Inbound" and DeliveryAction =~ "Delivered" and DeliveryLocation !in~ ("Quarantine", "Junk folder")
    | project NetworkMessageId, RecipientEmailAddress, Subject, SenderFromDomain, DeliveryLocation
  ) on NetworkMessageId, RecipientEmailAddress
| summarize Recipients = make_set(RecipientEmailAddress, 50), RecipientCount = dcount(RecipientEmailAddress), FirstSeen = min(TimeGenerated)
    by FileName, Extension, SHA256, SenderFromAddress, SenderFromDomain, Subject
| extend HashAlgorithm = "SHA256"
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(FileName) == "Invoice_8812.iso" and tostring(Extension) == "iso"), Exclude1 = countif(tostring(FileName) == "statement.pdf"), Exclude2 = countif(tostring(FileName) == "Payslip.lnk")
| extend Test = "risky-attachment-delivered", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: risky-signin-single-factor
// Rule: High-risk sign-in succeeded with a password only (detections/risky-signin-single-factor.yaml)
// A high-risk password-only sign-in fires; a high-risk sign-in with MFA and a low-risk password-only one don't.
// Generated by tools/build_tests.py from tests/cases/risky-signin-single-factor.yaml. Do not edit by hand.
let Test_risky_signin_single_factor = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    600, "alice@contoso.com", "", "198.51.100.5", "RO", "0", "", "", "", "", "", "", "", "singleFactorAuthentication", "high", "", "",
    600, "bob@contoso.com", "", "198.51.100.6", "RO", "0", "", "", "", "", "", "", "", "multiFactorAuthentication", "high", "", "",
    600, "carol@contoso.com", "", "203.0.113.7", "US", "0", "", "", "", "", "", "", "", "singleFactorAuthentication", "low", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType == "0" and RiskLevelDuringSignIn =~ "high" and AuthenticationRequirement =~ "singleFactorAuthentication"
| project TimeGenerated, UserPrincipalName, IPAddress, Location, AppDisplayName, ClientAppUsed, UserAgent, ConditionalAccessStatus
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "risky-signin-single-factor", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: rmm-tool-first-seen
// Rule: Remote access (RMM) tool runs on a device for the first time (detections/rmm-tool-first-seen.yaml)
// AnyDesk appearing on a finance laptop fires; TeamViewer that ran there last week and an unrelated process don't.
// Generated by tools/build_tests.py from tests/cases/rmm-tool-first-seen.yaml. Do not edit by hand.
let Test_rmm_tool_first_seen = () {
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    1200, "fin-ws-07", "carol", "AnyDesk.exe", "C:\\Users\\carol\\Downloads\\AnyDesk.exe", "\"AnyDesk.exe\"", "", "", "explorer.exe", "", "",
    432000, "it-ws-01", "alice", "TeamViewer.exe", "C:\\Program Files\\TeamViewer\\TeamViewer.exe", "\"TeamViewer.exe\"", "", "", "explorer.exe", "", "",
    1200, "it-ws-01", "alice", "TeamViewer.exe", "C:\\Program Files\\TeamViewer\\TeamViewer.exe", "\"TeamViewer.exe\"", "", "", "explorer.exe", "", "",
    1200, "it-ws-02", "bob", "notepad.exe", "C:\\Windows\\System32\\notepad.exe", "notepad.exe", "", "", "explorer.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let ApprovedTools = dynamic(["approved-rmm-agent.exe"]);
let RmmPattern = @"(?i)^(anydesk|screenconnect\..*|connectwisecontrol\..*|atera.*agent|splashtop.*|srservice|teamviewer.*|tv_[wx]64|netsupport.*|client32|rustdesk|meshagent|tacticalrmm|rutserv|rfusclient|supremo.*|zohoassist.*|dwagent|simplehelp.*|remotepc.*|getscreen|ammyy.*|action1_agent|quickassist)\.exe$";
let Known = DeviceProcessEvents
    | where TimeGenerated between (ago(14d) .. ago(1h))
    | where FileName matches regex RmmPattern
    | distinct DeviceName, Tool = tolower(FileName);
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where FileName matches regex RmmPattern
| extend Tool = tolower(FileName)
| where Tool !in (ApprovedTools)
| join kind=leftanti Known on DeviceName, Tool
| summarize FirstSeen = min(TimeGenerated), AccountName = take_any(AccountName), FolderPath = take_any(FolderPath),
    Parents = make_set(InitiatingProcessFileName, 5), CommandLines = make_set(ProcessCommandLine, 5) by DeviceName, Tool
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07" and tostring(Tool) == "anydesk.exe"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01"), Exclude2 = countif(tostring(DeviceName) == "it-ws-02")
