let RuleResults = () {
let minRecipients = 100;
let Baseline = EmailEvents
    | where TimeGenerated between (ago(14d) .. ago(1h))
    | where EmailDirection in~ ("Outbound", "Intra-org")
    | summarize Recipients = dcount(RecipientEmailAddress) by Sender = tolower(SenderFromAddress), Hour = bin(TimeGenerated, 1h)
    | summarize BaselineMaxPerHour = max(Recipients) by Sender;
EmailEvents
| where TimeGenerated > ago(1h)
| where EmailDirection in~ ("Outbound", "Intra-org")
| summarize Recipients = dcount(RecipientEmailAddress), Messages = count(), WithUrls = countif(UrlCount > 0),
    Subjects = make_set(Subject, 5) by Sender = tolower(SenderFromAddress)
| join kind=leftouter Baseline on Sender
| extend BaselineMaxPerHour = iff(isnull(BaselineMaxPerHour), 0, BaselineMaxPerHour)
| where Recipients >= minRecipients and Recipients > 3 * BaselineMaxPerHour
| project Sender, Recipients, Messages, WithUrls, BaselineMaxPerHour, Subjects
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Sender) == "alice@contoso.com"), Exclude1 = countif(tostring(Sender) == "news@contoso.com")
| extend Test = "outbound-mail-burst", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: per-user-mfa-disabled
// Rule: Per-user MFA disabled for an account (detections/per-user-mfa-disabled.yaml)
// Disabling per-user MFA fires; enabling it doesn't.
// Generated by tools/build_tests.py from tests/cases/per-user-mfa-disabled.yaml. Do not edit by hand.
let Test_per_user_mfa_disabled = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Disable Strong Authentication", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com", "ipAddress": "198.51.100.31"}}), dynamic([{"userPrincipalName": "cfo@contoso.com"}]), dynamic(null),
    600, "Enable Strong Authentication", "UserManagement", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com", "ipAddress": "198.51.100.31"}}), dynamic([{"userPrincipalName": "intern@contoso.com"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName == "Disable Strong Authentication" and Result =~ "success"
| extend TargetUser = tostring(TargetResources[0].userPrincipalName),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, TargetUser, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(TargetUser) == "cfo@contoso.com"), Exclude1 = countif(tostring(TargetUser) == "intern@contoso.com")
| extend Test = "per-user-mfa-disabled", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: phish-delivered-and-clicked
// Rule: User clicked a link in a delivered phishing email (detections/phish-delivered-and-clicked.yaml)
// A click-through on a delivered phish fires; a blocked click and a click on a clean email don't.
// Generated by tools/build_tests.py from tests/cases/phish-delivered-and-clicked.yaml. Do not edit by hand.
let Test_phish_delivered_and_clicked = () {
let EmailEvents = datatable(AgoSeconds:long, NetworkMessageId:string, SenderFromAddress:string, SenderFromDomain:string, RecipientEmailAddress:string, Subject:string, EmailDirection:string, DeliveryAction:string, DeliveryLocation:string, ThreatTypes:string, UrlCount:int, AttachmentCount:int) [
    10800, "msg-1", "docs@share-files.example", "share-files.example", "alice@contoso.com", "Shared document", "Inbound", "Delivered", "Inbox/folder", "Phish", 1, 0,
    10800, "msg-2", "docs@share-files.example", "share-files.example", "bob@contoso.com", "Shared document", "Inbound", "Delivered", "Inbox/folder", "Phish", 1, 0,
    10800, "msg-3", "news@vendor.example", "vendor.example", "carol@contoso.com", "Newsletter", "Inbound", "Delivered", "Inbox/folder", "", 3, 0
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let UrlClickEvents = datatable(AgoSeconds:long, Url:string, ActionType:string, AccountUpn:string, NetworkMessageId:string, IsClickedThrough:bool, IPAddress:string, Workload:string) [
    1200, "https://share-files.example/login", "ClickAllowed", "Alice@contoso.com", "msg-1", false, "203.0.113.35", "Email",
    1200, "https://share-files.example/login", "ClickBlocked", "bob@contoso.com", "msg-2", false, "203.0.113.36", "Email",
    1200, "https://vendor.example/news", "ClickAllowed", "carol@contoso.com", "msg-3", false, "203.0.113.37", "Email"
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Phish = EmailEvents
    | where TimeGenerated > ago(1d)
    | where ThreatTypes has "Phish" and DeliveryAction =~ "Delivered"
    | project NetworkMessageId, RecipientEmailAddress = tolower(RecipientEmailAddress), SenderFromAddress, Subject, DeliveryLocation;
UrlClickEvents
| where TimeGenerated > ago(1h)
| where ActionType =~ "ClickAllowed" or IsClickedThrough == true
| extend AccountUpn = tolower(AccountUpn)
| join kind=inner Phish on NetworkMessageId, $left.AccountUpn == $right.RecipientEmailAddress
| summarize FirstClick = min(TimeGenerated), Urls = make_set(Url, 10), ClickIPs = make_set(IPAddress, 5)
    by AccountUpn, NetworkMessageId, SenderFromAddress, Subject
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(AccountUpn) == "alice@contoso.com" and tostring(NetworkMessageId) == "msg-1"), Exclude1 = countif(tostring(AccountUpn) == "bob@contoso.com"), Exclude2 = countif(tostring(AccountUpn) == "carol@contoso.com")
| extend Test = "phish-delivered-and-clicked", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
