// Test: run-key-persistence
// Rule: Run key or Winlogon value points to a script host or user-writable folder (detections/run-key-persistence.yaml)
// A Run value pointing into AppData\Roaming fires; OneDrive in AppData\Local and a System32 value don't.
// Generated by tools/build_tests.py from tests/cases/run-key-persistence.yaml. Do not edit by hand.
let Test_run_key_persistence = () {
let DeviceRegistryEvents = datatable(AgoSeconds:long, DeviceName:string, ActionType:string, RegistryKey:string, RegistryValueName:string, RegistryValueData:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessAccountName:string) [
    600, "fin-ws-07", "RegistryValueSet", "HKEY_CURRENT_USER\\S-1-5-21-1-2-3-1104\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run", "Updater", "C:\\Users\\carol\\AppData\\Roaming\\upd\\svc.exe", "svc.exe", "", "carol",
    600, "it-ws-01", "RegistryValueSet", "HKEY_CURRENT_USER\\S-1-5-21-1-2-3-1105\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run", "OneDrive", "\"C:\\Users\\alice\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe\" /background", "OneDriveSetup.exe", "", "alice",
    600, "it-ws-02", "RegistryValueSet", "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run", "SecurityHealth", "%windir%\\system32\\SecurityHealthSystray.exe", "TrustedInstaller.exe", "", "system"
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceRegistryEvents
| where TimeGenerated > ago(1h)
| where ActionType == "RegistryValueSet"
| where RegistryKey matches regex @"(?i)\\software\\(wow6432node\\)?microsoft\\windows\\currentversion\\(run|runonce|runonceex|policies\\explorer\\run)$"
    or (RegistryKey matches regex @"(?i)\\microsoft\\windows nt\\currentversion\\winlogon$" and RegistryValueName in~ ("Userinit", "Shell"))
| where RegistryValueData matches regex @"(?i)\\(appdata|temp|users\\public|programdata|perflogs)\\|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|cmd(\.exe)?\s+/c|https?://"
| where not(RegistryValueData matches regex @"(?i)\\appdata\\local\\(microsoft\\(onedrive|teams)|slack|discord|zoom)\\")
| project TimeGenerated, DeviceName, RegistryKey, RegistryValueName, RegistryValueData, InitiatingProcessFileName,
    InitiatingProcessCommandLine, AccountName = InitiatingProcessAccountName
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07" and tostring(RegistryValueName) == "Updater"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01"), Exclude2 = countif(tostring(DeviceName) == "it-ws-02")
| extend Test = "run-key-persistence", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: service-principal-signin-new-country
// Rule: Service principal signs in from a new country (detections/service-principal-signin-new-country.yaml)
// An app that always signs in from the US signing in from Russia fires; a known-country sign-in and a brand-new app don't.
// Generated by tools/build_tests.py from tests/cases/service-principal-signin-new-country.yaml. Do not edit by hand.
let Test_service_principal_signin_new_country = () {
let AADServicePrincipalSignInLogs = datatable(AgoSeconds:long, ServicePrincipalName:string, ServicePrincipalId:string, AppId:string, IPAddress:string, Location:string, ResultType:string, ResourceDisplayName:string) [
    518400, "BackupSync", "sp-1", "app-1", "203.0.113.80", "US", "0", "",
    1200, "BackupSync", "sp-1", "app-1", "198.51.100.80", "RU", "0", "Microsoft Graph",
    518400, "HRConnector", "sp-2", "app-2", "203.0.113.81", "US", "0", "",
    1200, "HRConnector", "sp-2", "app-2", "203.0.113.81", "US", "0", "",
    1200, "NewPilotApp", "sp-3", "app-3", "198.51.100.81", "DE", "0", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Known = AADServicePrincipalSignInLogs
    | where TimeGenerated between (ago(14d) .. ago(1h))
    | where ResultType == "0" and isnotempty(Location)
    | summarize KnownCountries = make_set(Location, 100) by ServicePrincipalId;
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(1h)
| where ResultType == "0" and isnotempty(Location)
| join kind=inner Known on ServicePrincipalId
| where not(set_has_element(KnownCountries, Location))
| summarize FirstSeen = min(TimeGenerated), SignIns = count(), IPs = make_set(IPAddress, 10), Resources = make_set(ResourceDisplayName, 10)
    by ServicePrincipalName, ServicePrincipalId, AppId, Location, KnownCountries = tostring(KnownCountries)
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(ServicePrincipalName) == "BackupSync" and tostring(Location) == "RU"), Exclude1 = countif(tostring(ServicePrincipalName) == "HRConnector"), Exclude2 = countif(tostring(ServicePrincipalName) == "NewPilotApp")
| extend Test = "service-principal-signin-new-country", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
