    1186, 4769, "dc01.contoso.local", "", "", "", "bob@CONTOSO.LOCAL", "", "", "::ffff:10.0.5.29", "WS8$", "0x17", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let threshold = 5;
SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4769 and TicketEncryptionType == "0x17"
| where ServiceName !endswith "$" and ServiceName !~ "krbtgt"
| summarize Services = dcount(ServiceName), ServiceList = make_set(ServiceName, 50), FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated), DomainControllers = make_set(Computer, 5) by TargetUserName, IpAddress
| where Services >= threshold
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(TargetUserName) == "carol@CONTOSO.LOCAL" and tolong(Services) == 8), Exclude1 = countif(tostring(TargetUserName) == "alice@CONTOSO.LOCAL"), Exclude2 = countif(tostring(TargetUserName) == "bob@CONTOSO.LOCAL")
| extend Test = "kerberoasting", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
