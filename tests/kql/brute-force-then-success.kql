    2370, "bob@contoso.com", "", "198.51.100.45", "BR", "50126", "", "", "", "", "", "", "", "", "", "", "",
    2340, "bob@contoso.com", "", "198.51.100.45", "BR", "50126", "", "", "", "", "", "", "", "", "", "", "",
