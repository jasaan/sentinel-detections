// Test: entra-connect-sync-account-misuse
// Rule: Entra Connect sync account used outside directory sync (detections/entra-connect-sync-account-misuse.yaml)
// The sync account signing in to the Azure portal fires; its normal sync sign-in and a regular user don't.
// Generated by tools/build_tests.py from tests/cases/entra-connect-sync-account-misuse.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    900, "Sync_ADC01_1a2b3c@contoso.onmicrosoft.com", "", "198.51.100.55", "", "0", "", "Azure Portal", "", "", "", "", "", "", "", "", "",
    900, "alice@contoso.com", "", "203.0.113.55", "", "0", "", "Azure Portal", "", "", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let AADNonInteractiveUserSignInLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    600, "Sync_ADC02_9z8y7x@contoso.onmicrosoft.com", "", "203.0.113.56", "", "0", "", "Microsoft Azure Active Directory Connect", "", "", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let SyncApps = dynamic(["Microsoft Azure Active Directory Connect", "Microsoft Entra Connect", "Microsoft Online Syncfabric"]);
union
    (SigninLogs | where TimeGenerated > ago(1h)),
    (AADNonInteractiveUserSignInLogs | where TimeGenerated > ago(1h))
| where UserPrincipalName startswith "sync_" and ResultType == "0"
| where AppDisplayName !in~ (SyncApps)
| summarize FirstSeen = min(TimeGenerated), Apps = make_set(AppDisplayName, 10), IPs = make_set(IPAddress, 10),
    UserAgents = make_set(UserAgent, 5) by UserPrincipalName
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "Sync_ADC01_1a2b3c@contoso.onmicrosoft.com"), Exclude1 = countif(tostring(UserPrincipalName) == "alice@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "Sync_ADC02_9z8y7x@contoso.onmicrosoft.com")
| extend Test = "entra-connect-sync-account-misuse", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
