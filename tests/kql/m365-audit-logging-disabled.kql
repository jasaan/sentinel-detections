// Test: m365-audit-logging-disabled
// Rule: Microsoft 365 audit logging turned off or bypassed (detections/m365-audit-logging-disabled.yaml)
// Disabling mailbox auditing and adding an audit bypass fire; an unrelated Set-Mailbox doesn't.
// Generated by tools/build_tests.py from tests/cases/m365-audit-logging-disabled.yaml. Do not edit by hand.
let OfficeActivity = datatable(AgoSeconds:long, Operation:string, RecordType:string, UserId:string, ClientIP:string, OfficeWorkload:string, Parameters:string, SourceFileName:string, Site_Url:string, ResultStatus:string, MailboxOwnerUPN:string, TargetUserOrGroupName:string, TargetUserOrGroupType:string) [
    600, "Set-Mailbox", "", "admin1@contoso.com", "198.51.100.28", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"ceo@contoso.com\"},{\"Name\":\"AuditEnabled\",\"Value\":\"False\"}]", "", "", "", "", "", "",
    600, "Set-MailboxAuditBypassAssociation", "", "admin1@contoso.com", "198.51.100.28", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"svc-reader@contoso.com\"},{\"Name\":\"AuditBypassEnabled\",\"Value\":\"True\"}]", "", "", "", "", "", "",
    600, "Set-Mailbox", "", "admin2@contoso.com", "203.0.113.28", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"bob@contoso.com\"},{\"Name\":\"ProhibitSendQuota\",\"Value\":\"49GB\"}]", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
OfficeActivity
| where TimeGenerated > ago(1h)
| where Operation in~ ("Set-AdminAuditLogConfig", "Set-Mailbox", "Set-MailboxAuditBypassAssociation", "Set-OrganizationConfig")
| mv-apply P = todynamic(Parameters) on (
    summarize Params = make_bag(bag_pack(tostring(P.Name), tostring(P.Value)))
  )
| where (Operation =~ "Set-AdminAuditLogConfig" and (tostring(Params.UnifiedAuditLogIngestionEnabled) =~ "False" or tostring(Params.AdminAuditLogEnabled) =~ "False"))
    or (Operation =~ "Set-Mailbox" and tostring(Params.AuditEnabled) =~ "False")
    or (Operation =~ "Set-MailboxAuditBypassAssociation" and tostring(Params.AuditBypassEnabled) =~ "True")
    or (Operation =~ "Set-OrganizationConfig" and tostring(Params.AuditDisabled) =~ "True")
| project TimeGenerated, Actor = UserId, ClientIP, Operation, Target = tostring(Params.Identity), Parameters
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Operation) == "Set-Mailbox" and tostring(Target) == "ceo@contoso.com"), Include2 = countif(tostring(Operation) == "Set-MailboxAuditBypassAssociation"), Exclude1 = countif(tostring(Actor) == "admin2@contoso.com")
| extend Test = "m365-audit-logging-disabled", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
