// Test: dcsync-replication-by-non-dc
// Rule: Directory replication requested by an account that isn't a domain controller (DCSync) (detections/dcsync-replication-by-non-dc.yaml)
// A user account requesting replication rights fires; a domain controller and the MSOL sync account don't.
// Generated by tools/build_tests.py from tests/cases/dcsync-replication-by-non-dc.yaml. Do not edit by hand.
let SecurityEvent = datatable(AgoSeconds:long, EventID:int, Computer:string, Account:string, SubjectUserName:string, SubjectUserSid:string, TargetUserName:string, TargetSid:string, MemberName:string, IpAddress:string, ServiceName:string, TicketEncryptionType:string, Properties:string, AccessMask:string) [
    900, 4662, "dc01.contoso.local", "", "mallory", "S-1-5-21-1-2-3-1201", "", "", "", "", "", "", "%%7688 {1131f6ad-9c07-11d1-f79f-00c04fc2dcd2} {19195a5b-6da0-11d0-afd3-00c04fd930c9}", "0x100",
    900, 4662, "dc01.contoso.local", "", "DC02$", "S-1-5-21-1-2-3-1001", "", "", "", "", "", "", "%%7688 {1131f6ad-9c07-11d1-f79f-00c04fc2dcd2}", "0x100",
    900, 4662, "dc01.contoso.local", "", "MSOL_a1b2c3d4e5f6", "S-1-5-21-1-2-3-1301", "", "", "", "", "", "", "%%7688 {1131f6aa-9c07-11d1-f79f-00c04fc2dcd2}", "0x100"
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let ReplicationRights = dynamic(["1131f6aa-9c07-11d1-f79f-00c04fc2dcd2", "1131f6ad-9c07-11d1-f79f-00c04fc2dcd2",
    "89e95b76-444d-4c62-991a-0facbeda640c"]);
SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4662 and AccessMask == "0x100"
| extend Guids = extract_all(@"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", tolower(Properties))
| where array_length(set_intersect(Guids, ReplicationRights)) > 0
| where SubjectUserName !endswith "$" and SubjectUserName !startswith "MSOL_"
| summarize FirstSeen = min(TimeGenerated), Requests = count(), DomainControllers = make_set(Computer, 5) by SubjectUserName, SubjectUserSid
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(SubjectUserName) == "mallory"), Exclude1 = countif(tostring(SubjectUserName) == "DC02$"), Exclude2 = countif(tostring(SubjectUserName) == "MSOL_a1b2c3d4e5f6")
| extend Test = "dcsync-replication-by-non-dc", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
