// All tests in one query: paste into Azure Data Explorer and run. One PASS/FAIL row per test.
// Generated by tools/build_tests.py. Do not edit by hand.
// Test: ad-reconnaissance-tools
// Rule: Active Directory reconnaissance (AdFind, SharpHound or several discovery commands) (detections/ad-reconnaissance-tools.yaml)
// Three kinds of discovery commands from one account and AdFind fire; a single "net user /domain" doesn't.
// Generated by tools/build_tests.py from tests/cases/ad-reconnaissance-tools.yaml. Do not edit by hand.
let Test_ad_reconnaissance_tools = () {
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    1800, "fin-ws-07", "carol", "nltest.exe", "", "nltest.exe /domain_trusts /all_trusts", "", "", "cmd.exe", "", "",
    1740, "fin-ws-07", "carol", "net.exe", "", "net.exe group \"domain admins\" /domain", "", "", "cmd.exe", "", "",
    1680, "fin-ws-07", "carol", "net.exe", "", "net.exe user /domain", "", "", "cmd.exe", "", "",
    1200, "srv-app-02", "svc-sql", "af.exe", "", "af.exe -f \"(objectcategory=computer)\" -csv name", "AdFind.exe", "", "cmd.exe", "", "",
    1200, "it-ws-01", "helpdesk1", "net.exe", "", "net.exe user bob /domain", "", "", "cmd.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| extend Recon = case(
    FileName =~ "adfind.exe" or ProcessVersionInfoOriginalFileName =~ "adfind.exe", "AdFind",
    ProcessCommandLine matches regex @"(?i)sharphound|invoke-bloodhound|--collectionmethods?\s", "SharpHound",
    FileName =~ "nltest.exe" and ProcessCommandLine matches regex @"(?i)/(domain_trusts|dclist|all_trusts|dsgetdc)", "nltest trusts or DCs",
    FileName in~ ("net.exe", "net1.exe") and ProcessCommandLine matches regex @"(?i)group\s+""?(domain admins|enterprise admins|schema admins)", "net group admins",
    FileName in~ ("net.exe", "net1.exe") and ProcessCommandLine matches regex @"(?i)\b(user|group|accounts)\b.*\s/do(m|main)?\b", "net domain query",
    FileName =~ "dsquery.exe", "dsquery",
    ProcessCommandLine matches regex @"(?i)get-ad(user|computer|group|domaintrust|trust)\b.*-filter\s+\*", "Get-AD* -Filter *",
    "")
| where isnotempty(Recon)
| summarize Techniques = make_set(Recon), Commands = make_set(ProcessCommandLine, 10), FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated) by DeviceName, AccountName
| where set_has_element(Techniques, "AdFind") or set_has_element(Techniques, "SharpHound") or array_length(Techniques) >= 3
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07" and tostring(AccountName) == "carol"), Include2 = countif(tostring(DeviceName) == "srv-app-02"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01")
| extend Test = "ad-reconnaissance-tools", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: aitm-session-token-replay
// Rule: Same sign-in session used from two countries (possible AiTM token theft) (detections/aitm-session-token-replay.yaml)
// One session used from the US and the Netherlands fires; a session from two US IPs and a failed foreign attempt don't.
// Generated by tools/build_tests.py from tests/cases/aitm-session-token-replay.yaml. Do not edit by hand.
let Test_aitm_session_token_replay = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    5400, "alice@contoso.com", "", "198.51.100.66", "NL", "0", "", "OfficeHome", "", "", "", "", "", "", "", "s-alice-1", "",
    3600, "bob@contoso.com", "", "203.0.113.40", "US", "0", "", "OfficeHome", "", "", "", "", "", "", "", "s-bob-1", "",
    3600, "carol@contoso.com", "", "203.0.113.41", "US", "0", "", "OfficeHome", "", "", "", "", "", "", "", "s-carol-1", "",
    3000, "carol@contoso.com", "", "198.51.100.67", "RU", "50126", "", "OfficeHome", "", "", "", "", "", "", "", "s-carol-1", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let AADNonInteractiveUserSignInLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    4800, "Alice@contoso.com", "", "203.0.113.42", "US", "0", "", "Microsoft Teams", "", "", "", "", "", "", "", "s-alice-1", "",
    1800, "bob@contoso.com", "", "203.0.113.43", "US", "0", "", "Microsoft Teams", "", "", "", "", "", "", "", "s-bob-1", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
union
    (SigninLogs | where TimeGenerated > ago(2h) | extend SignInType = "Interactive"),
    (AADNonInteractiveUserSignInLogs | where TimeGenerated > ago(2h) | extend SignInType = "NonInteractive")
| where ResultType == "0" and isnotempty(SessionId) and isnotempty(Location)
| summarize Countries = make_set(Location, 10), IPs = make_set(IPAddress, 20), Apps = make_set(AppDisplayName, 10),
    SignInTypes = make_set(SignInType), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by UserPrincipalName = tolower(UserPrincipalName), SessionId
| extend CountryCount = array_length(Countries)
| where CountryCount > 1
| project FirstSeen, LastSeen, UserPrincipalName, SessionId, CountryCount, Countries, IPs, Apps, SignInTypes
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tolong(CountryCount) == 2), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "aitm-session-token-replay", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: amsi-bypass-attempt
// Rule: AMSI bypass strings in a command line (detections/amsi-bypass-attempt.yaml)
// The amsiInitFailed reflection bypass fires; an ordinary PowerShell command doesn't.
// Generated by tools/build_tests.py from tests/cases/amsi-bypass-attempt.yaml. Do not edit by hand.
let Test_amsi_bypass_attempt = () {
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fin-ws-07", "mallory", "powershell.exe", "", "powershell.exe -c \"[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true)\"", "", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "powershell.exe", "", "powershell.exe Get-Process | Sort-Object CPU", "", "", "explorer.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where ProcessCommandLine matches regex @"(?i)amsiutils|amsiinitfailed|amsiscanbuffer|amsicontext|amsiopensession"
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01")
| extend Test = "amsi-bypass-attempt", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
