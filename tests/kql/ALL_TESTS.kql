    1200, "AttachUserPolicy", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.126", "", "", "", "{\"userName\":\"mallory\",\"policyArn\":\"arn:aws:iam::aws:policy/AdministratorAccess\"}", "", "",
    1200, "PutRolePolicy", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.126", "", "", "", "{\"roleName\":\"lambda-exec\",\"policyName\":\"debug\",\"policyDocument\":\"{\\\"Version\\\":\\\"2012-10-17\\\",\\\"Statement\\\":[{\\\"Effect\\\":\\\"Allow\\\",\\\"Action\\\":\\\"*\\\",\\\"Resource\\\":\\\"*\\\"}]}\"}", "", "",
    1200, "PutUserPolicy", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/alice", "", "", "123456789012", "203.0.113.126", "", "", "", "{\"userName\":\"reports\",\"policyName\":\"read-reports\",\"policyDocument\":\"{\\\"Version\\\":\\\"2012-10-17\\\",\\\"Statement\\\":{\\\"Effect\\\":\\\"Allow\\\",\\\"Action\\\":[\\\"s3:GetObject\\\"],\\\"Resource\\\":\\\"arn:aws:s3:::reports/*\\\"}}\"}", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Managed = AWSCloudTrail
    | where TimeGenerated > ago(1h)
    | where EventName in ("AttachUserPolicy", "AttachRolePolicy", "AttachGroupPolicy") and isempty(ErrorCode)
    | where RequestParameters contains "arn:aws:iam::aws:policy/AdministratorAccess"
    | extend Grant = "AdministratorAccess managed policy";
let Inline = AWSCloudTrail
    | where TimeGenerated > ago(1h)
    | where EventName in ("PutUserPolicy", "PutRolePolicy", "PutGroupPolicy", "CreatePolicy", "CreatePolicyVersion") and isempty(ErrorCode)
    | extend Doc = parse_json(tostring(parse_json(RequestParameters).policyDocument))
    | mv-expand Statement = iff(gettype(Doc.Statement) == "array", Doc.Statement, pack_array(Doc.Statement))
    | where tostring(Statement.Effect) == "Allow"
    | where tostring(Statement.Action) == "*" or tostring(Statement.Action) contains '"*"'
    | where tostring(Statement.Resource) == "*" or tostring(Statement.Resource) contains '"*"'
    | extend Grant = "Policy allowing * on *"
    | project-away Doc, Statement;
union Managed, Inline
| extend P = parse_json(RequestParameters)
| extend Target = coalesce(tostring(P.userName), tostring(P.roleName), tostring(P.groupName), tostring(P.policyName), tostring(P.policyArn))
| summarize FirstSeen = min(TimeGenerated) by EventName, Grant, Target, UserIdentityArn, SourceIpAddress, RecipientAccountId
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(EventName) == "AttachUserPolicy" and tostring(Target) == "mallory"), Include2 = countif(tostring(EventName) == "PutRolePolicy" and tostring(Target) == "lambda-exec"), Exclude1 = countif(tostring(Target) == "reports")
| extend Test = "aws-admin-policy-granted", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
