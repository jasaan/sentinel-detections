// Test: aws-access-key-created-for-other-user
// Rule: AWS access key created for a different IAM user (detections/aws-access-key-created-for-other-user.yaml)
// Creating a key for another user fires; creating your own key doesn't.
// Generated by tools/build_tests.py from tests/cases/aws-access-key-created-for-other-user.yaml. Do not edit by hand.
let Test_aws_access_key_created_for_other_user = () {
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    1200, "CreateAccessKey", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/mallory", "mallory", "", "123456789012", "198.51.100.123", "", "", "", "{\"userName\":\"backup-svc\"}", "", "",
    1200, "CreateAccessKey", "iam.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/alice", "alice", "", "123456789012", "203.0.113.123", "", "", "", "{}", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where EventName == "CreateAccessKey" and isempty(ErrorCode)
| extend TargetUser = tostring(parse_json(RequestParameters).userName),
    CallerName = iff(isnotempty(UserIdentityUserName), UserIdentityUserName, extract(@"[^/]+$", 0, UserIdentityArn))
| where isnotempty(TargetUser) and TargetUser != CallerName
| project TimeGenerated, UserIdentityArn, CallerName, TargetUser, SourceIpAddress, RecipientAccountId, UserAgent
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(CallerName) == "mallory" and tostring(TargetUser) == "backup-svc"), Exclude1 = countif(tostring(CallerName) == "alice")
| extend Test = "aws-access-key-created-for-other-user", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
