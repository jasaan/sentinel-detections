// Test: ediscovery-export-or-purge
// Rule: Compliance search exported or used to purge mail (detections/ediscovery-export-or-purge.yaml)
// An export and a hard-delete purge fire; a preview action doesn't.
// Generated by tools/build_tests.py from tests/cases/ediscovery-export-or-purge.yaml. Do not edit by hand.
let OfficeActivity = datatable(AgoSeconds:long, Operation:string, RecordType:string, UserId:string, ClientIP:string, OfficeWorkload:string, Parameters:string, SourceFileName:string, Site_Url:string, ResultStatus:string, MailboxOwnerUPN:string, TargetUserOrGroupName:string, TargetUserOrGroupType:string) [
    600, "New-ComplianceSearchAction", "", "mallory@contoso.com", "198.51.100.29", "SecurityComplianceCenter", "[{\"Name\":\"SearchName\",\"Value\":\"all-exec-mail\"},{\"Name\":\"Export\",\"Value\":\"True\"}]", "", "", "", "", "", "",
    600, "New-ComplianceSearchAction", "", "mallory@contoso.com", "198.51.100.29", "SecurityComplianceCenter", "[{\"Name\":\"SearchName\",\"Value\":\"security-alerts\"},{\"Name\":\"Purge\",\"Value\":\"True\"},{\"Name\":\"PurgeType\",\"Value\":\"HardDelete\"}]", "", "", "", "", "", "",
    600, "New-ComplianceSearchAction", "", "legal1@contoso.com", "203.0.113.29", "SecurityComplianceCenter", "[{\"Name\":\"SearchName\",\"Value\":\"case-123\"},{\"Name\":\"Preview\",\"Value\":\"True\"}]", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
OfficeActivity
| where TimeGenerated > ago(1h)
| where Operation =~ "New-ComplianceSearchAction"
| mv-apply P = todynamic(Parameters) on (
    summarize Params = make_bag(bag_pack(tostring(P.Name), tostring(P.Value)))
  )
| extend Action = case(isnotnull(Params.Purge), "Purge", isnotnull(Params.Export), "Export", "Other")
| where Action != "Other"
| project TimeGenerated, Actor = UserId, ClientIP, Action, SearchName = tostring(Params.SearchName),
    PurgeType = tostring(Params.PurgeType), Parameters
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Action) == "Export" and tostring(SearchName) == "all-exec-mail"), Include2 = countif(tostring(Action) == "Purge" and tostring(PurgeType) == "HardDelete"), Exclude1 = countif(tostring(Actor) == "legal1@contoso.com")
| extend Test = "ediscovery-export-or-purge", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
