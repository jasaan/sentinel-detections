// Test: aws-root-account-used
// Rule: AWS root user activity (detections/aws-root-account-used.yaml)
// A root console login fires; IAM user activity and a service event on root's behalf don't.
// Generated by tools/build_tests.py from tests/cases/aws-root-account-used.yaml. Do not edit by hand.
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    1200, "ConsoleLogin", "signin.amazonaws.com", "AwsConsoleSignIn", "Root", "arn:aws:iam::123456789012:root", "", "", "123456789012", "198.51.100.120", "", "", "", "", "", "",
    1200, "ListBuckets", "s3.amazonaws.com", "AwsApiCall", "IAMUser", "arn:aws:iam::123456789012:user/alice", "alice", "", "123456789012", "203.0.113.120", "", "", "", "", "", "",
    1200, "SharedSnapshotCopyInitiated", "ec2.amazonaws.com", "AwsServiceEvent", "Root", "", "", "", "123456789012", "ec2.amazonaws.com", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where UserIdentityType == "Root" and EventTypeName != "AwsServiceEvent"
| summarize FirstSeen = min(TimeGenerated), Events = count(), EventNames = make_set(EventName, 30), UserAgents = make_set(UserAgent, 5)
    by RecipientAccountId, SourceIpAddress
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(SourceIpAddress) == "198.51.100.120"), Exclude1 = countif(tostring(SourceIpAddress) == "203.0.113.120"), Exclude2 = countif(tostring(SourceIpAddress) == "ec2.amazonaws.com")
| extend Test = "aws-root-account-used", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
