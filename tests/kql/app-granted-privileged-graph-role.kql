// Test: app-granted-privileged-graph-role
// Rule: Application granted a high-privilege Microsoft Graph application permission (detections/app-granted-privileged-graph-role.yaml)
// Granting RoleManagement.ReadWrite.Directory fires; granting User.Read.All doesn't.
// Generated by tools/build_tests.py from tests/cases/app-granted-privileged-graph-role.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Add app role assignment to service principal", "ApplicationManagement", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com", "ipAddress": "198.51.100.30"}}), dynamic([{"displayName": "Microsoft Graph", "modifiedProperties": [{"displayName": "AppRole.Value", "newValue": "\"RoleManagement.ReadWrite.Directory\""}, {"displayName": "ServicePrincipal.DisplayName", "newValue": "\"BackupSync\""}, {"displayName": "ServicePrincipal.AppId", "newValue": "\"11111111-aaaa-bbbb-cccc-000000000001\""}]}]), dynamic(null),
    600, "Add app role assignment to service principal", "ApplicationManagement", "success", "", dynamic({"user": {"userPrincipalName": "admin2@contoso.com", "ipAddress": "203.0.113.30"}}), dynamic([{"displayName": "Microsoft Graph", "modifiedProperties": [{"displayName": "AppRole.Value", "newValue": "\"User.Read.All\""}, {"displayName": "ServicePrincipal.DisplayName", "newValue": "\"HRConnector\""}]}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let PrivilegedAppRoles = dynamic(["RoleManagement.ReadWrite.Directory", "AppRoleAssignment.ReadWrite.All",
    "Application.ReadWrite.All", "Directory.ReadWrite.All", "Domain.ReadWrite.All", "Policy.ReadWrite.ConditionalAccess",
    "PrivilegedAccess.ReadWrite.AzureADGroup", "User.ReadWrite.All", "Group.ReadWrite.All", "Mail.ReadWrite",
    "Mail.Send", "Mail.Read", "full_access_as_app", "Files.ReadWrite.All", "Sites.FullControl.All", "Sites.ReadWrite.All"]);
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName == "Add app role assignment to service principal" and Result =~ "success"
| mv-apply Prop = TargetResources[0].modifiedProperties on (
    summarize Props = make_bag(bag_pack(tostring(Prop.displayName), trim(@'"', tostring(Prop.newValue))))
  )
| extend AppRole = tostring(Props["AppRole.Value"]), ClientApp = tostring(Props["ServicePrincipal.DisplayName"]),
    ClientAppId = tostring(Props["ServicePrincipal.AppId"]),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| where AppRole in (PrivilegedAppRoles)
| project TimeGenerated, ClientApp, ClientAppId, AppRole, ResourceApp = tostring(TargetResources[0].displayName), Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(ClientApp) == "BackupSync" and tostring(AppRole) == "RoleManagement.ReadWrite.Directory" and tostring(Actor) == "admin1@contoso.com"), Exclude1 = countif(tostring(ClientApp) == "HRConnector")
| extend Test = "app-granted-privileged-graph-role", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
