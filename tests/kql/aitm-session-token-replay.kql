// Test: aitm-session-token-replay
// Rule: Same sign-in session used from two countries (possible AiTM token theft) (detections/aitm-session-token-replay.yaml)
// One session used from the US and the Netherlands fires; a session from two US IPs and a failed foreign attempt don't.
// Generated by tools/build_tests.py from tests/cases/aitm-session-token-replay.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    5400, "alice@contoso.com", "", "198.51.100.66", "NL", "0", "", "OfficeHome", "", "", "", "", "", "", "", "s-alice-1", "",
    3600, "bob@contoso.com", "", "203.0.113.40", "US", "0", "", "OfficeHome", "", "", "", "", "", "", "", "s-bob-1", "",
    3600, "carol@contoso.com", "", "203.0.113.41", "US", "0", "", "OfficeHome", "", "", "", "", "", "", "", "s-carol-1", "",
    3000, "carol@contoso.com", "", "198.51.100.67", "RU", "50126", "", "OfficeHome", "", "", "", "", "", "", "", "s-carol-1", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let AADNonInteractiveUserSignInLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    4800, "Alice@contoso.com", "", "203.0.113.42", "US", "0", "", "Microsoft Teams", "", "", "", "", "", "", "", "s-alice-1", "",
    1800, "bob@contoso.com", "", "203.0.113.43", "US", "0", "", "Microsoft Teams", "", "", "", "", "", "", "", "s-bob-1", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
union
    (SigninLogs | where TimeGenerated > ago(2h) | extend SignInType = "Interactive"),
    (AADNonInteractiveUserSignInLogs | where TimeGenerated > ago(2h) | extend SignInType = "NonInteractive")
| where ResultType == "0" and isnotempty(SessionId) and isnotempty(Location)
| summarize Countries = make_set(Location, 10), IPs = make_set(IPAddress, 20), Apps = make_set(AppDisplayName, 10),
    SignInTypes = make_set(SignInType), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by UserPrincipalName = tolower(UserPrincipalName), SessionId
| extend CountryCount = array_length(Countries)
| where CountryCount > 1
| project FirstSeen, LastSeen, UserPrincipalName, SessionId, CountryCount, Countries, IPs, Apps, SignInTypes
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tolong(CountryCount) == 2), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "aitm-session-token-replay", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
