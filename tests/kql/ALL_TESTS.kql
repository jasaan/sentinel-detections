    10800, "fin-ws-07", "carol", "invoice_viewer.exe", "C:\\Users\\carol\\Downloads\\invoice_viewer.exe", "", "", "bbbb000000000000000000000000000000000000000000000000000000000001", "explorer.exe", "", "",
    10800, "ws-1", "user1", "Update.exe", "C:\\Users\\u\\AppData\\Local\\Vendor\\Update.exe", "", "", "bbbb000000000000000000000000000000000000000000000000000000000002", "svchost.exe", "", "",
    10800, "ws-2", "user2", "Update.exe", "C:\\Users\\u\\AppData\\Local\\Vendor\\Update.exe", "", "", "bbbb000000000000000000000000000000000000000000000000000000000002", "svchost.exe", "", "",
    10800, "ws-3", "user3", "Update.exe", "C:\\Users\\u\\AppData\\Local\\Vendor\\Update.exe", "", "", "bbbb000000000000000000000000000000000000000000000000000000000002", "svchost.exe", "", "",
    10800, "ws-4", "user4", "Update.exe", "C:\\Users\\u\\AppData\\Local\\Vendor\\Update.exe", "", "", "bbbb000000000000000000000000000000000000000000000000000000000002", "svchost.exe", "", "",
    10800, "ws-5", "user5", "Update.exe", "C:\\Users\\u\\AppData\\Local\\Vendor\\Update.exe", "", "", "bbbb000000000000000000000000000000000000000000000000000000000002", "svchost.exe", "", "",
    10800, "it-ws-01", "alice", "rare.exe", "C:\\Windows\\System32\\rare.exe", "", "", "bbbb000000000000000000000000000000000000000000000000000000000003", "services.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Prevalence = DeviceProcessEvents
    | where TimeGenerated > ago(7d)
    | where isnotempty(SHA256)
    | summarize DeviceCount = dcount(DeviceName) by SHA256;
DeviceProcessEvents
| where TimeGenerated > ago(1d)
| where isnotempty(SHA256)
| where FolderPath matches regex @"(?i)\\(appdata|temp|downloads|users\\public|programdata|perflogs)\\"
| summarize FirstSeen = min(TimeGenerated), Executions = count(), Devices = make_set(DeviceName, 5), Paths = make_set(FolderPath, 5),
    Parents = make_set(InitiatingProcessFileName, 5) by SHA256, FileName
| join kind=inner Prevalence on SHA256
| where DeviceCount <= 2
| project FirstSeen, FileName, SHA256, DeviceCount, Executions, Devices, Paths, Parents
| order by DeviceCount asc, FirstSeen desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(FileName) == "invoice_viewer.exe" and tolong(DeviceCount) == 1), Exclude1 = countif(tostring(FileName) == "Update.exe"), Exclude2 = countif(tostring(FileName) == "rare.exe")
| extend Test = "hunt-rare-binary-user-writable-path", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
