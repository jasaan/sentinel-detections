// Test: risky-signin-single-factor
// Rule: High-risk sign-in succeeded with a password only (detections/risky-signin-single-factor.yaml)
// A high-risk password-only sign-in fires; a high-risk sign-in with MFA and a low-risk password-only one don't.
// Generated by tools/build_tests.py from tests/cases/risky-signin-single-factor.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    600, "alice@contoso.com", "", "198.51.100.5", "RO", "0", "", "", "", "", "", "", "", "singleFactorAuthentication", "high", "", "",
    600, "bob@contoso.com", "", "198.51.100.6", "RO", "0", "", "", "", "", "", "", "", "multiFactorAuthentication", "high", "", "",
    600, "carol@contoso.com", "", "203.0.113.7", "US", "0", "", "", "", "", "", "", "", "singleFactorAuthentication", "low", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType == "0" and RiskLevelDuringSignIn =~ "high" and AuthenticationRequirement =~ "singleFactorAuthentication"
| project TimeGenerated, UserPrincipalName, IPAddress, Location, AppDisplayName, ClientAppUsed, UserAgent, ConditionalAccessStatus
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "risky-signin-single-factor", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
