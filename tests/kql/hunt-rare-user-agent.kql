// Test: hunt-rare-user-agent
// Rule: Successful sign-ins with rarely seen user agents (hunting/hunt-rare-user-agent.yaml)
// A python-requests sign-in seen once is listed; a common browser agent isn't.
// Generated by tools/build_tests.py from tests/cases/hunt-rare-user-agent.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    10800, "alice@contoso.com", "", "198.51.100.160", "US", "0", "", "", "", "python-requests/2.31.0", "", "", "", "", "", "", "",
    1728000, "user1@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1724400, "user2@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1720800, "user3@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1717200, "user4@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1713600, "user5@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1710000, "user6@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1706400, "user7@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1702800, "user8@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1699200, "user9@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    1695600, "user10@contoso.com", "", "203.0.113.70", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", "",
    7200, "bob@contoso.com", "", "203.0.113.71", "US", "0", "", "", "", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let maxSeen = 3;
let AgentCounts = SigninLogs
    | where TimeGenerated > ago(30d) and ResultType == "0"
    | summarize TimesSeen = count(), UsersWithAgent = dcount(UserPrincipalName) by UserAgent;
SigninLogs
| where TimeGenerated > ago(1d) and ResultType == "0"
| join kind=inner (AgentCounts | where TimesSeen <= maxSeen) on UserAgent
| project TimeGenerated, UserPrincipalName, UserAgent, TimesSeen, UsersWithAgent, IPAddress, Location, AppDisplayName
| order by TimesSeen asc, TimeGenerated desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tostring(UserAgent) == "python-requests/2.31.0"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com")
| extend Test = "hunt-rare-user-agent", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
