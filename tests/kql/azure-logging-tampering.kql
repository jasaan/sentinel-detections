// Test: azure-logging-tampering
// Rule: Azure diagnostic settings, Log Analytics workspace or Sentinel rules deleted (detections/azure-logging-tampering.yaml)
// Deleting a diagnostic setting and a Sentinel rule fires once for the caller; a failed delete and a diagnostic-setting write don't.
// Generated by tools/build_tests.py from tests/cases/azure-logging-tampering.yaml. Do not edit by hand.
let AzureActivity = datatable(AgoSeconds:long, OperationNameValue:string, ActivityStatusValue:string, Caller:string, CallerIpAddress:string, SubscriptionId:string, ResourceGroup:string, _ResourceId:string, Properties_d:dynamic) [
    1200, "MICROSOFT.INSIGHTS/DIAGNOSTICSETTINGS/DELETE", "Success", "mallory@contoso.com", "198.51.100.100", "sub-1", "", "/subscriptions/sub-1/resourceGroups/prod/providers/Microsoft.KeyVault/vaults/kv1/providers/microsoft.insights/diagnosticSettings/to-sentinel", dynamic(null),
    900, "Microsoft.SecurityInsights/alertRules/delete", "Succeeded", "mallory@contoso.com", "198.51.100.100", "sub-1", "", "/subscriptions/sub-1/resourceGroups/soc/providers/Microsoft.OperationalInsights/workspaces/sentinel/providers/Microsoft.SecurityInsights/alertRules/r1", dynamic(null),
    900, "MICROSOFT.INSIGHTS/DIAGNOSTICSETTINGS/DELETE", "Failure", "bob@contoso.com", "203.0.113.100", "sub-1", "", "/subscriptions/sub-1/x", dynamic(null),
    900, "MICROSOFT.INSIGHTS/DIAGNOSTICSETTINGS/WRITE", "Success", "carol@contoso.com", "203.0.113.101", "sub-1", "", "/subscriptions/sub-1/y", dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let TamperOps = dynamic(["MICROSOFT.INSIGHTS/DIAGNOSTICSETTINGS/DELETE", "MICROSOFT.OPERATIONALINSIGHTS/WORKSPACES/DELETE",
    "MICROSOFT.OPERATIONALINSIGHTS/WORKSPACES/DATASOURCES/DELETE", "MICROSOFT.OPERATIONALINSIGHTS/WORKSPACES/DATACOLLECTIONRULES/DELETE",
    "MICROSOFT.INSIGHTS/DATACOLLECTIONRULES/DELETE", "MICROSOFT.INSIGHTS/DATACOLLECTIONRULEASSOCIATIONS/DELETE",
    "MICROSOFT.SECURITYINSIGHTS/ALERTRULES/DELETE", "MICROSOFT.SECURITYINSIGHTS/DATACONNECTORS/DELETE",
    "MICROSOFT.SECURITYINSIGHTS/AUTOMATIONRULES/DELETE"]);
AzureActivity
| where TimeGenerated > ago(1h)
| where OperationNameValue in~ (TamperOps) and ActivityStatusValue in~ ("Success", "Succeeded")
| summarize FirstSeen = min(TimeGenerated), Operations = make_set(OperationNameValue), Resources = make_set(_ResourceId, 20)
    by Caller, CallerIpAddress, SubscriptionId
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Caller) == "mallory@contoso.com"), Exclude1 = countif(tostring(Caller) == "bob@contoso.com"), Exclude2 = countif(tostring(Caller) == "carol@contoso.com")
| extend Test = "azure-logging-tampering", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
