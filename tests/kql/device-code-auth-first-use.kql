// Test: device-code-auth-first-use
// Rule: Device code sign-in by a user who doesn't normally use it (detections/device-code-auth-first-use.yaml)
// A first-ever device code sign-in fires; a user with device-code history, a failed attempt and a normal sign-in don't.
// Generated by tools/build_tests.py from tests/cases/device-code-auth-first-use.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    1200, "alice@contoso.com", "", "198.51.100.90", "US", "0", "", "Microsoft Office", "Microsoft Graph", "", "", "deviceCode", "", "", "", "", "",
    259200, "bob@contoso.com", "", "203.0.113.60", "US", "0", "", "", "", "", "", "deviceCode", "", "", "", "", "",
    1200, "bob@contoso.com", "", "203.0.113.60", "US", "0", "", "", "", "", "", "deviceCode", "", "", "", "", "",
    1200, "carol@contoso.com", "", "198.51.100.91", "US", "50199", "", "", "", "", "", "deviceCode", "", "", "", "", "",
    1200, "dave@contoso.com", "", "203.0.113.61", "US", "0", "", "", "", "", "", "none", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let History = SigninLogs
    | where TimeGenerated between (ago(14d) .. ago(1h))
    | where AuthenticationProtocol =~ "deviceCode"
    | distinct UserPrincipalName = tolower(UserPrincipalName);
SigninLogs
| where TimeGenerated > ago(1h)
| where AuthenticationProtocol =~ "deviceCode" and ResultType == "0"
| extend UserPrincipalName = tolower(UserPrincipalName)
| where UserPrincipalName !in (History)
| summarize FirstSignIn = min(TimeGenerated), IPs = make_set(IPAddress, 10), Locations = make_set(Location, 10),
    Apps = make_set(AppDisplayName, 10), Resources = make_set(ResourceDisplayName, 10)
    by UserPrincipalName
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com"), Exclude3 = countif(tostring(UserPrincipalName) == "dave@contoso.com")
| extend Test = "device-code-auth-first-use", Expected = "1 row(s); 1 must appear; 3 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0 and Exclude3 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
