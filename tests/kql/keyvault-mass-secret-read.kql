    1200, "MICROSOFT.KEYVAULT", "AuditEvent", "SecretGet", "KV-PROD-01", "Forbidden", "198.51.100.70", "bob@contoso.com", "", "https://kv-prod-01.vault.azure.net/secrets/secret-29",
    1200, "MICROSOFT.KEYVAULT", "AuditEvent", "SecretGet", "KV-PROD-01", "Forbidden", "198.51.100.70", "bob@contoso.com", "", "https://kv-prod-01.vault.azure.net/secrets/secret-30"
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let threshold = 25;
AzureDiagnostics
| where TimeGenerated > ago(1h)
| where ResourceProvider == "MICROSOFT.KEYVAULT" and Category == "AuditEvent"
| where OperationName in ("SecretGet", "KeyGet", "CertificateGet")
| where ResultSignature == "OK"
| extend Caller = coalesce(identity_claim_upn_s, identity_claim_appid_g)
| summarize ItemsRead = dcount(id_s), Reads = count(), Vaults = make_set(Resource, 20),
    CallerIPs = make_set(CallerIPAddress, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by Caller
| where ItemsRead >= threshold
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Caller) == "mallory@contoso.com" and tolong(ItemsRead) == 30), Exclude1 = countif(tostring(Caller) == "bob@contoso.com")
| extend Test = "keyvault-mass-secret-read", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
