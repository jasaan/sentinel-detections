// Test: federation-domain-change
// Rule: Domain federation settings changed in Entra ID (detections/federation-domain-change.yaml)
// Setting a domain's authentication to federated fires; adding a verified domain doesn't.
// Generated by tools/build_tests.py from tests/cases/federation-domain-change.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Set domain authentication", "DirectoryManagement", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com", "ipAddress": "198.51.100.200"}}), dynamic([{"displayName": "contoso.com"}]), dynamic(null),
    600, "Add verified domain", "DirectoryManagement", "success", "", dynamic({"user": {"userPrincipalName": "admin2@contoso.com", "ipAddress": "203.0.113.200"}}), dynamic([{"displayName": "fabrikam.contoso.com"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName in ("Set domain authentication", "Set federation settings on domain") and Result =~ "success"
| extend Domain = tostring(TargetResources[0].displayName),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, OperationName, Domain, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Domain) == "contoso.com" and tostring(Actor) == "admin1@contoso.com"), Exclude1 = countif(tostring(Actor) == "admin2@contoso.com")
| extend Test = "federation-domain-change", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
