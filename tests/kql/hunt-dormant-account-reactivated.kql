// Test: hunt-dormant-account-reactivated
// Rule: Dormant account signs in again (hunting/hunt-dormant-account-reactivated.yaml)
// An account silent for 45 days that signs in again is listed; a recently active account isn't.
// Generated by tools/build_tests.py from tests/cases/hunt-dormant-account-reactivated.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, UserAgent:string, ConditionalAccessStatus:string, AuthenticationRequirement:string) [
    3888000, "alice@contoso.com", "", "203.0.113.40", "US", "0", "", "", "", "", "",
    7200, "alice@contoso.com", "", "198.51.100.140", "BR", "0", "", "", "", "", "",
    259200, "bob@contoso.com", "", "203.0.113.41", "US", "0", "", "", "", "", "",
    7200, "bob@contoso.com", "", "203.0.113.41", "US", "0", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let dormancy = 30d;
let Recent = SigninLogs
    | where TimeGenerated > ago(1d) and ResultType == "0"
    | summarize ReturnedAt = min(TimeGenerated), IPs = make_set(IPAddress, 10), Countries = make_set(Location, 10) by UserPrincipalName;
let Previous = SigninLogs
    | where TimeGenerated between (ago(90d) .. ago(1d)) and ResultType == "0"
    | summarize LastSeenBefore = max(TimeGenerated) by UserPrincipalName;
Recent
| join kind=inner Previous on UserPrincipalName
| where ReturnedAt - LastSeenBefore > dormancy
| extend DaysDormant = datetime_diff("day", ReturnedAt, LastSeenBefore)
| project UserPrincipalName, DaysDormant, LastSeenBefore, ReturnedAt, IPs, Countries
| order by DaysDormant desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com")
| extend Test = "hunt-dormant-account-reactivated", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
