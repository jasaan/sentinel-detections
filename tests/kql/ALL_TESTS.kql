// Generated by tools/build_tests.py from tests/cases/hunt-mfa-fatigue.yaml. Do not edit by hand.
let Test_hunt_mfa_fatigue = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
