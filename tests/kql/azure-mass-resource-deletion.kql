| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let threshold = 25;
AzureActivity
| where TimeGenerated > ago(1h)
| where OperationNameValue endswith "/DELETE" and ActivityStatusValue in~ ("Success", "Succeeded")
| summarize Deleted = dcount(_ResourceId), ResourceTypes = make_set(tolower(OperationNameValue), 20), Sample = make_set(_ResourceId, 20),
    FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by Caller, CallerIpAddress
| where Deleted >= threshold
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Caller) == "mallory@contoso.com"), Exclude1 = countif(tostring(Caller) == "ops@contoso.com")
| extend Test = "azure-mass-resource-deletion", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
