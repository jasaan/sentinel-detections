// Test: rmm-tool-first-seen
// Rule: Remote access (RMM) tool runs on a device for the first time (detections/rmm-tool-first-seen.yaml)
// AnyDesk appearing on a finance laptop fires; TeamViewer that ran there last week and an unrelated process don't.
// Generated by tools/build_tests.py from tests/cases/rmm-tool-first-seen.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    1200, "fin-ws-07", "carol", "AnyDesk.exe", "C:\\Users\\carol\\Downloads\\AnyDesk.exe", "\"AnyDesk.exe\"", "", "", "explorer.exe", "", "",
    432000, "it-ws-01", "alice", "TeamViewer.exe", "C:\\Program Files\\TeamViewer\\TeamViewer.exe", "\"TeamViewer.exe\"", "", "", "explorer.exe", "", "",
    1200, "it-ws-01", "alice", "TeamViewer.exe", "C:\\Program Files\\TeamViewer\\TeamViewer.exe", "\"TeamViewer.exe\"", "", "", "explorer.exe", "", "",
    1200, "it-ws-02", "bob", "notepad.exe", "C:\\Windows\\System32\\notepad.exe", "notepad.exe", "", "", "explorer.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let ApprovedTools = dynamic(["approved-rmm-agent.exe"]);
let RmmPattern = @"(?i)^(anydesk|screenconnect\..*|connectwisecontrol\..*|atera.*agent|splashtop.*|srservice|teamviewer.*|tv_[wx]64|netsupport.*|client32|rustdesk|meshagent|tacticalrmm|rutserv|rfusclient|supremo.*|zohoassist.*|dwagent|simplehelp.*|remotepc.*|getscreen|ammyy.*|action1_agent|quickassist)\.exe$";
let Known = DeviceProcessEvents
    | where TimeGenerated between (ago(14d) .. ago(1h))
    | where FileName matches regex RmmPattern
    | distinct DeviceName, Tool = tolower(FileName);
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where FileName matches regex RmmPattern
| extend Tool = tolower(FileName)
| where Tool !in (ApprovedTools)
| join kind=leftanti Known on DeviceName, Tool
| summarize FirstSeen = min(TimeGenerated), AccountName = take_any(AccountName), FolderPath = take_any(FolderPath),
    Parents = make_set(InitiatingProcessFileName, 5), CommandLines = make_set(ProcessCommandLine, 5) by DeviceName, Tool
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07" and tostring(Tool) == "anydesk.exe"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01"), Exclude2 = countif(tostring(DeviceName) == "it-ws-02")
| extend Test = "rmm-tool-first-seen", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
