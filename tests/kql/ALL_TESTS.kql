// Rule: S3 bucket made public or its public access block removed (detections/aws-s3-bucket-made-public.yaml)
// A Principal "*" policy and a deleted public access block fire; a policy for one account and the allow-listed website bucket don't.
// Generated by tools/build_tests.py from tests/cases/aws-s3-bucket-made-public.yaml. Do not edit by hand.
let Test_aws_s3_bucket_made_public = () {
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    1200, "PutBucketPolicy", "s3.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.127", "", "", "", "{\"bucketName\":\"finance-exports\",\"bucketPolicy\":{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":\"s3:GetObject\",\"Resource\":\"arn:aws:s3:::finance-exports/*\"}]}}", "", "",
    1200, "DeleteBucketPublicAccessBlock", "s3.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.127", "", "", "", "{\"bucketName\":\"hr-archive\",\"publicAccessBlock\":\"\"}", "", "",
    1200, "PutBucketPolicy", "s3.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/alice", "", "", "123456789012", "203.0.113.127", "", "", "", "{\"bucketName\":\"shared-logs\",\"bucketPolicy\":{\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::210987654321:root\"},\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::shared-logs/*\"}]}}", "", "",
    1200, "PutBucketPolicy", "s3.amazonaws.com", "", "", "arn:aws:iam::123456789012:user/web", "", "", "123456789012", "203.0.113.128", "", "", "", "{\"bucketName\":\"www.contoso.example\",\"bucketPolicy\":{\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":\"s3:GetObject\",\"Resource\":\"arn:aws:s3:::www.contoso.example/*\"}]}}", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let PublicBuckets = dynamic(["www.contoso.example"]);
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where EventSource == "s3.amazonaws.com" and isempty(ErrorCode)
| extend Bucket = tostring(parse_json(RequestParameters).bucketName)
| where Bucket !in (PublicBuckets)
| extend Change = case(
    EventName == "PutBucketAcl" and RequestParameters matches regex @"(?i)AllUsers|AuthenticatedUsers|public-read", "Public ACL",
    EventName == "PutBucketPolicy" and RequestParameters matches regex @"""Principal""\s*:\s*(""\*""|\{\s*""AWS""\s*:\s*""\*""\s*\})"
        and RequestParameters contains '"Allow"', "Public bucket policy",
    EventName in ("DeleteBucketPublicAccessBlock", "DeleteAccountPublicAccessBlock"), "Public access block deleted",
    EventName in ("PutBucketPublicAccessBlock", "PutAccountPublicAccessBlock")
        and RequestParameters matches regex @"""(BlockPublicAcls|IgnorePublicAcls|BlockPublicPolicy|RestrictPublicBuckets)""\s*:\s*false", "Public access block weakened",
    "")
| where isnotempty(Change)
| project TimeGenerated, Bucket, Change, EventName, UserIdentityArn, SourceIpAddress, RecipientAccountId, RequestParameters
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Bucket) == "finance-exports" and tostring(Change) == "Public bucket policy"), Include2 = countif(tostring(Bucket) == "hr-archive" and tostring(Change) == "Public access block deleted"), Exclude1 = countif(tostring(Bucket) == "shared-logs"), Exclude2 = countif(tostring(Bucket) == "www.contoso.example")
| extend Test = "aws-s3-bucket-made-public", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
