// Test: mfa-method-added-new-country
// Rule: New MFA method followed by sign-in from a new country (detections/mfa-method-added-new-country.yaml)
// New MFA method then a sign-in from a never-seen country fires; known-country sign-ins and sign-ins without a registration don't.
// Generated by tools/build_tests.py from tests/cases/mfa-method-added-new-country.yaml. Do not edit by hand.
let Test_mfa_method_added_new_country = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    432000, "alice@contoso.com", "", "203.0.113.30", "US", "0", "", "", "", "", "", "", "", "", "", "", "",
    259200, "alice@contoso.com", "", "203.0.113.30", "US", "0", "", "", "", "", "", "", "", "", "", "", "",
    1800, "Alice@contoso.com", "", "198.51.100.150", "NG", "0", "", "Office 365 Exchange Online", "", "", "", "", "", "", "", "", "",
    345600, "bob@contoso.com", "", "203.0.113.31", "US", "0", "", "", "", "", "", "", "", "", "", "", "",
    1800, "bob@contoso.com", "", "203.0.113.31", "US", "0", "", "", "", "", "", "", "", "", "", "", "",
    1800, "carol@contoso.com", "", "198.51.100.151", "FR", "0", "", "", "", "", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    3000, "User registered security info", "UserManagement", "success", "", dynamic(null), dynamic([{"userPrincipalName": "alice@contoso.com"}]), dynamic(null),
    3000, "User registered security info", "UserManagement", "success", "", dynamic(null), dynamic([{"userPrincipalName": "bob@contoso.com"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Registrations = AuditLogs
    | where TimeGenerated > ago(2h)
    | where OperationName in ("User registered security info", "User changed default security info") and Result =~ "success"
    | extend UserPrincipalName = tolower(tostring(TargetResources[0].userPrincipalName))
    | project UserPrincipalName, RegisteredAt = TimeGenerated, Registration = OperationName;
let History = SigninLogs
    | where TimeGenerated between (ago(14d) .. ago(2h))
    | where ResultType == "0"
    | summarize KnownCountries = make_set(Location) by UserPrincipalName = tolower(UserPrincipalName);
SigninLogs
| where TimeGenerated > ago(2h)
| where ResultType == "0"
| extend UserPrincipalName = tolower(UserPrincipalName)
| join kind=inner Registrations on UserPrincipalName
| where TimeGenerated between (RegisteredAt .. (RegisteredAt + 1h))
| join kind=leftouter History on UserPrincipalName
| extend KnownCountries = iff(isnull(KnownCountries), dynamic([]), KnownCountries)
| where not(set_has_element(KnownCountries, Location))
| summarize FirstSignIn = min(TimeGenerated), IPs = make_set(IPAddress, 10), Apps = make_set(AppDisplayName, 10)
    by UserPrincipalName, Location, RegisteredAt, Registration, KnownCountries = tostring(KnownCountries)
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tostring(Location) == "NG"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "mfa-method-added-new-country", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: named-location-change
// Rule: Conditional Access named location added, changed or deleted (detections/named-location-change.yaml)
// Updating a named location to a trusted range fires and flags IsTrusted; updating a CA policy doesn't.
// Generated by tools/build_tests.py from tests/cases/named-location-change.yaml. Do not edit by hand.
let Test_named_location_change = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Update named location", "Policy", "success", "", dynamic({"user": {"userPrincipalName": "admin1@contoso.com", "ipAddress": "198.51.100.32"}}), dynamic([{"displayName": "HQ Egress", "modifiedProperties": [{"displayName": "NamedLocation", "newValue": "{\"isTrusted\":true,\"ipRanges\":[{\"cidrAddress\":\"198.51.100.0/24\"}]}"}]}]), dynamic(null),
    600, "Update conditional access policy", "Policy", "success", "", dynamic({"user": {"userPrincipalName": "admin2@contoso.com"}}), dynamic([{"displayName": "Require MFA"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName in ("Add named location", "Update named location", "Delete named location") and Result =~ "success"
| extend Location = tostring(TargetResources[0].displayName),
    NewValue = tostring(TargetResources[0].modifiedProperties[0].newValue),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| extend IsTrusted = NewValue contains '"isTrusted":true'
| project TimeGenerated, OperationName, Location, IsTrusted, NewValue, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Location) == "HQ Egress" and tobool(IsTrusted) == true), Exclude1 = countif(tostring(Actor) == "admin2@contoso.com")
| extend Test = "named-location-change", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: nsg-management-port-open-to-internet
// Rule: Network security group rule opens RDP, SSH or WinRM to the internet (detections/nsg-management-port-open-to-internet.yaml)
// Opening 3389 to * fires; opening 443 to the internet and 22 to a single office IP don't.
// Generated by tools/build_tests.py from tests/cases/nsg-management-port-open-to-internet.yaml. Do not edit by hand.
let Test_nsg_management_port_open_to_internet = () {
let AzureActivity = datatable(AgoSeconds:long, OperationNameValue:string, ActivityStatusValue:string, Caller:string, CallerIpAddress:string, SubscriptionId:string, ResourceGroup:string, _ResourceId:string, Properties_d:dynamic) [
    1200, "MICROSOFT.NETWORK/NETWORKSECURITYGROUPS/SECURITYRULES/WRITE", "Start", "alice@contoso.com", "198.51.100.108", "sub-1", "", "/subscriptions/sub-1/resourceGroups/prod/providers/Microsoft.Network/networkSecurityGroups/nsg1/securityRules/allow-rdp", dynamic({"requestbody": "{\"name\":\"allow-rdp\",\"properties\":{\"access\":\"Allow\",\"direction\":\"Inbound\",\"protocol\":\"Tcp\",\"sourceAddressPrefix\":\"*\",\"destinationPortRange\":\"3389\",\"priority\":100}}"}),
    1200, "MICROSOFT.NETWORK/NETWORKSECURITYGROUPS/SECURITYRULES/WRITE", "Start", "bob@contoso.com", "203.0.113.108", "sub-1", "", "/subscriptions/sub-1/resourceGroups/prod/providers/Microsoft.Network/networkSecurityGroups/nsg1/securityRules/allow-https", dynamic({"requestbody": "{\"name\":\"allow-https\",\"properties\":{\"access\":\"Allow\",\"direction\":\"Inbound\",\"protocol\":\"Tcp\",\"sourceAddressPrefix\":\"Internet\",\"destinationPortRange\":\"443\",\"priority\":110}}"}),
    1200, "MICROSOFT.NETWORK/NETWORKSECURITYGROUPS/SECURITYRULES/WRITE", "Start", "carol@contoso.com", "203.0.113.109", "sub-1", "", "/subscriptions/sub-1/resourceGroups/prod/providers/Microsoft.Network/networkSecurityGroups/nsg1/securityRules/allow-ssh-office", dynamic({"requestbody": "{\"name\":\"allow-ssh-office\",\"properties\":{\"access\":\"Allow\",\"direction\":\"Inbound\",\"protocol\":\"Tcp\",\"sourceAddressPrefix\":\"203.0.113.5/32\",\"destinationPortRange\":\"22\",\"priority\":120}}"})
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AzureActivity
| where TimeGenerated > ago(1h)
| where OperationNameValue in~ ("MICROSOFT.NETWORK/NETWORKSECURITYGROUPS/SECURITYRULES/WRITE", "MICROSOFT.NETWORK/NETWORKSECURITYGROUPS/WRITE")
| where ActivityStatusValue !in~ ("Failure", "Failed")
| extend Body = parse_json(tostring(Properties_d.requestbody))
| mv-expand Rule = iff(isnotnull(Body.properties.securityRules), Body.properties.securityRules, pack_array(Body))
| extend R = Rule.properties
| extend Source = strcat(tostring(R.sourceAddressPrefix), ",", strcat_array(R.sourceAddressPrefixes, ",")),
    Ports = strcat(tostring(R.destinationPortRange), ",", strcat_array(R.destinationPortRanges, ","))
| where tostring(R.access) =~ "Allow" and tostring(R.direction) =~ "Inbound"
| where Source matches regex @"(?i)(^|,)\s*(\*|0\.0\.0\.0/0|internet|any)\s*(,|$)"
| where Ports matches regex @"(^|,)\s*(\*|22|3389|5985|5986)\s*(,|$)"
| summarize FirstSeen = min(TimeGenerated) by Caller, CallerIpAddress, RuleId = _ResourceId, RuleName = tostring(Rule.name), Source, Ports
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Caller) == "alice@contoso.com" and tostring(RuleName) == "allow-rdp"), Exclude1 = countif(tostring(Caller) == "bob@contoso.com"), Exclude2 = countif(tostring(Caller) == "carol@contoso.com")
| extend Test = "nsg-management-port-open-to-internet", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
