// Test: suspicious-service-created
// Rule: Service created that runs a shell, script or binary from a user-writable folder (detections/suspicious-service-created.yaml)
// A remote service running cmd /c powershell fires and shows the target; a normal Program Files service doesn't.
// Generated by tools/build_tests.py from tests/cases/suspicious-service-created.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "it-ws-05", "mallory", "sc.exe", "", "sc.exe \\\\fs01 create WinUpd binPath= \"cmd.exe /c powershell -nop -w hidden -f C:\\Users\\Public\\u.ps1\" start= auto", "", "", "cmd.exe", "", "",
    600, "srv-app-02", "installer", "sc.exe", "", "sc.exe create AgentSvc binPath= \"C:\\Program Files\\Agent\\agent.exe\" start= auto", "", "", "msiexec.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where FileName =~ "sc.exe" and ProcessCommandLine matches regex @"(?i)\screate\s"
| where ProcessCommandLine matches regex @"(?i)binpath=\s*.*(cmd(\.exe)?\s+/c|powershell|pwsh|mshta|rundll32|regsvr32|%comspec%|\\(appdata|temp|users\\public|programdata|perflogs)\\|\\\\127\.0\.0\.1\\)"
| extend RemoteTarget = extract(@"(?i)sc(\.exe)?\s+(\\\\[^\s]+)\s+create", 2, ProcessCommandLine)
| project TimeGenerated, DeviceName, AccountName, RemoteTarget, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "it-ws-05" and tostring(RemoteTarget) == "\\\\fs01"), Exclude1 = countif(tostring(DeviceName) == "srv-app-02")
| extend Test = "suspicious-service-created", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
