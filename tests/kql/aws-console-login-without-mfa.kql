// Test: aws-console-login-without-mfa
// Rule: AWS console sign-in by an IAM user without MFA (detections/aws-console-login-without-mfa.yaml)
// A password-only IAM console login fires; an MFA login and a failed login don't.
// Generated by tools/build_tests.py from tests/cases/aws-console-login-without-mfa.yaml. Do not edit by hand.
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    1200, "ConsoleLogin", "signin.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/dev1", "dev1", "", "123456789012", "198.51.100.124", "", "", "", "", "{\"ConsoleLogin\":\"Success\"}", "{\"LoginTo\":\"https://console.aws.amazon.com\",\"MobileVersion\":\"No\",\"MFAUsed\":\"No\"}",
    1200, "ConsoleLogin", "signin.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/dev2", "dev2", "", "123456789012", "203.0.113.124", "", "", "", "", "{\"ConsoleLogin\":\"Success\"}", "{\"MFAUsed\":\"Yes\"}",
    1200, "ConsoleLogin", "signin.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/dev3", "dev3", "", "123456789012", "198.51.100.125", "", "", "Failed authentication", "", "{\"ConsoleLogin\":\"Failure\"}", "{\"MFAUsed\":\"No\"}"
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where EventName == "ConsoleLogin" and ResponseElements contains '"ConsoleLogin":"Success"'
| where UserIdentityType in ("IAMUser", "Root")
| where AdditionalEventData contains '"MFAUsed":"No"'
| extend User = iff(isnotempty(UserIdentityUserName), UserIdentityUserName, UserIdentityArn)
| project TimeGenerated, User, UserIdentityArn, SourceIpAddress, UserAgent, RecipientAccountId
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(User) == "dev1"), Exclude1 = countif(tostring(User) == "dev2"), Exclude2 = countif(tostring(User) == "dev3")
| extend Test = "aws-console-login-without-mfa", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
