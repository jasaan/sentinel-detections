| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let threshold = 200;
OfficeActivity
| where TimeGenerated > ago(1h)
| where OfficeWorkload in ("SharePoint", "OneDrive") and Operation in ("FileDownloaded", "FileSyncDownloadedFull")
| summarize FilesDownloaded = dcount(SourceFileName), Sites = make_set(Site_Url, 10), ClientIPs = make_set(ClientIP, 10),
    FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by UserId
| where FilesDownloaded >= threshold
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserId) == "alice@contoso.com" and tolong(FilesDownloaded) == 210), Exclude1 = countif(tostring(UserId) == "bob@contoso.com"), Exclude2 = countif(tostring(UserId) == "carol@contoso.com")
| extend Test = "mass-file-download", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: mfa-method-added-new-country
// Rule: New MFA method followed by sign-in from a new country (detections/mfa-method-added-new-country.yaml)
// New MFA method then a sign-in from a never-seen country fires; known-country sign-ins and sign-ins without a registration don't.
// Generated by tools/build_tests.py from tests/cases/mfa-method-added-new-country.yaml. Do not edit by hand.
let Test_mfa_method_added_new_country = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, UserAgent:string, ConditionalAccessStatus:string, AuthenticationRequirement:string) [
    432000, "alice@contoso.com", "", "203.0.113.30", "US", "0", "", "", "", "", "",
    259200, "alice@contoso.com", "", "203.0.113.30", "US", "0", "", "", "", "", "",
    1800, "Alice@contoso.com", "", "198.51.100.150", "NG", "0", "", "Office 365 Exchange Online", "", "", "",
    345600, "bob@contoso.com", "", "203.0.113.31", "US", "0", "", "", "", "", "",
    1800, "bob@contoso.com", "", "203.0.113.31", "US", "0", "", "", "", "", "",
    1800, "carol@contoso.com", "", "198.51.100.151", "FR", "0", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    3000, "User registered security info", "UserManagement", "success", dynamic(null), dynamic([{"userPrincipalName": "alice@contoso.com"}]), dynamic(null),
    3000, "User registered security info", "UserManagement", "success", dynamic(null), dynamic([{"userPrincipalName": "bob@contoso.com"}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let Registrations = AuditLogs
    | where TimeGenerated > ago(2h)
    | where OperationName in ("User registered security info", "User changed default security info") and Result =~ "success"
    | extend UserPrincipalName = tolower(tostring(TargetResources[0].userPrincipalName))
    | project UserPrincipalName, RegisteredAt = TimeGenerated, Registration = OperationName;
let History = SigninLogs
    | where TimeGenerated between (ago(14d) .. ago(2h))
    | where ResultType == "0"
    | summarize KnownCountries = make_set(Location) by UserPrincipalName = tolower(UserPrincipalName);
SigninLogs
| where TimeGenerated > ago(2h)
| where ResultType == "0"
| extend UserPrincipalName = tolower(UserPrincipalName)
| join kind=inner Registrations on UserPrincipalName
| where TimeGenerated between (RegisteredAt .. (RegisteredAt + 1h))
| join kind=leftouter History on UserPrincipalName
| extend KnownCountries = iff(isnull(KnownCountries), dynamic([]), KnownCountries)
| where not(set_has_element(KnownCountries, Location))
| summarize FirstSignIn = min(TimeGenerated), IPs = make_set(IPAddress, 10), Apps = make_set(AppDisplayName, 10)
    by UserPrincipalName, Location, RegisteredAt, Registration, KnownCountries = tostring(KnownCountries)
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tostring(Location) == "NG"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "mfa-method-added-new-country", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: oauth-high-risk-consent
// Rule: Consent granted to an app with high-risk permissions (detections/oauth-high-risk-consent.yaml)
// Consent including mail scopes fires; consent to basic sign-in scopes doesn't; failed consent doesn't.
// Generated by tools/build_tests.py from tests/cases/oauth-high-risk-consent.yaml. Do not edit by hand.
let Test_oauth_high_risk_consent = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Consent to application", "", "success", dynamic({"user": {"userPrincipalName": "alice@contoso.com", "ipAddress": "198.51.100.7"}}), dynamic([{"displayName": "Mail Helper Pro", "id": "aaaaaaaa-0000-0000-0000-000000000001", "modifiedProperties": [{"displayName": "ConsentContext.IsAdminConsent", "oldValue": "", "newValue": "\"False\""}, {"displayName": "ConsentAction.Permissions", "oldValue": "", "newValue": "[] => [[Id: x1, ClientId: aaaaaaaa-0000-0000-0000-000000000001, ConsentType: Principal, Scope:  Mail.Read Mail.Send User.Read offline_access, ]]"}]}]), dynamic(null),
    600, "Consent to application", "", "success", dynamic({"user": {"userPrincipalName": "bob@contoso.com", "ipAddress": "10.0.0.12"}}), dynamic([{"displayName": "Team Polls", "id": "aaaaaaaa-0000-0000-0000-000000000002", "modifiedProperties": [{"displayName": "ConsentAction.Permissions", "oldValue": "", "newValue": "[] => [[Id: x2, ClientId: aaaaaaaa-0000-0000-0000-000000000002, ConsentType: Principal, Scope:  User.Read openid profile, ]]"}]}]), dynamic(null),
    600, "Consent to application", "", "failure", dynamic({"user": {"userPrincipalName": "carol@contoso.com", "ipAddress": "10.0.0.13"}}), dynamic([{"displayName": "Shady Mail App", "id": "aaaaaaaa-0000-0000-0000-000000000003", "modifiedProperties": [{"displayName": "ConsentAction.Permissions", "oldValue": "", "newValue": "[] => [[Scope:  Mail.ReadWrite, ]]"}]}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let HighRiskScopes = dynamic(["Mail.Read", "Mail.ReadWrite", "Mail.Send", "MailboxSettings.ReadWrite",
    "Files.ReadWrite.All", "Sites.ReadWrite.All", "Directory.ReadWrite.All", "User.ReadWrite.All",
    "Application.ReadWrite.All", "RoleManagement.ReadWrite.Directory", "full_access_as_app"]);
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName == "Consent to application" and Result =~ "success"
| mv-apply Prop = TargetResources[0].modifiedProperties on (
    where tostring(Prop.displayName) == "ConsentAction.Permissions"
    | extend Permissions = tostring(Prop.newValue)
  )
| extend RiskyScopes = set_intersect(HighRiskScopes, extract_all(@"([\w\.]+)", Permissions))
| where array_length(RiskyScopes) > 0
| extend AppName = tostring(TargetResources[0].displayName), AppId = tostring(TargetResources[0].id),
    ConsentedBy = tostring(InitiatedBy.user.userPrincipalName), ConsentIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, AppName, AppId, ConsentedBy, ConsentIP, RiskyScopes
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(AppName) == "Mail Helper Pro" and tostring(ConsentedBy) == "alice@contoso.com"), Exclude1 = countif(tostring(AppName) == "Team Polls"), Exclude2 = countif(tostring(AppName) == "Shady Mail App")
| extend Test = "oauth-high-risk-consent", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: shadow-copy-deletion
// Rule: Shadow copy or backup catalog deletion (detections/shadow-copy-deletion.yaml)
// Shadow-copy deletion and disabling recovery fire; listing shadow copies doesn't.
// Generated by tools/build_tests.py from tests/cases/shadow-copy-deletion.yaml. Do not edit by hand.
let Test_shadow_copy_deletion = () {
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, ProcessCommandLine:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string) [
    300, "fin-ws-07", "svc-backup", "vssadmin.exe", "vssadmin.exe delete shadows /all /quiet", "cmd.exe", "",
    300, "fin-ws-07", "svc-backup", "bcdedit.exe", "bcdedit.exe /set {default} recoveryenabled No", "cmd.exe", "",
    300, "it-ws-01", "alice", "vssadmin.exe", "vssadmin.exe list shadows", "powershell.exe", "",
    300, "it-ws-01", "alice", "wmic.exe", "wmic shadowcopy list brief", "cmd.exe", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(15m)
| where (FileName =~ "vssadmin.exe" and ProcessCommandLine has_all ("delete", "shadows"))
    or (FileName =~ "wmic.exe" and ProcessCommandLine has_all ("shadowcopy", "delete"))
    or (FileName =~ "wbadmin.exe" and ProcessCommandLine has_all ("delete", "catalog"))
    or (FileName =~ "bcdedit.exe" and ProcessCommandLine has "recoveryenabled" and ProcessCommandLine has "no")
    or (FileName in~ ("powershell.exe", "pwsh.exe") and ProcessCommandLine has "Win32_ShadowCopy"
        and (ProcessCommandLine contains "Delete" or ProcessCommandLine contains "Remove-"))
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07" and tostring(FileName) == "vssadmin.exe"), Include2 = countif(tostring(DeviceName) == "fin-ws-07" and tostring(FileName) == "bcdedit.exe"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01")
| extend Test = "shadow-copy-deletion", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
union Test_breakglass_signin(), Test_conditional_access_policy_disabled(), Test_entra_password_spray(), Test_global_admin_outside_pim(), Test_hunt_dormant_account_reactivated(), Test_hunt_mfa_fatigue(), Test_hunt_oauth_mail_permissions(), Test_hunt_rare_user_agent(), Test_hunt_service_principal_new_credential(), Test_inbox_rule_external_forward(), Test_keyvault_mass_secret_read(), Test_mass_file_download(), Test_mfa_method_added_new_country(), Test_oauth_high_risk_consent(), Test_shadow_copy_deletion()
| order by Test asc
