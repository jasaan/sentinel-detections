| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceLogonEvents
| where TimeGenerated > ago(1h)
| where RemoteIPType == "Public"
| summarize Failures = countif(ActionType == "LogonFailed"), Successes = countif(ActionType == "LogonSuccess"),
    Accounts = make_set(AccountName, 20), SuccessAccounts = make_set_if(AccountName, ActionType == "LogonSuccess", 5),
    LogonTypes = make_set(LogonType), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by DeviceName, RemoteIP
| where Failures >= 20
| extend Compromised = Successes > 0
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "srv-rdp-01" and tolong(Failures) == 25 and tobool(Compromised) == true), Exclude1 = countif(tostring(DeviceName) == "srv-app-02")
| extend Test = "internet-logon-brute-force", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
