// Test: hunt-first-time-admin-tooling
// Rule: First use of Azure or Graph command-line tools by a user (hunting/hunt-first-time-admin-tooling.yaml)
// A first Graph CLI sign-in shows up; a regular Azure CLI user doesn't.
// Generated by tools/build_tests.py from tests/cases/hunt-first-time-admin-tooling.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    7200, "alice@contoso.com", "", "198.51.100.160", "US", "0", "", "Microsoft Graph Command Line Tools", "", "", "", "", "", "", "", "", "",
    864000, "bob@contoso.com", "", "203.0.113.160", "US", "0", "", "Microsoft Azure CLI", "", "", "", "", "", "", "", "", "",
    7200, "bob@contoso.com", "", "203.0.113.160", "US", "0", "", "Microsoft Azure CLI", "", "", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let AdminApps = dynamic(["Microsoft Azure PowerShell", "Microsoft Azure CLI", "Graph Explorer", "Microsoft Graph Command Line Tools",
    "Azure Active Directory PowerShell", "Microsoft Exchange REST API Based Powershell", "Microsoft Intune PowerShell"]);
let Known = SigninLogs
    | where TimeGenerated between (ago(30d) .. ago(1d))
    | where AppDisplayName in (AdminApps)
    | distinct UserPrincipalName = tolower(UserPrincipalName), AppDisplayName;
SigninLogs
| where TimeGenerated > ago(1d)
| where ResultType == "0" and AppDisplayName in (AdminApps)
| extend UserPrincipalName = tolower(UserPrincipalName)
| join kind=leftanti Known on UserPrincipalName, AppDisplayName
| summarize FirstSeen = min(TimeGenerated), SignIns = count(), IPs = make_set(IPAddress, 10), Locations = make_set(Location, 5)
    by UserPrincipalName, AppDisplayName
| order by FirstSeen desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com")
| extend Test = "hunt-first-time-admin-tooling", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
