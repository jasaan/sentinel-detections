    2100, "bob@contoso.com", "", "198.51.100.45", "BR", "50126", "", "", "", "", "", "", "", "", "", "", "",
    2070, "bob@contoso.com", "", "198.51.100.45", "BR", "50126", "", "", "", "", "", "", "", "", "", "", "",
    2400, "carol@contoso.com", "", "203.0.113.46", "US", "50126", "", "", "", "", "", "", "", "", "", "", "",
    2370, "carol@contoso.com", "", "203.0.113.46", "US", "50126", "", "", "", "", "", "", "", "", "", "", "",
    2340, "carol@contoso.com", "", "203.0.113.46", "US", "50126", "", "", "", "", "", "", "", "", "", "", "",
    1200, "carol@contoso.com", "", "203.0.113.46", "US", "0", "", "", "", "", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let FailureCodes = dynamic(["50126", "50053"]);
SigninLogs
| where TimeGenerated > ago(1h)
| extend UserPrincipalName = tolower(UserPrincipalName)
| summarize Failures = countif(ResultType in (FailureCodes)), FirstFailure = minif(TimeGenerated, ResultType in (FailureCodes)),
    Successes = countif(ResultType == "0"), LastSuccess = maxif(TimeGenerated, ResultType == "0"),
    Apps = make_set(AppDisplayName, 10), Location = take_any(Location)
    by UserPrincipalName, IPAddress
| where Failures >= 10 and Successes > 0 and LastSuccess > FirstFailure
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tolong(Failures) == 12), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "brute-force-then-success", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
