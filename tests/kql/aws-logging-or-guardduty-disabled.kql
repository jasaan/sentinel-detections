// Test: aws-logging-or-guardduty-disabled
// Rule: AWS CloudTrail, GuardDuty, Config or flow logs disabled (detections/aws-logging-or-guardduty-disabled.yaml)
// StopLogging and disabling a GuardDuty detector fire; DescribeTrails and a denied StopLogging don't.
// Generated by tools/build_tests.py from tests/cases/aws-logging-or-guardduty-disabled.yaml. Do not edit by hand.
let AWSCloudTrail = datatable(AgoSeconds:long, EventName:string, EventSource:string, EventTypeName:string, UserIdentityType:string, UserIdentityArn:string, UserIdentityUserName:string, UserIdentityAccountId:string, RecipientAccountId:string, SourceIpAddress:string, AWSRegion:string, UserAgent:string, ErrorCode:string, RequestParameters:string, ResponseElements:string, AdditionalEventData:string) [
    1200, "StopLogging", "cloudtrail.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/mallory", "", "", "123456789012", "198.51.100.121", "us-east-1", "", "", "{\"name\":\"org-trail\"}", "", "",
    1200, "UpdateDetector", "guardduty.amazonaws.com", "", "AssumedRole", "arn:aws:sts::123456789012:assumed-role/Admin/eve", "", "", "123456789012", "198.51.100.122", "us-east-1", "", "", "{\"detectorId\":\"d1\",\"enable\":false}", "", "",
    1200, "DescribeTrails", "cloudtrail.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/alice", "", "", "123456789012", "203.0.113.121", "us-east-1", "", "", "", "", "",
    1200, "StopLogging", "cloudtrail.amazonaws.com", "", "IAMUser", "arn:aws:iam::123456789012:user/bob", "", "", "123456789012", "203.0.113.122", "us-east-1", "", "AccessDenied", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let TamperEvents = dynamic(["StopLogging", "DeleteTrail", "UpdateTrail", "PutEventSelectors", "DeleteDetector",
    "DisassociateFromAdministratorAccount", "DisassociateFromMasterAccount", "StopMonitoringMembers", "DeleteMembers",
    "DeleteFlowLogs", "DeleteConfigurationRecorder", "StopConfigurationRecorder", "DeleteDeliveryChannel", "DisableSecurityHub"]);
AWSCloudTrail
| where TimeGenerated > ago(1h)
| where isempty(ErrorCode)
| where EventName in (TamperEvents) or (EventName == "UpdateDetector" and RequestParameters contains '"enable":false')
| summarize FirstSeen = min(TimeGenerated), EventNames = make_set(EventName), Regions = make_set(AWSRegion), Requests = make_set(RequestParameters, 5)
    by UserIdentityArn, SourceIpAddress, RecipientAccountId
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserIdentityArn) == "arn:aws:iam::123456789012:user/mallory"), Include2 = countif(tostring(UserIdentityArn) == "arn:aws:sts::123456789012:assumed-role/Admin/eve"), Exclude1 = countif(tostring(UserIdentityArn) == "arn:aws:iam::123456789012:user/alice"), Exclude2 = countif(tostring(UserIdentityArn) == "arn:aws:iam::123456789012:user/bob")
| extend Test = "aws-logging-or-guardduty-disabled", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
