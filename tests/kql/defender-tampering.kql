// Test: defender-tampering
// Rule: Microsoft Defender protections disabled or excluded from the command line (detections/defender-tampering.yaml)
// Disabling real-time monitoring and adding a path exclusion fire; reading preferences and changing the update interval don't.
// Generated by tools/build_tests.py from tests/cases/defender-tampering.yaml. Do not edit by hand.
let DeviceProcessEvents = datatable(AgoSeconds:long, DeviceName:string, AccountName:string, FileName:string, FolderPath:string, ProcessCommandLine:string, ProcessVersionInfoOriginalFileName:string, SHA256:string, InitiatingProcessFileName:string, InitiatingProcessCommandLine:string, InitiatingProcessParentFileName:string) [
    600, "fin-ws-07", "mallory", "powershell.exe", "", "powershell.exe -c Set-MpPreference -DisableRealtimeMonitoring $true", "", "", "cmd.exe", "", "",
    600, "fin-ws-08", "mallory", "powershell.exe", "", "powershell.exe Add-MpPreference -ExclusionPath C:\\Users\\Public", "", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "powershell.exe", "", "powershell.exe Get-MpPreference", "", "", "explorer.exe", "", "",
    600, "it-ws-02", "bob", "powershell.exe", "", "powershell.exe Set-MpPreference -SignatureUpdateInterval 1", "", "", "explorer.exe", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where ProcessCommandLine matches regex @"(?i)set-mppreference.*-disable(realtimemonitoring|behaviormonitoring|ioavprotection|scriptscanning|blockatfirstseen|intrusionpreventionsystem|archivescanning)\s+(\$true|1)"
    or ProcessCommandLine matches regex @"(?i)(add|set)-mppreference.*-exclusion(path|process|extension|ipaddress)"
    or ProcessCommandLine matches regex @"(?i)mpcmdrun(\.exe)?.*-removedefinitions"
    or (FileName =~ "sc.exe" and ProcessCommandLine matches regex @"(?i)\b(stop|delete|config)\b.*\b(windefend|sense|wdboot|wdfilter|wdnissvc)\b")
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(DeviceName) == "fin-ws-07"), Include2 = countif(tostring(DeviceName) == "fin-ws-08"), Exclude1 = countif(tostring(DeviceName) == "it-ws-01"), Exclude2 = countif(tostring(DeviceName) == "it-ws-02")
| extend Test = "defender-tampering", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
