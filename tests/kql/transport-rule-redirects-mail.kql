// Test: transport-rule-redirects-mail
// Rule: Exchange transport rule copies, redirects or deletes mail (detections/transport-rule-redirects-mail.yaml)
// A transport rule that BCCs an outside address fires; a disclaimer rule doesn't.
// Generated by tools/build_tests.py from tests/cases/transport-rule-redirects-mail.yaml. Do not edit by hand.
let OfficeActivity = datatable(AgoSeconds:long, Operation:string, RecordType:string, UserId:string, ClientIP:string, OfficeWorkload:string, Parameters:string, SourceFileName:string, Site_Url:string, ResultStatus:string, MailboxOwnerUPN:string, TargetUserOrGroupName:string, TargetUserOrGroupType:string) [
    900, "New-TransportRule", "", "admin1@contoso.com", "198.51.100.26", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"Compliance copy\"},{\"Name\":\"SentToScope\",\"Value\":\"InOrganization\"},{\"Name\":\"BlindCopyTo\",\"Value\":\"archive@mail.example.net\"}]", "", "", "", "", "", "",
    900, "New-TransportRule", "", "admin2@contoso.com", "203.0.113.26", "Exchange", "[{\"Name\":\"Name\",\"Value\":\"External disclaimer\"},{\"Name\":\"ApplyHtmlDisclaimerText\",\"Value\":\"Sent from Contoso\"}]", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let RiskyActions = dynamic(["BlindCopyTo", "RedirectMessageTo", "AddToRecipients", "CopyTo", "DeleteMessage",
    "RouteMessageOutboundConnector", "ModerateMessageByUser"]);
OfficeActivity
| where TimeGenerated > ago(1h)
| where Operation in~ ("New-TransportRule", "Set-TransportRule")
| mv-apply P = todynamic(Parameters) on (
    summarize Params = make_bag(bag_pack(tostring(P.Name), tostring(P.Value)))
  )
| extend Actions = set_intersect(bag_keys(Params), RiskyActions),
    BypassesSpam = tostring(Params.SetSCL) == "-1"
| where array_length(Actions) > 0 or BypassesSpam
| project TimeGenerated, Actor = UserId, ClientIP, Operation, RuleName = tostring(Params.Name), Actions, BypassesSpam, Parameters
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Actor) == "admin1@contoso.com" and tostring(RuleName) == "Compliance copy"), Exclude1 = countif(tostring(Actor) == "admin2@contoso.com")
| extend Test = "transport-rule-redirects-mail", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
