// Test: azure-vm-run-command
// Rule: VM Run Command used by an account that hasn't used it before (detections/azure-vm-run-command.yaml)
// A first-time Run Command caller fires; a caller who used it last week doesn't.
// Generated by tools/build_tests.py from tests/cases/azure-vm-run-command.yaml. Do not edit by hand.
let AzureActivity = datatable(AgoSeconds:long, OperationNameValue:string, ActivityStatusValue:string, Caller:string, CallerIpAddress:string, SubscriptionId:string, ResourceGroup:string, _ResourceId:string, Properties_d:dynamic) [
    1200, "MICROSOFT.COMPUTE/VIRTUALMACHINES/RUNCOMMAND/ACTION", "Success", "mallory@contoso.com", "198.51.100.105", "sub-1", "", "/subscriptions/sub-1/resourceGroups/prod/providers/Microsoft.Compute/virtualMachines/sql01", dynamic(null),
    1200, "MICROSOFT.COMPUTE/VIRTUALMACHINES/RUNCOMMAND/ACTION", "Success", "mallory@contoso.com", "198.51.100.105", "sub-1", "", "/subscriptions/sub-1/resourceGroups/prod/providers/Microsoft.Compute/virtualMachines/app01", dynamic(null),
    604800, "MICROSOFT.COMPUTE/VIRTUALMACHINES/RUNCOMMAND/ACTION", "Success", "ops-automation@contoso.com", "203.0.113.105", "sub-1", "", "/subscriptions/sub-1/resourceGroups/prod/providers/Microsoft.Compute/virtualMachines/web01", dynamic(null),
    1200, "MICROSOFT.COMPUTE/VIRTUALMACHINES/RUNCOMMAND/ACTION", "Success", "ops-automation@contoso.com", "203.0.113.105", "sub-1", "", "/subscriptions/sub-1/resourceGroups/prod/providers/Microsoft.Compute/virtualMachines/web01", dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let RunCommandOps = dynamic(["MICROSOFT.COMPUTE/VIRTUALMACHINES/RUNCOMMAND/ACTION", "MICROSOFT.COMPUTE/VIRTUALMACHINES/RUNCOMMANDS/WRITE",
    "MICROSOFT.COMPUTE/VIRTUALMACHINESCALESETS/VIRTUALMACHINES/RUNCOMMAND/ACTION", "MICROSOFT.HYBRIDCOMPUTE/MACHINES/RUNCOMMANDS/WRITE"]);
let KnownCallers = AzureActivity
    | where TimeGenerated between (ago(14d) .. ago(1h))
    | where OperationNameValue in~ (RunCommandOps)
    | distinct Caller;
AzureActivity
| where TimeGenerated > ago(1h)
| where OperationNameValue in~ (RunCommandOps) and ActivityStatusValue !in~ ("Failure", "Failed")
| where Caller !in (KnownCallers)
| summarize FirstSeen = min(TimeGenerated), VMs = make_set(_ResourceId, 20), VMCount = dcount(_ResourceId)
    by Caller, CallerIpAddress, SubscriptionId
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Caller) == "mallory@contoso.com" and tolong(VMCount) == 2), Exclude1 = countif(tostring(Caller) == "ops-automation@contoso.com")
| extend Test = "azure-vm-run-command", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
