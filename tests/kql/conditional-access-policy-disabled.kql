// Test: conditional-access-policy-disabled
// Rule: Conditional Access policy deleted or disabled (detections/conditional-access-policy-disabled.yaml)
// Deleting a policy or switching it from enabled to disabled fires; enabling a policy or renaming it doesn't.
// Generated by tools/build_tests.py from tests/cases/conditional-access-policy-disabled.yaml. Do not edit by hand.
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, ResultReason:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Delete conditional access policy", "", "success", "", dynamic({"user": {"userPrincipalName": "mallory@contoso.com", "ipAddress": "198.51.100.99"}}), dynamic([{"displayName": "Require MFA for admins", "modifiedProperties": [{"displayName": "ConditionalAccessPolicy", "oldValue": "{\"id\":\"p1\",\"displayName\":\"Require MFA for admins\",\"state\":\"enabled\"}", "newValue": ""}]}]), dynamic(null),
    600, "Update conditional access policy", "", "success", "", dynamic({"user": {"userPrincipalName": "mallory@contoso.com", "ipAddress": "198.51.100.99"}}), dynamic([{"displayName": "Block legacy authentication", "modifiedProperties": [{"displayName": "ConditionalAccessPolicy", "oldValue": "{\"id\":\"p2\",\"displayName\":\"Block legacy authentication\",\"state\":\"enabled\"}", "newValue": "{\"id\":\"p2\",\"displayName\":\"Block legacy authentication\",\"state\":\"disabled\"}"}]}]), dynamic(null),
    600, "Update conditional access policy", "", "success", "", dynamic({"user": {"userPrincipalName": "alice@contoso.com", "ipAddress": "10.0.0.40"}}), dynamic([{"displayName": "Require compliant device", "modifiedProperties": [{"displayName": "ConditionalAccessPolicy", "oldValue": "{\"id\":\"p3\",\"state\":\"disabled\"}", "newValue": "{\"id\":\"p3\",\"state\":\"enabled\"}"}]}]), dynamic(null),
    600, "Update conditional access policy", "", "success", "", dynamic({"user": {"userPrincipalName": "alice@contoso.com", "ipAddress": "10.0.0.40"}}), dynamic([{"displayName": "MFA for all users (renamed)", "modifiedProperties": [{"displayName": "ConditionalAccessPolicy", "oldValue": "{\"id\":\"p4\",\"displayName\":\"MFA all\",\"state\":\"enabled\"}", "newValue": "{\"id\":\"p4\",\"displayName\":\"MFA for all users (renamed)\",\"state\":\"enabled\"}"}]}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName in ("Delete conditional access policy", "Update conditional access policy") and Result =~ "success"
| extend PolicyName = tostring(TargetResources[0].displayName),
    NewValue = tostring(TargetResources[0].modifiedProperties[0].newValue),
    OldValue = tostring(TargetResources[0].modifiedProperties[0].oldValue)
| extend NewState = extract(@'"state"\s*:\s*"(\w+)"', 1, NewValue), OldState = extract(@'"state"\s*:\s*"(\w+)"', 1, OldValue)
| where OperationName == "Delete conditional access policy"
    or (OldState == "enabled" and NewState in ("disabled", "enabledForReportingButNotEnforced"))
| extend Change = iff(OperationName startswith "Delete", "Deleted", strcat(OldState, " -> ", NewState)),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, PolicyName, Change, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(PolicyName) == "Require MFA for admins" and tostring(Change) == "Deleted"), Include2 = countif(tostring(PolicyName) == "Block legacy authentication" and tostring(Change) == "enabled -> disabled"), Exclude1 = countif(tostring(PolicyName) == "Require compliant device"), Exclude2 = countif(tostring(PolicyName) == "MFA for all users (renamed)")
| extend Test = "conditional-access-policy-disabled", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
