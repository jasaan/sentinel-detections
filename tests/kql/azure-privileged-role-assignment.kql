// Test: azure-privileged-role-assignment
// Rule: Owner or User Access Administrator assigned in Azure RBAC (detections/azure-privileged-role-assignment.yaml)
// An Owner assignment (start and success events) fires once; a Reader assignment and a failed Owner assignment don't.
// Generated by tools/build_tests.py from tests/cases/azure-privileged-role-assignment.yaml. Do not edit by hand.
let AzureActivity = datatable(AgoSeconds:long, OperationNameValue:string, ActivityStatusValue:string, Caller:string, CallerIpAddress:string, SubscriptionId:string, ResourceGroup:string, _ResourceId:string, Properties_d:dynamic) [
    1200, "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE", "Start", "mallory@contoso.com", "198.51.100.101", "sub-1", "", "/subscriptions/sub-1/providers/Microsoft.Authorization/roleAssignments/ra-1", dynamic({"requestbody": "{\"Properties\":{\"RoleDefinitionId\":\"/subscriptions/sub-1/providers/Microsoft.Authorization/roleDefinitions/8e3af657-a8ff-443c-a75c-2fe8c4bcb635\",\"PrincipalId\":\"11111111-2222-3333-4444-555555555555\",\"PrincipalType\":\"ServicePrincipal\",\"Scope\":\"/subscriptions/sub-1\"}}"}),
    1200, "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE", "Success", "mallory@contoso.com", "198.51.100.101", "sub-1", "", "/subscriptions/sub-1/providers/Microsoft.Authorization/roleAssignments/ra-1", dynamic({"responseBody": "{\"properties\":{\"roleDefinitionId\":\"/subscriptions/sub-1/providers/Microsoft.Authorization/roleDefinitions/8e3af657-a8ff-443c-a75c-2fe8c4bcb635\",\"principalId\":\"11111111-2222-3333-4444-555555555555\",\"principalType\":\"ServicePrincipal\"}}"}),
    1200, "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE", "Success", "bob@contoso.com", "203.0.113.102", "sub-1", "", "/subscriptions/sub-1/resourceGroups/app/providers/Microsoft.Authorization/roleAssignments/ra-2", dynamic({"requestbody": "{\"Properties\":{\"RoleDefinitionId\":\"/subscriptions/sub-1/providers/Microsoft.Authorization/roleDefinitions/acdd72a7-3385-48ef-bd42-f606fba81ae7\",\"PrincipalId\":\"22222222-2222-3333-4444-555555555555\",\"PrincipalType\":\"User\"}}"}),
    1200, "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE", "Failure", "carol@contoso.com", "203.0.113.103", "sub-1", "", "/subscriptions/sub-1/providers/Microsoft.Authorization/roleAssignments/ra-3", dynamic({"requestbody": "{\"Properties\":{\"RoleDefinitionId\":\"/subscriptions/sub-1/providers/Microsoft.Authorization/roleDefinitions/8e3af657-a8ff-443c-a75c-2fe8c4bcb635\",\"PrincipalId\":\"33333333-2222-3333-4444-555555555555\",\"PrincipalType\":\"User\"}}"})
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let PrivilegedRoles = datatable(RoleId: string, RoleName: string) [
    "8e3af657-a8ff-443c-a75c-2fe8c4bcb635", "Owner",
    "18d7d88d-d35e-4fb5-a5c3-7773c20a72d9", "User Access Administrator",
    "f58310d9-a9f6-439a-9e8d-f62e7b41a168", "Role Based Access Control Administrator"
];
AzureActivity
| where TimeGenerated > ago(1h)
| where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE"
| where ActivityStatusValue !in~ ("Failure", "Failed")
| extend Body = tostring(Properties_d)
| extend RoleId = tolower(extract(@"roleDefinitions/([0-9a-fA-F\-]{36})", 1, Body)),
    PrincipalId = extract(@"(?i)principalId\\?""?\s*:\s*\\?""([0-9a-fA-F\-]{36})", 1, Body),
    PrincipalType = extract(@"(?i)principalType\\?""?\s*:\s*\\?""(\w+)", 1, Body)
| join kind=inner PrivilegedRoles on RoleId
| summarize FirstSeen = min(TimeGenerated), PrincipalId = take_any(PrincipalId), PrincipalType = take_any(PrincipalType)
    by Caller, CallerIpAddress, RoleName, Scope = _ResourceId
| extend AtSubscriptionOrAbove = Scope !contains "/resourcegroups/"
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Caller) == "mallory@contoso.com" and tostring(RoleName) == "Owner" and tostring(PrincipalType) == "ServicePrincipal" and tobool(AtSubscriptionOrAbove) == true), Exclude1 = countif(tostring(Caller) == "bob@contoso.com"), Exclude2 = countif(tostring(Caller) == "carol@contoso.com")
| extend Test = "azure-privileged-role-assignment", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
