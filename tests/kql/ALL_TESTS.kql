// All tests in one query: paste into Azure Data Explorer and run. One PASS/FAIL row per test.
// Generated by tools/build_tests.py. Do not edit by hand.
// Test: breakglass-signin
// Rule: Break-glass account sign-in attempt (detections/breakglass-signin.yaml)
// Any break-glass sign-in in the last 15 minutes alerts, success or failure; normal users and older events don't.
// Generated by tools/build_tests.py from tests/cases/breakglass-signin.yaml. Do not edit by hand.
let Test_breakglass_signin = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, UserAgent:string, ConditionalAccessStatus:string, AuthenticationRequirement:string) [
    600, "breakglass1@contoso.com", "", "203.0.113.10", "US", "0", "", "Azure Portal", "", "", "",
    300, "BreakGlass2@contoso.com", "", "198.51.100.4", "RO", "50126", "Invalid username or password", "Azure Portal", "", "", "",
    300, "alice@contoso.com", "", "203.0.113.20", "US", "0", "", "", "", "", "",
    7200, "breakglass1@contoso.com", "", "203.0.113.10", "US", "0", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let BreakGlassAccounts = dynamic(["breakglass1@contoso.com", "breakglass2@contoso.com"]);
SigninLogs
| where TimeGenerated > ago(15m)
| where UserPrincipalName in~ (BreakGlassAccounts)
| extend Outcome = iff(ResultType == "0", "Success", "Failure")
| project TimeGenerated, UserPrincipalName, Outcome, ResultType, ResultDescription, IPAddress, Location, AppDisplayName, UserAgent
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "breakglass1@contoso.com" and tostring(Outcome) == "Success"), Include2 = countif(tostring(UserPrincipalName) == "BreakGlass2@contoso.com" and tostring(Outcome) == "Failure"), Exclude1 = countif(tostring(UserPrincipalName) == "alice@contoso.com")
| extend Test = "breakglass-signin", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: conditional-access-policy-disabled
// Rule: Conditional Access policy deleted or disabled (detections/conditional-access-policy-disabled.yaml)
// Deleting a policy or switching it from enabled to disabled fires; enabling a policy or renaming it doesn't.
// Generated by tools/build_tests.py from tests/cases/conditional-access-policy-disabled.yaml. Do not edit by hand.
let Test_conditional_access_policy_disabled = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    600, "Delete conditional access policy", "", "success", dynamic({"user": {"userPrincipalName": "mallory@contoso.com", "ipAddress": "198.51.100.99"}}), dynamic([{"displayName": "Require MFA for admins", "modifiedProperties": [{"displayName": "ConditionalAccessPolicy", "oldValue": "{\"id\":\"p1\",\"displayName\":\"Require MFA for admins\",\"state\":\"enabled\"}", "newValue": ""}]}]), dynamic(null),
    600, "Update conditional access policy", "", "success", dynamic({"user": {"userPrincipalName": "mallory@contoso.com", "ipAddress": "198.51.100.99"}}), dynamic([{"displayName": "Block legacy authentication", "modifiedProperties": [{"displayName": "ConditionalAccessPolicy", "oldValue": "{\"id\":\"p2\",\"displayName\":\"Block legacy authentication\",\"state\":\"enabled\"}", "newValue": "{\"id\":\"p2\",\"displayName\":\"Block legacy authentication\",\"state\":\"disabled\"}"}]}]), dynamic(null),
    600, "Update conditional access policy", "", "success", dynamic({"user": {"userPrincipalName": "alice@contoso.com", "ipAddress": "10.0.0.40"}}), dynamic([{"displayName": "Require compliant device", "modifiedProperties": [{"displayName": "ConditionalAccessPolicy", "oldValue": "{\"id\":\"p3\",\"state\":\"disabled\"}", "newValue": "{\"id\":\"p3\",\"state\":\"enabled\"}"}]}]), dynamic(null),
    600, "Update conditional access policy", "", "success", dynamic({"user": {"userPrincipalName": "alice@contoso.com", "ipAddress": "10.0.0.40"}}), dynamic([{"displayName": "MFA for all users (renamed)", "modifiedProperties": [{"displayName": "ConditionalAccessPolicy", "oldValue": "{\"id\":\"p4\",\"displayName\":\"MFA all\",\"state\":\"enabled\"}", "newValue": "{\"id\":\"p4\",\"displayName\":\"MFA for all users (renamed)\",\"state\":\"enabled\"}"}]}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName in ("Delete conditional access policy", "Update conditional access policy") and Result =~ "success"
| extend PolicyName = tostring(TargetResources[0].displayName),
    NewValue = tostring(TargetResources[0].modifiedProperties[0].newValue),
    OldValue = tostring(TargetResources[0].modifiedProperties[0].oldValue)
| extend NewState = extract(@'"state"\s*:\s*"(\w+)"', 1, NewValue), OldState = extract(@'"state"\s*:\s*"(\w+)"', 1, OldValue)
| where OperationName == "Delete conditional access policy"
    or (OldState == "enabled" and NewState in ("disabled", "enabledForReportingButNotEnforced"))
| extend Change = iff(OperationName startswith "Delete", "Deleted", strcat(OldState, " -> ", NewState)),
    Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress)
| project TimeGenerated, PolicyName, Change, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(PolicyName) == "Require MFA for admins" and tostring(Change) == "Deleted"), Include2 = countif(tostring(PolicyName) == "Block legacy authentication" and tostring(Change) == "enabled -> disabled"), Exclude1 = countif(tostring(PolicyName) == "Require compliant device"), Exclude2 = countif(tostring(PolicyName) == "MFA for all users (renamed)")
| extend Test = "conditional-access-policy-disabled", Expected = "2 row(s); 2 must appear; 2 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: entra-password-spray
// Rule: Password spray against Entra ID from a single IP (detections/entra-password-spray.yaml)
// One IP failing against 12 users fires and reports the one success; an IP with 4 failures doesn't.
// Generated by tools/build_tests.py from tests/cases/entra-password-spray.yaml. Do not edit by hand.
let Test_entra_password_spray = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, UserAgent:string, ConditionalAccessStatus:string, AuthenticationRequirement:string) [
    1800, "user1@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user2@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user3@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user4@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user5@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user6@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user7@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user8@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user9@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user10@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user11@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1800, "user12@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "",
    1500, "user3@contoso.com", "", "203.0.113.50", "", "0", "", "Office 365 Exchange Online", "", "", "",
    1800, "temp1@contoso.com", "", "198.51.100.20", "", "50126", "", "", "", "", "",
    1800, "temp2@contoso.com", "", "198.51.100.20", "", "50126", "", "", "", "", "",
    1800, "temp3@contoso.com", "", "198.51.100.20", "", "50126", "", "", "", "", "",
    1800, "temp4@contoso.com", "", "198.51.100.20", "", "50126", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let minUsers = 10;
let Window = SigninLogs | where TimeGenerated > ago(1h);
Window
| where ResultType in ("50126", "50053")
| summarize TargetedUsers = dcount(UserPrincipalName), FailedAttempts = count(), SampleUsers = make_set(UserPrincipalName, 25),
    Apps = make_set(AppDisplayName, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by IPAddress
| where TargetedUsers >= minUsers
| join kind=leftouter (
    Window | where ResultType == "0" | summarize SuccessfulUsers = make_set(UserPrincipalName, 25) by IPAddress
  ) on IPAddress
| extend SuccessCount = coalesce(array_length(SuccessfulUsers), 0)
| project IPAddress, TargetedUsers, FailedAttempts, SuccessCount, SuccessfulUsers, SampleUsers, Apps, FirstSeen, LastSeen
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(IPAddress) == "203.0.113.50" and tolong(TargetedUsers) == 12 and tolong(SuccessCount) == 1), Exclude1 = countif(tostring(IPAddress) == "198.51.100.20")
| extend Test = "entra-password-spray", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: global-admin-outside-pim
// Rule: Privileged Entra role assigned outside PIM (detections/global-admin-outside-pim.yaml)
// A direct Global Administrator assignment fires; PIM activations, PIM-initiated adds and non-privileged roles don't.
// Generated by tools/build_tests.py from tests/cases/global-admin-outside-pim.yaml. Do not edit by hand.
let Test_global_admin_outside_pim = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    1200, "Add member to role", "", "success", dynamic({"user": {"userPrincipalName": "mallory@contoso.com", "ipAddress": "198.51.100.99"}}), dynamic([{"userPrincipalName": "mallory.backup@contoso.com", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "", "newValue": "\"Global Administrator\""}]}]), dynamic(null),
    1200, "Add member to role completed (PIM activation)", "", "success", dynamic({"app": {"displayName": "MS-PIM"}}), dynamic([{"userPrincipalName": "alice@contoso.com", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "", "newValue": "\"Global Administrator\""}]}]), dynamic(null),
    1200, "Add member to role", "", "success", dynamic({"app": {"displayName": "MS-PIM"}}), dynamic([{"userPrincipalName": "bob@contoso.com", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "", "newValue": "\"Global Administrator\""}]}]), dynamic(null),
    1200, "Add member to role", "", "success", dynamic({"user": {"userPrincipalName": "helpdesk@contoso.com", "ipAddress": "10.0.0.30"}}), dynamic([{"userPrincipalName": "carol@contoso.com", "modifiedProperties": [{"displayName": "Role.DisplayName", "oldValue": "", "newValue": "\"Reports Reader\""}]}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let PrivilegedRoles = dynamic(["Global Administrator", "Privileged Role Administrator", "Privileged Authentication Administrator",
    "Security Administrator", "Exchange Administrator", "Application Administrator"]);
AuditLogs
| where TimeGenerated > ago(1h)
| where OperationName == "Add member to role" and Result =~ "success"
| mv-apply Prop = TargetResources[0].modifiedProperties on (
    where tostring(Prop.displayName) == "Role.DisplayName"
    | extend RoleName = trim(@'"', tostring(Prop.newValue))
  )
| where RoleName in (PrivilegedRoles)
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
    ActorIP = tostring(InitiatedBy.user.ipAddress), TargetUser = tostring(TargetResources[0].userPrincipalName)
| where Actor !startswith "MS-PIM"
| project TimeGenerated, RoleName, TargetUser, Actor, ActorIP
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(TargetUser) == "mallory.backup@contoso.com" and tostring(RoleName) == "Global Administrator" and tostring(Actor) == "mallory@contoso.com"), Exclude1 = countif(tostring(TargetUser) == "alice@contoso.com"), Exclude2 = countif(tostring(TargetUser) == "bob@contoso.com"), Exclude3 = countif(tostring(TargetUser) == "carol@contoso.com")
| extend Test = "global-admin-outside-pim", Expected = "1 row(s); 1 must appear; 3 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0 and Exclude3 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: hunt-dormant-account-reactivated
// Rule: Dormant account signs in again (hunting/hunt-dormant-account-reactivated.yaml)
// An account silent for 45 days that signs in again is listed; a recently active account isn't.
// Generated by tools/build_tests.py from tests/cases/hunt-dormant-account-reactivated.yaml. Do not edit by hand.
let Test_hunt_dormant_account_reactivated = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, UserAgent:string, ConditionalAccessStatus:string, AuthenticationRequirement:string) [
    3888000, "alice@contoso.com", "", "203.0.113.40", "US", "0", "", "", "", "", "",
    7200, "alice@contoso.com", "", "198.51.100.140", "BR", "0", "", "", "", "", "",
    259200, "bob@contoso.com", "", "203.0.113.41", "US", "0", "", "", "", "", "",
    7200, "bob@contoso.com", "", "203.0.113.41", "US", "0", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let dormancy = 30d;
let Recent = SigninLogs
    | where TimeGenerated > ago(1d) and ResultType == "0"
    | summarize ReturnedAt = min(TimeGenerated), IPs = make_set(IPAddress, 10), Countries = make_set(Location, 10) by UserPrincipalName;
let Previous = SigninLogs
    | where TimeGenerated between (ago(90d) .. ago(1d)) and ResultType == "0"
    | summarize LastSeenBefore = max(TimeGenerated) by UserPrincipalName;
Recent
| join kind=inner Previous on UserPrincipalName
| where ReturnedAt - LastSeenBefore > dormancy
| extend DaysDormant = datetime_diff("day", ReturnedAt, LastSeenBefore)
| project UserPrincipalName, DaysDormant, LastSeenBefore, ReturnedAt, IPs, Countries
| order by DaysDormant desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com")
| extend Test = "hunt-dormant-account-reactivated", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: hunt-mfa-fatigue
// Rule: MFA fatigue (repeated push denials) (hunting/hunt-mfa-fatigue.yaml)
// A burst of 7 MFA denials followed by a success is flagged (SuccessAfterDenials); 6 denials without success is listed; 2 denials isn't.
// Generated by tools/build_tests.py from tests/cases/hunt-mfa-fatigue.yaml. Do not edit by hand.
let Test_hunt_mfa_fatigue = () {
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, UserAgent:string, ConditionalAccessStatus:string, AuthenticationRequirement:string) [
    10800, "alice@contoso.com", "", "198.51.100.120", "", "500121", "", "", "", "", "",
    10795, "alice@contoso.com", "", "198.51.100.120", "", "500121", "", "", "", "", "",
    10790, "alice@contoso.com", "", "198.51.100.120", "", "500121", "", "", "", "", "",
    10785, "alice@contoso.com", "", "198.51.100.120", "", "500121", "", "", "", "", "",
    10780, "alice@contoso.com", "", "198.51.100.120", "", "500121", "", "", "", "", "",
    10775, "alice@contoso.com", "", "198.51.100.120", "", "500121", "", "", "", "", "",
    10770, "alice@contoso.com", "", "198.51.100.120", "", "500121", "", "", "", "", "",
    10200, "alice@contoso.com", "", "198.51.100.120", "", "0", "", "", "", "", "",
    18000, "bob@contoso.com", "", "198.51.100.121", "", "500121", "", "", "", "", "",
    17995, "bob@contoso.com", "", "198.51.100.121", "", "500121", "", "", "", "", "",
    17990, "bob@contoso.com", "", "198.51.100.121", "", "500121", "", "", "", "", "",
    17985, "bob@contoso.com", "", "198.51.100.121", "", "500121", "", "", "", "", "",
    17980, "bob@contoso.com", "", "198.51.100.121", "", "500121", "", "", "", "", "",
    17975, "bob@contoso.com", "", "198.51.100.121", "", "500121", "", "", "", "", "",
    14400, "carol@contoso.com", "", "10.0.0.60", "", "500121", "", "", "", "", "",
    14395, "carol@contoso.com", "", "10.0.0.60", "", "500121", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let minDenials = 5;
let Window = SigninLogs | where TimeGenerated > ago(1d);
Window
| where ResultType == "500121"
| summarize Denials = count(), IPs = make_set(IPAddress, 10), FirstDenial = min(TimeGenerated), LastDenial = max(TimeGenerated)
    by UserPrincipalName, Hour = bin(TimeGenerated, 1h)
| where Denials >= minDenials
| join kind=leftouter (
    Window | where ResultType == "0" | summarize LastSuccess = max(TimeGenerated) by UserPrincipalName
  ) on UserPrincipalName
| extend SuccessAfterDenials = isnotnull(LastSuccess) and LastSuccess > FirstDenial
| project UserPrincipalName, Hour, Denials, FirstDenial, LastDenial, SuccessAfterDenials, LastSuccess, IPs
| order by SuccessAfterDenials desc, Denials desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tobool(SuccessAfterDenials) == true), Include2 = countif(tostring(UserPrincipalName) == "bob@contoso.com" and tobool(SuccessAfterDenials) == false), Exclude1 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "hunt-mfa-fatigue", Expected = "2 row(s); 2 must appear; 1 must not"
| extend Result = iff(Rows == 2 and Include1 >= 1 and Include2 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
// Test: hunt-oauth-mail-permissions
// Rule: Apps granted access to mailboxes (hunting/hunt-oauth-mail-permissions.yaml)
// An app consented to with mail scopes by two users is listed once with both; an app with calendar-only scopes isn't.
// Generated by tools/build_tests.py from tests/cases/hunt-oauth-mail-permissions.yaml. Do not edit by hand.
let Test_hunt_oauth_mail_permissions = () {
let AuditLogs = datatable(AgoSeconds:long, OperationName:string, Category:string, Result:string, InitiatedBy:dynamic, TargetResources:dynamic, AdditionalDetails:dynamic) [
    864000, "Consent to application", "", "success", dynamic({"user": {"userPrincipalName": "alice@contoso.com"}}), dynamic([{"displayName": "Mail Helper Pro", "id": "app-10", "modifiedProperties": [{"displayName": "ConsentAction.Permissions", "newValue": "[] => [[Scope:  Mail.Read User.Read, ]]"}]}]), dynamic(null),
    345600, "Consent to application", "", "success", dynamic({"user": {"userPrincipalName": "bob@contoso.com"}}), dynamic([{"displayName": "Mail Helper Pro", "id": "app-10", "modifiedProperties": [{"displayName": "ConsentAction.Permissions", "newValue": "[] => [[Scope:  Mail.ReadWrite, ]]"}]}]), dynamic(null),
    345600, "Consent to application", "", "success", dynamic({"user": {"userPrincipalName": "carol@contoso.com"}}), dynamic([{"displayName": "Calendar Sync", "id": "app-11", "modifiedProperties": [{"displayName": "ConsentAction.Permissions", "newValue": "[] => [[Scope:  Calendars.Read, ]]"}]}]), dynamic(null)
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName == "Consent to application" and Result =~ "success"
| mv-apply Prop = TargetResources[0].modifiedProperties on (
    where tostring(Prop.displayName) == "ConsentAction.Permissions"
    | extend Permissions = tostring(Prop.newValue)
  )
| extend MailScopes = extract_all(@"((?:Mail|MailboxSettings|EWS)\.[\w\.]+|full_access_as_app)", Permissions)
| where array_length(MailScopes) > 0
| summarize Consents = count(), ConsentedBy = make_set(tostring(InitiatedBy.user.userPrincipalName), 25),
    Scopes = make_set(MailScopes), LastConsent = max(TimeGenerated)
    by AppName = tostring(TargetResources[0].displayName), AppId = tostring(TargetResources[0].id)
| order by LastConsent desc
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(AppName) == "Mail Helper Pro" and tolong(Consents) == 2), Exclude1 = countif(tostring(AppName) == "Calendar Sync")
| extend Test = "hunt-oauth-mail-permissions", Expected = "1 row(s); 1 must appear; 1 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
};
