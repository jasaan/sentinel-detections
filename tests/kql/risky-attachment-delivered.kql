// Test: risky-attachment-delivered
// Rule: Email with a high-risk attachment type delivered to the inbox (detections/risky-attachment-delivered.yaml)
// An ISO attachment delivered to the inbox fires; a PDF and a quarantined LNK don't.
// Generated by tools/build_tests.py from tests/cases/risky-attachment-delivered.yaml. Do not edit by hand.
let EmailAttachmentInfo = datatable(AgoSeconds:long, NetworkMessageId:string, SenderFromAddress:string, RecipientEmailAddress:string, FileName:string, FileType:string, SHA256:string) [
    1200, "msg-10", "billing@invoices.example", "alice@contoso.com", "Invoice_8812.iso", "iso", "aaaa000000000000000000000000000000000000000000000000000000000001",
    1200, "msg-11", "partner@vendor.example", "bob@contoso.com", "statement.pdf", "pdf", "aaaa000000000000000000000000000000000000000000000000000000000002",
    1200, "msg-12", "hr@payroll.example", "carol@contoso.com", "Payslip.lnk", "lnk", "aaaa000000000000000000000000000000000000000000000000000000000003"
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let EmailEvents = datatable(AgoSeconds:long, NetworkMessageId:string, SenderFromAddress:string, SenderFromDomain:string, RecipientEmailAddress:string, Subject:string, EmailDirection:string, DeliveryAction:string, DeliveryLocation:string, ThreatTypes:string, UrlCount:int, AttachmentCount:int) [
    1200, "msg-10", "billing@invoices.example", "invoices.example", "alice@contoso.com", "Invoice 8812", "Inbound", "Delivered", "Inbox/folder", "", 0, 1,
    1200, "msg-11", "partner@vendor.example", "vendor.example", "bob@contoso.com", "Statement", "Inbound", "Delivered", "Inbox/folder", "", 0, 1,
    1200, "msg-12", "hr@payroll.example", "payroll.example", "carol@contoso.com", "Payslip", "Inbound", "Blocked", "Quarantine", "Malware", 0, 1
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let RiskyExtensions = dynamic(["iso", "img", "vhd", "vhdx", "lnk", "hta", "js", "jse", "vbs", "vbe", "wsf", "wsh", "one",
    "chm", "scr", "cpl", "svg", "xll", "msc", "appx", "msix", "library-ms", "pif", "jar", "ps1", "bat", "cmd"]);
EmailAttachmentInfo
| where TimeGenerated > ago(1h)
| extend Extension = tolower(extract(@"\.([A-Za-z0-9\-]+)$", 1, FileName))
| where Extension in (RiskyExtensions) or tolower(FileType) in (RiskyExtensions)
| join kind=inner (
    EmailEvents
    | where TimeGenerated > ago(1h)
    | where EmailDirection =~ "Inbound" and DeliveryAction =~ "Delivered" and DeliveryLocation !in~ ("Quarantine", "Junk folder")
    | project NetworkMessageId, RecipientEmailAddress, Subject, SenderFromDomain, DeliveryLocation
  ) on NetworkMessageId, RecipientEmailAddress
| summarize Recipients = make_set(RecipientEmailAddress, 50), RecipientCount = dcount(RecipientEmailAddress), FirstSeen = min(TimeGenerated)
    by FileName, Extension, SHA256, SenderFromAddress, SenderFromDomain, Subject
| extend HashAlgorithm = "SHA256"
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(FileName) == "Invoice_8812.iso" and tostring(Extension) == "iso"), Exclude1 = countif(tostring(FileName) == "statement.pdf"), Exclude2 = countif(tostring(FileName) == "Payslip.lnk")
| extend Test = "risky-attachment-delivered", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
