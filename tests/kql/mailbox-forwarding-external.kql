// Test: mailbox-forwarding-external
// Rule: Mailbox-level forwarding set to an external address (detections/mailbox-forwarding-external.yaml)
// Forwarding a mailbox to a Gmail-style external address fires; forwarding to a colleague and an unrelated Set-Mailbox don't.
// Generated by tools/build_tests.py from tests/cases/mailbox-forwarding-external.yaml. Do not edit by hand.
let OfficeActivity = datatable(AgoSeconds:long, Operation:string, RecordType:string, UserId:string, ClientIP:string, OfficeWorkload:string, Parameters:string, SourceFileName:string, Site_Url:string, ResultStatus:string, MailboxOwnerUPN:string, TargetUserOrGroupName:string, TargetUserOrGroupType:string) [
    900, "Set-Mailbox", "", "alice@contoso.com", "198.51.100.24", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"alice@contoso.com\"},{\"Name\":\"ForwardingSmtpAddress\",\"Value\":\"smtp:alice.backup@mail.example.net\"},{\"Name\":\"DeliverToMailboxAndForward\",\"Value\":\"True\"}]", "", "", "", "", "", "",
    900, "Set-Mailbox", "", "admin1@contoso.com", "203.0.113.24", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"leaver@contoso.com\"},{\"Name\":\"ForwardingSmtpAddress\",\"Value\":\"smtp:manager@contoso.com\"}]", "", "", "", "", "", "",
    900, "Set-Mailbox", "", "admin2@contoso.com", "203.0.113.25", "Exchange", "[{\"Name\":\"Identity\",\"Value\":\"bob@contoso.com\"},{\"Name\":\"ProhibitSendQuota\",\"Value\":\"49GB\"}]", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let OrgDomains = dynamic(["contoso.com"]);
OfficeActivity
| where TimeGenerated > ago(1h)
| where Operation =~ "Set-Mailbox"
| mv-apply P = todynamic(Parameters) on (
    summarize Params = make_bag(bag_pack(tostring(P.Name), tostring(P.Value)))
  )
| extend Mailbox = tostring(Params.Identity),
    ForwardTo = trim(@"\s", replace_regex(coalesce(tostring(Params.ForwardingSmtpAddress), tostring(Params.ForwardingAddress)), @"(?i)^smtp:", ""))
| extend ForwardDomain = tolower(tostring(split(ForwardTo, "@")[1]))
| where isnotempty(ForwardDomain) and not(ForwardDomain in (OrgDomains))
| project TimeGenerated, Actor = UserId, ClientIP, Mailbox, ForwardTo, ForwardDomain,
    KeepsCopy = tostring(Params.DeliverToMailboxAndForward)
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(Mailbox) == "alice@contoso.com" and tostring(ForwardDomain) == "mail.example.net"), Exclude1 = countif(tostring(Actor) == "admin1@contoso.com"), Exclude2 = countif(tostring(Actor) == "admin2@contoso.com")
| extend Test = "mailbox-forwarding-external", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
