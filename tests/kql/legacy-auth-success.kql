// Test: legacy-auth-success
// Rule: Successful sign-in over legacy authentication (detections/legacy-auth-success.yaml)
// A successful IMAP sign-in fires; a browser sign-in and a failed SMTP AUTH attempt don't.
// Generated by tools/build_tests.py from tests/cases/legacy-auth-success.yaml. Do not edit by hand.
let SigninLogs = datatable(AgoSeconds:long, UserPrincipalName:string, UserId:string, IPAddress:string, Location:string, ResultType:string, ResultDescription:string, AppDisplayName:string, ResourceDisplayName:string, UserAgent:string, ClientAppUsed:string, AuthenticationProtocol:string, ConditionalAccessStatus:string, AuthenticationRequirement:string, RiskLevelDuringSignIn:string, SessionId:string, UserType:string) [
    900, "alice@contoso.com", "", "198.51.100.12", "DE", "0", "", "", "", "", "IMAP4", "", "", "", "", "", "",
    900, "bob@contoso.com", "", "203.0.113.12", "US", "0", "", "", "", "", "Browser", "", "", "", "", "", "",
    900, "carol@contoso.com", "", "198.51.100.13", "DE", "50126", "", "", "", "", "Authenticated SMTP", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
| project-away AgoSeconds;
let RuleResults = () {
let LegacyClients = dynamic(["IMAP4", "POP3", "Authenticated SMTP", "Exchange ActiveSync", "Exchange Web Services",
    "AutoDiscover", "MAPI Over HTTP", "Offline Address Book", "Outlook Anywhere (RPC over HTTP)",
    "Exchange Online PowerShell", "Other clients"]);
SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType == "0" and ClientAppUsed in~ (LegacyClients)
| summarize FirstSeen = min(TimeGenerated), SignIns = count(), IPs = make_set(IPAddress, 10), Locations = make_set(Location, 10)
    by UserPrincipalName = tolower(UserPrincipalName), ClientAppUsed
};
RuleResults()
| summarize Rows = count(), Include1 = countif(tostring(UserPrincipalName) == "alice@contoso.com" and tostring(ClientAppUsed) == "IMAP4"), Exclude1 = countif(tostring(UserPrincipalName) == "bob@contoso.com"), Exclude2 = countif(tostring(UserPrincipalName) == "carol@contoso.com")
| extend Test = "legacy-auth-success", Expected = "1 row(s); 1 must appear; 2 must not"
| extend Result = iff(Rows == 1 and Include1 >= 1 and Exclude1 == 0 and Exclude2 == 0, "PASS", "FAIL")
| project Test, Result, Rows, Expected
