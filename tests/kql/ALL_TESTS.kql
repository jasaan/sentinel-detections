    1800, "user11@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "", "", "", "", "", "", "",
    1800, "user12@contoso.com", "", "203.0.113.50", "", "50126", "", "Office 365 Exchange Online", "", "", "", "", "", "", "", "", "",
    1500, "user3@contoso.com", "", "203.0.113.50", "", "0", "", "Office 365 Exchange Online", "", "", "", "", "", "", "", "", "",
    1800, "temp1@contoso.com", "", "198.51.100.20", "", "50126", "", "", "", "", "", "", "", "", "", "", "",
    1800, "temp2@contoso.com", "", "198.51.100.20", "", "50126", "", "", "", "", "", "", "", "", "", "", "",
    1800, "temp3@contoso.com", "", "198.51.100.20", "", "50126", "", "", "", "", "", "", "", "", "", "", "",
    1800, "temp4@contoso.com", "", "198.51.100.20", "", "50126", "", "", "", "", "", "", "", "", "", "", ""
]
| extend TimeGenerated = now() - AgoSeconds * 1s
